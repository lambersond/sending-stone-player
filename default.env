# Placeholder environment values. Copy to .env (git-ignored) and fill in:
#   cp default.env .env
# Next.js and the Prisma CLI both read .env.

# -----------------------
# Database (matches local/docker-compose.yaml)
# -----------------------
# DB_URL may be a Prisma Accelerate URL in deployed environments;
# DIRECT_DATABASE_URL must always be a direct connection (used by migrations).
DB_URL="postgresql://admin:password@localhost:5432/sending_stone_db"
DIRECT_DATABASE_URL="postgresql://admin:password@localhost:5432/sending_stone_db"

# -----------------------
# Better Auth
# -----------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Optional session lifetime in seconds (defaults to 7 days)
# AUTH_MAX_AGE=604800

# -----------------------
# OAuth providers
# -----------------------
# Set *_ENABLED=true and add the OAuth app's credentials to turn one on.
# Callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/<provider>
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

AUTH_DISCORD_ENABLED=false
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"
