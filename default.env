# Placeholder environment values. Copy to .env (git-ignored) and fill in:
#   cp default.env .env
# Next.js and the Prisma CLI both read .env.

# -----------------------
# Database (matches local/docker-compose.yaml)
# -----------------------
# DB_DATABASE_URL_POOLED: the app's queries, through the database's connection pooler where
# deployed. DB_POSTGRES_URL: a direct connection, for the Prisma CLI's migrations. Locally, both
# are this one database (README.md, "The database").
DB_DATABASE_URL_POOLED="postgresql://admin:password@localhost:5432/sending_stone_db"
DB_POSTGRES_URL="postgresql://admin:password@localhost:5432/sending_stone_db"

# -----------------------
# Better Auth
# -----------------------
# At least 32 random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-output-of-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Optional session lifetime in seconds (defaults to 7 days)
# AUTH_MAX_AGE=604800
# Optional: for how many seconds a device's sign-in is taken from its sealed cookie before the
# database is asked again: whole seconds, 0 to 3600, defaults to 60; anything else is taken as 60.
# 0 asks the database on every request. A session ended from outside the app keeps working for up
# to this long; signing out works at once.
# AUTH_CACHE_MAX_AGE=60

# -----------------------
# OAuth providers
# -----------------------
# Set *_ENABLED=true and add the OAuth app's credentials to turn one on.
# Callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/<provider>
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

AUTH_DISCORD_ENABLED=false
AUTH_DISCORD_ID="your-discord-client-id"
AUTH_DISCORD_SECRET="your-discord-client-secret"
