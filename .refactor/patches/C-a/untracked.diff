+import { getRoles, render, screen, within, fireEvent } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { CharacterPane } from '@/components/character-sheet/character-pane'
+import { ROLL_KINDS } from '@/constants/sending-stone'
+import { fullerSheet, druidSheet, shapedSheet, tableMoves } from '@/mocks/sending-stone'
+import { toTableSheet } from '@/utils/table-view'
+jest.mock('@lambersond/3d-dice-react', () => jest.requireActual('@/mocks/dice-renderer').NO_DICE_RENDERER)
+const named = (c: HTMLElement) => { const out: string[] = []; for (const role of Object.keys(getRoles(c)).sort()) { if (['generic','paragraph','presentation','none','listitem','list','group','heading','region'].includes(role)) continue; within(c).queryAllByRole(role, { name: (n: string) => { out.push(`${role}: ${n}`); return true } }) } return out }
+const OUT = '/tmp/claude-0/-home-user/5271a33c-a1ff-5f4e-963f-cdaf6da8c173/scratchpad/C-a/explore2.txt'
+it('lists', async () => {
+  globalThis.fetch = jest.fn(() => new Promise(() => {})) as any
+  const user = userEvent.setup()
+  const out: string[] = []
+  const r = render(<CharacterPane characterId='char-1' name='Thorin Oakenshield' sheet={toTableSheet(fullerSheet(), 'https://my-game.forge-vtt.com')} rollsToTable={[...ROLL_KINDS]} moves={tableMoves()} removes favorites effects actorId='actorThorin1' />)
+  for (const t of ['Inventory', 'Spells', 'Features', 'Effects', 'Biography']) {
+    await user.click(screen.getByRole('tab', { name: new RegExp(`^${t}`) }))
+    out.push(`## ${t}`, ...named(screen.getByRole('tabpanel')))
+  }
+  await user.click(screen.getByRole('tab', { name: /^Inventory/ }))
+  const firstItem = within(screen.getByRole('tabpanel')).getAllByRole('button')[0]
+  out.push('## first item: ' + firstItem.textContent)
+  r.unmount()
+  render(<CharacterPane characterId='char-1' name='Elowen' sheet={toTableSheet(druidSheet(), 'https://my-game.forge-vtt.com')} wildShape />)
+  await user.click(screen.getByRole('tab', { name: 'Actions' }))
+  out.push('## druid actions', ...named(document.body))
+  require('fs').writeFileSync(OUT, out.join('\n'))
+})
