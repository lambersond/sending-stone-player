+import { render, screen, within } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { CharacterPane } from '@/components/character-sheet/character-pane'
+import { ROLL_KINDS } from '@/constants/sending-stone'
+import { characterSheet, fullerSheet } from '@/mocks/sending-stone'
+import { toTableSheet } from '@/utils/table-view'
+
+jest.mock('@lambersond/3d-dice-react', () => jest.requireActual('@/mocks/dice-renderer').NO_DICE_RENDERER)
+
+it('lists', async () => {
+  globalThis.fetch = jest.fn(() => new Promise(() => {})) as any
+  const user = userEvent.setup()
+  render(<CharacterPane characterId='char-1' name='Thorin Oakenshield' sheet={toTableSheet(fullerSheet(), 'https://my-game.forge-vtt.com')} rollsToTable={[...ROLL_KINDS]} />)
+  const out: string[] = []
+  const tabs = screen.getAllByRole('tab').map(t => t.getAttribute('aria-label') ?? t.textContent)
+  out.push('TABS ' + JSON.stringify(tabs))
+  for (const t of screen.getAllByRole('tab')) {
+    await user.click(t)
+    const names = screen.getAllByRole('button').map(b => b.getAttribute('aria-label') ?? b.textContent)
+    out.push(`## ${t.textContent}\n` + names.join('\n'))
+  }
+  require('fs').writeFileSync(process.env.OUT ?? '/dev/null', out.join('\n'))
+})
