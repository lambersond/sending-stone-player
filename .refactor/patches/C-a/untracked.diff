+it('db', async () => {
+  resetPrisma()
+  const seat = playerSeat({ id: 'char-1', name: 'Thorin Oakenshield', gameUrl: 'https://my-game.forge-vtt.com', campaignTitle: 'The Lonely Mountain', campaignId: 'c1', actorId: 'actor-thorin' }, 'user-1')
+  const fake = prismaFake({
+    campaign: [{ id: 'c1', rollsEnabled: true, rollKinds: ['skill', 'attack', 'damage'], rollFeatures: [], bridgePolledAt: new Date(), characters: [{ id: 'actor-thorin', name: 'Thorin Oakenshield' }], companions: [], companionKinds: [], companionInitiative: 'own' }],
+    actorSheet: [{ campaignId: 'c1', actorId: 'actor-thorin', data: fullerSheet() }],
+    rollRequest: [],
+    rollPrompt: [],
+    combat: [],
