+  let result
+  try { result = await createRollRequest(seat, { kind: 'skill', key: 'prc', mode: 0, explicit: false, extras: [], dice: [{ faces: 20, results: [14] }] }) } catch (e) { result = String(e) }
+  require('fs').writeFileSync('/tmp/claude-0/-home-user/5271a33c-a1ff-5f4e-963f-cdaf6da8c173/scratchpad/C-a/db.txt', JSON.stringify({ result, calls: fake.calls }, null, 1))
+})
