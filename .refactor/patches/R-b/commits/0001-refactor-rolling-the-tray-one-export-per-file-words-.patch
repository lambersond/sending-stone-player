+  return (
+    <>
+      d20{' '}
+      {roll.d20s.map((value, index) => (
+        <span key={index}>
+          {index > 0 && ' '}
+          {index === kept ? (
+            <span className='font-semibold text-text-primary'>{value}</span>
+          ) : (
+            <s>{value}</s>
+          )}
+        </span>
+      ))}
+    </>
+  )
+}
