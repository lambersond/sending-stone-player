+
+    expect(sent()).toEqual([
+      {
+        url: '/api/characters/c1/rolls',
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', 'X-B': '2' },
+        body: '{"kind":"skill","key":"prc"}',
+        signal: true,
+      },
+      {
+        url: '/api/characters/c1/rolls/req-1',
+        method: 'GET',
+        headers: {},
+        body: undefined,
+        cache: 'no-store',
