+import type { HitDicePool, HitDiceCount } from '@/types/roll'
+
+/**
+ * How the sheet spends hit dice: rolled with the player's dice, for the hit points they give back,
+ * and spent in the Gamemaster's game too while it takes hit dice.
+ */
+export type HitDieSpending = {
+  /** The character's hit dice by size, largest first, as dnd5e spends them: every class's of it. */
+  pools: HitDicePool[]
+  /**
+   * Spends this many hit dice of each size, thrown together: one alone as a hit die, more as hit
+   * dice spent at once.
+   */
+  onSpend: (counts: HitDiceCount[]) => void
+  /** What spending this many of each size gives back, as a formula, such as "2d10 + 1d8 + 9". */
+  formula: (counts: HitDiceCount[]) => string
+  /** At full hit points, where a die spent would give back nothing, so none is. */
+  full: boolean
+}
diff --git a/src/features/sheet/components/hit-dice/utils.ts b/src/features/sheet/components/hit-dice/utils.ts
new file mode 100644
index 0000000..ca3ba4d
--- /dev/null
+++ b/src/features/sheet/components/hit-dice/utils.ts
@@ -0,0 +1,37 @@
+import type { TableSheet } from '@/types/table'
+import type { SheetFormulaRoll, HitDicePool } from '@/types/roll'
+import type { HitDieSpending } from './types'
+import { hitDicePools, hitDieRoll, hitDiceRoll, hitDiceFormula, atFullHitPoints } from '@/utils/formulas'
+
+/** How a sheet's hit dice are spent, given what rolls them; none where nothing rolls them. */
+export function hitDieSpending(
+  sheet: TableSheet,
+  onRollFormula?: (roll: SheetFormulaRoll) => void,
+): HitDieSpending | undefined {
+  if (!onRollFormula) return
+  return {
+    pools: hitDicePools(sheet.classes),
+    onSpend: counts => {
+      const spent = counts.filter(({ count }) => count > 0)
+      const total = spent.reduce((all, { count }) => all + count, 0)
+      if (total === 0) return
+      onRollFormula(
+        total === 1
+          ? hitDieRoll(sheet, spent[0].die)
+          : hitDiceRoll(sheet, spent),
+      )
+    },
+    formula: counts => hitDiceFormula(sheet, counts),
+    full: atFullHitPoints(sheet),
+  }
+}
+
+/** A class's hit dice as its row says them: "Hit dice 3/5 d10", a dash for a count unknown. */
+export function hitDiceText(pool: HitDicePool): string {
+  return `Hit dice ${countOf(pool)} ${pool.die}`
+}
+
+/** How many are left, of how many: "3/5", a dash for a count unknown. */
+export function countOf({ value, max }: HitDicePool): string {
+  return `${value ?? '–'}/${max ?? '–'}`
+}
