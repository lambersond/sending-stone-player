+/**
+ * Who a table page is for (#156): a character's player, or its campaign's Gamemaster at the
+ * character's sheet, rolling as it.
+ */
+export type SeatRole = 'player' | 'gm'
+
+/**
+ * Each table-page string that names the Gamemaster, as the character's player reads it, and as the
+ * Gamemaster reads it at the character's sheet, where the game is their own: "your game", "you
+ * aren't viewing", "Your game asks". The player's are as they always were, to the character.
+ */
+export type SeatWords = {
+  /** The game rolls are made in, in a sentence. */
+  game: string
+  /** Who isn't viewing a target's level or scene. */
+  notViewing: string
+  /** Whose targets defend themselves, as Midi-QOL's active defence has them. */
+  targets: string
+  /** Who can apply an enchantment from its card. */
+  applies: string
+  /** Who puts an enchantment for someone else's item on from its card. */
+  putsOn: string
+  /** Said of a roll the game made blind. */
+  hidden: string
+  /** The heading over the saves the game asks for. */
+  asks: string
+  /** A tab's mark, read aloud, that the game asks for a roll. */
+  asksForRoll: string
+  /** The tray, while no roll is sent to the game. */
+  notSent: string
+  /** Who was told of a sheet too large to send. */
+  told: string
+  /** A sheet that hasn't arrived. */
+  noSheet: string
+  /** A character no longer in its campaign. */
+  addBack: string
+  /** The combat tracker with no combat. */
+  noCombat: string
+  /** A combat not yet started. */
+  settingUp: string
+  /** The game, live. */
+  connected: string
+  /** The game, not heard from lately. */
+  unheard: string
+}
diff --git a/src/utils/ask-words.ts b/src/utils/ask-words.ts
new file mode 100644
index 0000000..8d04f44
--- /dev/null
+++ b/src/utils/ask-words.ts
@@ -0,0 +1,46 @@
+import { ABILITIES } from '@/constants/dnd5e'
+import type { TableAsk } from '@/types/table'
+import { checkName, checkTitle } from '@/utils/description-links'
+import type { AskedCheck, CheckOption } from '@/types/sending-stone'
+
+/** Is this one of dnd5e's abilities' ids, and not a name any object answers to? */
+export function isAbility(id: unknown): id is string {
+  return typeof id === 'string' && Object.hasOwn(ABILITIES, id)
+}
+
+/**
+ * What a roll request card asks for, in words: such as "DC 15 Dexterity saving throw", "Strength
+ * or Dexterity saving throw", or "DC 10 Concentration check", naming its ability where it isn't
+ * Constitution; or a check, such as "DC 15 Strength (Athletics) check", or "Intelligence or Wisdom
+ * check", a tool by the game's name for it where it says.
+ */
+export function askTitle(ask: TableAsk): string {
+  if (ask.type === 'check') {
+    const names = ask.checks.map(check =>
+      checkName(checkOptionOf(check), check.name),
+    )
+    return checkTitle(names, { dc: ask.dc })
+  }
+  const dc = ask.dc === undefined ? '' : `DC ${ask.dc} `
+  const names = ask.abilities
+    .filter(id => isAbility(id))
+    .map(id => ABILITIES[id])
+  if (ask.type === 'concentration') {
+    const [ability] = ask.abilities
+    return ability && ability !== 'con' && names[0]
+      ? `${dc}Concentration check (${names[0]})`
+      : `${dc}Concentration check`
+  }
+  const list = new Intl.ListFormat('en', { type: 'disjunction' }).format(names)
+  return `${dc}${list} saving throw`
+}
+
+/** One way a check the table is asked for may be made, as a description's link has it. */
+function checkOptionOf(check: AskedCheck): CheckOption {
+  const key = check.type === 'skill' ? check.skill : check.tool
+  return {
+    type: check.type,
+    ability: check.ability,
+    ...(check.type !== 'check' && key !== undefined && { key }),
+  }
+}
