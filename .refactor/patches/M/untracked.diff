+import type { PartySheets } from './types'
+import { SheetHeading } from '../sheet-heading/sheet-heading'
+import { EntryIcon } from '../../../../components/entry-icon/entry-icon'
+import { Users, PanelRightOpen } from 'lucide-react'
+
+/**
+ * The party sheets the seat may open (module 0.30.0), on the Inventory tab, beside what's moved to
+ * them, or under why there's no sheet: a row each, the primary party first, that opens its sheet
+ * in its side panel over the character's. Nothing without any.
+ */
+export function PartySheetList({ groups, onOpen }: Readonly<PartySheets>) {
+  if (groups.length === 0) return
+  const sorted = groups.toSorted(
+    (a, b) => Number(b.primary) - Number(a.primary),
+  )
+  return (
+    <section
+      aria-labelledby='inventory-parties'
+      className='flex flex-col gap-2'
+    >
+      <SheetHeading id='inventory-parties'>
+        {groups.length === 1 ? 'Party' : 'Parties'}
+      </SheetHeading>
+      <ul className='rounded-2xl border border-border bg-card p-1.5'>
+        {sorted.map(group => (
+          <li key={group.id}>
+            {/* Named by what it shows, "The Iron Company Primary party", as one speaking to their
+                device says it. */}
+            <button
+              type='button'
+              onClick={() => onOpen(group.id)}
+              className='flex w-full items-center gap-3 rounded-xl px-2.5 py-2 text-left transition-colors hover:bg-primary/5'
+            >
+              <EntryIcon src={group.portrait} fallback={Users} />
+              <span className='min-w-0 flex-1'>
+                <span className='block truncate font-medium'>{group.name}</span>{' '}
+                <span className='block truncate text-xs text-text-secondary'>
+                  {group.primary ? 'Primary party' : 'Party sheet'}
+                </span>
+              </span>
+              <PanelRightOpen
+                aria-hidden
+                className='size-4 shrink-0 text-text-secondary'
+              />
+            </button>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
