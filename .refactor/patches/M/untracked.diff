+  const fresh = []
+  for (const [spec, want] of set.map) {
+    const key = spec.startsWith('.') || spec.startsWith('@/') ? p.resolve(spec, sf.fileName) ?? spec : spec
+    const same = decls.filter(d => target(d) === key && !touched.has(d))
+    const named = d =>
+      d.importClause && d.importClause.namedBindings && ts.isNamedImports(d.importClause.namedBindings)
+    const elsOf = d => (named(d) ? d.importClause.namedBindings.elements.map(e => e.getText(sf)) : [])
+    const have = new Set(same.flatMap(d => elsOf(d).map(localOf)))
+    for (const d of same) if (d.importClause && d.importClause.name) have.add(d.importClause.name.text)
+    const value = want.value.filter(e => !have.has(localOf(e)))
+    const type = want.type.filter(e => !have.has(localOf(e)))
+    const def = want.def.filter(e => !have.has(e))
+    const valueDecl = same.find(d => d.importClause && !d.importClause.isTypeOnly && (named(d) || !d.importClause.namedBindings))
+    const typeDecl = same.find(d => d.importClause && d.importClause.isTypeOnly && named(d))
+    let restValue = value
+    if (valueDecl && value.length && !def.length) {
+      edits.push([valueDecl.getStart(sf), valueDecl.end, declText(ts, sf, valueDecl, [...elsOf(valueDecl), ...value])])
+      touched.add(valueDecl)
+      restValue = []
+    }
+    let restType = type
+    if (typeDecl && type.length) {
+      edits.push([typeDecl.getStart(sf), typeDecl.end, declText(ts, sf, typeDecl, [...elsOf(typeDecl), ...type])])
+      touched.add(typeDecl)
+      restType = []
+    }
+    const q = `'${spec}'`
+    if (def.length || restValue.length) {
+      const parts = [def[0], restValue.length ? `{ ${restValue.join(', ')} }` : ''].filter(Boolean)
+      fresh.push(`import ${parts.join(', ')} from ${q}`)
+    }
+    for (const n of want.ns) fresh.push(`import * as ${n} from ${q}`)
+    if (restType.length) fresh.push(`import type { ${restType.join(', ')} } from ${q}`)
+  }
+  if (fresh.length) {
+    const lastImport = decls[decls.length - 1]
+    if (lastImport) {
+      edits.push([lineEnd(sf.text, lastImport.end), lineEnd(sf.text, lastImport.end), fresh.join('\n') + '\n'])
+    } else {
+      const prologue = sf.statements.filter(s => ts.isExpressionStatement(s) && ts.isStringLiteral(s.expression))
+      const first = sf.statements.find(s => !prologue.includes(s))
+      if (prologue.length) {
+        const at = lineEnd(sf.text, prologue[prologue.length - 1].end)
+        edits.push([at, at, '\n' + fresh.join('\n') + '\n'])
+      } else {
+        const at = first ? lineStart(sf.text, chunkRange(ts, sf, first).start) : sf.text.length
+        edits.push([at, at, fresh.join('\n') + '\n\n'])
+      }
+    }
+  }
+  return edits
+}
+
+/** The directive prologue ('use client' / 'use server') of a file. */
+function directives(ts, sf) {
+  const out = []
+  for (const st of sf.statements) {
+    if (ts.isExpressionStatement(st) && ts.isStringLiteral(st.expression)) out.push(st.expression.text)
+    else break
+  }
+  return out
+}
+
+// ---------------------------------------------------------------------------------------------
+// The export move
+
+/**
+ * Moves `names` (`old=new` renames, `*` for every exported type) from `source` to `dest` in the
+ * overlay. Returns { moved: [[old, new]], carried, exportedBack, stale, notes }.
+ */
+function exportMove(p, { source, dest, names }) {
+  const ts = p.ts
+  const S = p.abs(source)
+  const D = p.abs(dest)
+  const notes = []
+  if (S === D) return { moved: [], carried: [], exportedBack: [], stale: [], notes: ['source is dest'] }
+  if (!p.exists(S)) throw new Error(`export-move: ${p.rel(S)} is missing`)
+  const renames = new Map()
+  const asked = []
+  let all = false
+  for (const n of names) {
+    if (n === '*') all = true
+    else if (n.includes('=')) {
+      const [a, b] = n.split('=')
+      renames.set(a, b)
+      asked.push(a)
+    } else asked.push(n)
+  }
+
+  // 1. Renames inside the source.
+  for (const [from, to] of renames) {
+    const sf = p.sourceFile(S)
+    const st = (declarations(ts, sf).get(from) || [])[0]
+    if (!st) throw new Error(`export-move: ${from} is not declared in ${p.rel(S)}`)
+    const nameNode = st.name ?? st.declarationList.declarations.find(d => d.name.text === from).name
+    const locs = p.ls.findRenameLocations(S, nameNode.getStart(sf), false, false, {
+      providePrefixAndSuffixTextForRename: true,
+    })
+    const edits = locs
+      .filter(l => path.resolve(l.fileName) === S)
+      .map(l => [l.textSpan.start, l.textSpan.start + l.textSpan.length, (l.prefixText ?? '') + to + (l.suffixText ?? '')])
+    p.write(S, applyEdits(sf.text, edits))
+  }
+  const newName = n => renames.get(n) ?? n
+
+  let program = p.program()
+  let checker = program.getTypeChecker()
+  let sf = program.getSourceFile(S)
+  const decls = declarations(ts, sf)
+  const wanted = asked.map(newName)
+  if (all) {
+    for (const [name, sts] of decls) {
+      if (!wanted.includes(name) && sts.some(s => isExported(ts, s) && (ts.isTypeAliasDeclaration(s) || ts.isInterfaceDeclaration(s)))) {
+        wanted.push(name)
+      }
+    }
+  }
+  const toMove = new Set()
+  for (const n of wanted) {
+    const sts = decls.get(n)
+    if (!sts) throw new Error(`export-move: ${n} is not declared in ${p.rel(S)}`)
+    if (!sts.some(s => isExported(ts, s))) throw new Error(`export-move: ${n} is not exported from ${p.rel(S)}`)
+    for (const s of sts) toMove.add(s)
+  }
+  for (const st of sf.statements) {
+    if (ts.isExportDeclaration(st) && !st.moduleSpecifier) throw new Error(`export-move: ${p.rel(S)} has an export list; not handled`)
+    if (ts.isExportAssignment(st)) {
+      const e = st.expression
+      if (ts.isIdentifier(e) && wanted.includes(e.text)) throw new Error(`export-move: ${e.text} is a default export`)
+    }
+  }
+
+  // 2. The closure.
+  const ordered = () => [...toMove].sort((a, b) => a.pos - b.pos)
+  const carried = []
+  let usage
+  // Whether the source imports the destination after the move: the moved names it still uses, or
+  // an import of the destination it had already and keeps.
+  const keepsImportOf = u =>
+    sf.statements.some(
+      st =>
+        ts.isImportDeclaration(st) &&
+        p.resolve(st.moduleSpecifier.text, S) === D &&
+        importSymbols(ts, checker, st).some(sym => !u.unusedImportsFromOldFile.has(sym)),
+    )
+  for (;;) {
+    usage = ts.refactor.getUsageInfo(sf, ordered(), checker)
+    const sNeedsD = usage.oldFileImportsFromTargetFile.size > 0 || keepsImportOf(usage)
+    const more = []
+    for (const sym of usage.targetFileImportsFromOldFile.keys()) {
+      const sts = sym.declarations.map(d => topStatement(ts, d))
+      const exported = sts.some(s => isExported(ts, s))
+      if (!exported || sNeedsD) {
+        for (const s of sts) if (!toMove.has(s)) more.push(s)
+        if (exported) carried.push(sym.name)
+      }
+    }
+    if (!more.length) break
+    for (const s of more) toMove.add(s)
+  }
+  const moved = ordered()
+  const movedNames = new Set()
+  for (const [name, sts] of decls) if (sts.some(s => toMove.has(s))) movedNames.add(name)
+  // The names importers may ask for: every exported moved name.
+  const movedExported = new Set([...movedNames].filter(n => decls.get(n).some(s => isExported(ts, s))))
+  const askedOld = new Map() // the name an importer writes → the moved (new) name
+  for (const n of movedExported) askedOld.set(n, n)
+  for (const [a, b] of renames) {
+    askedOld.delete(b)
+    askedOld.set(a, b)
+  }
+
+  // 3. The destination's text.
+  const exportBack = new Set()
+  const exportedBack = []
+  for (const sym of usage.oldFileImportsFromTargetFile.keys()) {
+    for (const d of sym.declarations) {
+      const st = topStatement(ts, d)
+      if (toMove.has(st) && !isExported(ts, st)) {
+        exportBack.add(st)
+        if (!exportedBack.includes(sym.name)) exportedBack.push(sym.name)
+      }
+    }
+  }
+  const chunks = moved.map(st => {
+    const { start, end } = chunkRange(ts, sf, st)
+    let t = sf.text.slice(start, end)
+    if (exportBack.has(st)) {
+      const at = st.getStart(sf) - start
+      t = t.slice(0, at) + 'export ' + t.slice(at)
+    }
+    return t
+  })
+
+  const dImports = new ImportSet()
+  const dExists = p.exists(D)
+  for (const [sym, [typeOnlyUse, declNode]] of usage.oldImportsNeededByTargetFile) {
+    if (!declNode) continue
+    const imp = ts.findAncestor(declNode, ts.isImportDeclaration)
+    if (!imp) throw new Error(`export-move: ${sym.name} comes from a non-import in ${p.rel(S)}`)
+    const spec = imp.moduleSpecifier.text
+    const target = p.resolve(spec, S)
+    if (target === D) continue
+    const newSpec = target && (spec.startsWith('.') || spec.startsWith('@/')) ? p.spec(D, target, spec) : spec
+    if (ts.isImportClause(declNode)) dImports.add(newSpec, 'def', declNode.name.text)
+    else if (ts.isNamespaceImport(declNode)) dImports.add(newSpec, 'ns', declNode.name.text)
+    else if (ts.isImportSpecifier(declNode)) {
+      const typeOnly = imp.importClause.isTypeOnly || declNode.isTypeOnly || typeOnlyUse
+      const text = declNode.getText(sf).replace(/^type\s+/, '')
+      dImports.add(newSpec, typeOnly ? 'type' : 'value', text)
+    } else throw new Error(`export-move: ${sym.name}: unhandled import form in ${p.rel(S)}`)
+  }
+  const sSpecFromD = p.spec(D, S, p.styleFor(D, S))
+  for (const [sym, typeOnlyUse] of usage.targetFileImportsFromOldFile) {
+    dImports.add(sSpecFromD, typeOnlyUse ? 'type' : 'value', sym.name)
+  }
+
+  // 4. The source: cut, drop the imports only moved code used, import back what it still uses.
+  const sEdits = []
+  for (const st of moved) {
+    const { start, end } = chunkRange(ts, sf, st)
+    sEdits.push(cutLines(sf.text, start, end))
+  }
+  mergeCuts(sEdits)
+  const unused = usage.unusedImportsFromOldFile
+  for (const imp of sf.statements.filter(ts.isImportDeclaration)) {
+    const clause = imp.importClause
+    if (!clause) continue
+    let changed = false
+    let def = clause.name
+    if (def && unused.has(checker.getSymbolAtLocation(def))) {
+      def = undefined
+      changed = true
+    }
+    let els = []
+    const nb = clause.namedBindings
+    if (nb && ts.isNamedImports(nb)) {
+      for (const el of nb.elements) {
+        if (unused.has(checker.getSymbolAtLocation(el.name))) changed = true
+        else els.push(el.getText(sf))
+      }
+    } else if (nb && ts.isNamespaceImport(nb) && unused.has(checker.getSymbolAtLocation(nb.name))) {
+      sEdits.push(cutLines(sf.text, imp.getStart(sf), imp.end))
+      continue
+    } else if (nb) {
+      if (changed) throw new Error(`export-move: namespace import with a default in ${p.rel(S)}`)
+      continue
+    }
+    if (!changed) continue
+    const t = def
+      ? `import ${clause.isTypeOnly ? 'type ' : ''}${def.text}${els.length ? `, { ${els.join(', ')} }` : ''} from ${imp.moduleSpecifier.getText(sf)}`
+      : declText(ts, sf, imp, els)
+    sEdits.push(Object.assign(declEdit(sf, imp, t), { decl: imp }))
+  }
+  const sImports = new ImportSet()
+  const dSpecFromS = p.spec(S, D, p.styleFor(S, D))
+  for (const [sym, typeOnlyUse] of usage.oldFileImportsFromTargetFile) {
+    sImports.add(dSpecFromS, typeOnlyUse ? 'type' : 'value', sym.name)
+  }
+  sEdits.push(...importEdits(p, sf, sImports, sEdits))
+  const sText = applyEdits(sf.text, sEdits)
+
+  // 5. The destination: drop its own imports of moved names, add the moved code's, append the code.
+  let dText
+  if (dExists) {
+    const dsf = p.sourceFile(D)
+    const dEdits = []
+    for (const imp of dsf.statements.filter(n => ts.isImportDeclaration(n) || (ts.isExportDeclaration(n) && n.moduleSpecifier))) {
+      if (p.resolve(imp.moduleSpecifier.text, D) !== S) continue
+      const nb = ts.isImportDeclaration(imp) ? imp.importClause && imp.importClause.namedBindings : imp.exportClause
+      if (!nb || !(ts.isNamedImports(nb) || ts.isNamedExports(nb))) continue
+      const keep = []
+      let changed = false
+      for (const el of nb.elements) {
+        const name = (el.propertyName ?? el.name).text
+        if (askedOld.has(name)) {
+          if (el.propertyName && el.propertyName.text !== el.name.text) throw new Error(`export-move: ${p.rel(D)} imports ${name} under another name`)
+          changed = true
+        } else keep.push(el.getText(dsf))
+      }
+      if (changed) dEdits.push(Object.assign(declEdit(dsf, imp, declText(ts, dsf, imp, keep)), { decl: imp }))
+    }
+    dEdits.push(...importEdits(p, dsf, dImports, dEdits))
+    let body = applyEdits(dsf.text, dEdits)
+    body = body.replace(/\n*$/, '\n') + '\n' + chunks.join('\n\n') + '\n'
+    dText = body
+  } else {
+    const head = []
+    const isComponent =
+      D.endsWith('.tsx') &&
+      !path.basename(D).startsWith('use-') &&
+      directives(ts, sf).includes('use client') &&
+      wanted.some(n => /^[A-Z]/.test(n) && decls.get(n).some(s => ts.isFunctionDeclaration(s) || ts.isVariableStatement(s)))
+    if (isComponent) head.push("'use client'\n")
+    const lines = []
+    for (const [spec, want] of dImports.map) {
+      const q = `'${spec}'`
+      if (want.def.length || want.value.length) {
+        lines.push(`import ${[want.def[0], want.value.length ? `{ ${want.value.join(', ')} }` : ''].filter(Boolean).join(', ')} from ${q}`)
+      }
+      for (const n of want.ns) lines.push(`import * as ${n} from ${q}`)
+      if (want.type.length) lines.push(`import type { ${want.type.join(', ')} } from ${q}`)
+    }
+    if (lines.length) head.push(lines.join('\n') + '\n')
+    dText = (head.length ? head.join('\n') + '\n' : '') + chunks.join('\n\n') + '\n'
+  }
+  p.write(S, sText)
+  p.write(D, dText)
+  const importsOf = (from, to) => {
+    const f = p.sourceFile(from)
+    return importLiterals(ts, f).some(({ literal, decl }) => decl && p.resolve(literal.text, from) === to)
+  }
+  if (importsOf(S, D) && importsOf(D, S)) notes.push(`a cycle: ${p.rel(S)} and ${p.rel(D)} import each other`)
+
+  // 6. Importers, import types and mocks everywhere else.
+  const stale = []
+  program = p.program()
+  for (const f of [...p.names]) {
+    if (f === S) continue
+    const fsf = program.getSourceFile(f)
+    if (!fsf) continue
+    const fEdits = []
+    const fImports = new ImportSet()
+    const isTest = /\.test\.tsx?$|\/__tests__\//.test(f)
+    for (const { literal, decl, type } of importLiterals(ts, fsf)) {
+      if (p.resolve(literal.text, f) !== S) continue
+      const dSpec = () => p.spec(f, D, literal.text)
+      if (decl && f !== D) {
+        const nb = ts.isImportDeclaration(decl) ? decl.importClause && decl.importClause.namedBindings : decl.exportClause
+        if (nb && ts.isNamespaceImport(nb)) {
+          const ns = nb.name.text
+          if (new RegExp(`\\b${ns}\\.(${[...askedOld.keys()].join('|')})\\b`).test(fsf.text)) {
+            throw new Error(`export-move: ${p.rel(f)} reads a moved name through namespace ${ns}`)
+          }
+          continue
+        }
+        if (!nb || !(ts.isNamedImports(nb) || ts.isNamedExports(nb))) continue
+        const keep = []
+        const go = []
+        for (const el of nb.elements) {
+          const name = (el.propertyName ?? el.name).text
+          if (!askedOld.has(name)) {
+            keep.push(el.getText(fsf))
+            continue
+          }
+          const to = askedOld.get(name)
+          const local = el.name.text
+          const t = (el.isTypeOnly ? 'type ' : '') + (to === local ? local : `${to} as ${local}`)
+          go.push(t)
+          if (to !== name && !isTest) notes.push(`${p.rel(f)}: imports ${name} as ${to} under its old local name`)
+        }
+        if (!go.length) continue
+        if (ts.isExportDeclaration(decl)) {
+          const t = declText(ts, fsf, decl, keep)
+          const add = `export ${decl.isTypeOnly ? 'type ' : ''}{ ${go.join(', ')} } from '${dSpec()}'`
+          fEdits.push(Object.assign([decl.getStart(fsf), decl.end, (t ? t + '\n' : '') + add], { decl }))
+          notes.push(`${p.rel(f)}: re-exports a moved name (gate 7)`)
+        } else {
+          fEdits.push(Object.assign(declEdit(fsf, decl, declText(ts, fsf, decl, keep)), { decl }))
+          for (const t of go) fImports.add(dSpec(), decl.importClause.isTypeOnly ? 'type' : 'value', t)
+        }
+      } else if (type) {
+        if (type.qualifier) {
+          const first = ts.isIdentifier(type.qualifier) ? type.qualifier : leftmost(ts, type.qualifier)
+          if (askedOld.has(first.text)) {
+            if (askedOld.get(first.text) !== first.text) throw new Error(`export-move: ${p.rel(f)}: import type of a renamed name`)
+            fEdits.push([literal.getStart(fsf) + 1, literal.end - 1, dSpec()])
+          }
+        }
+        // `typeof import('S')` without a qualifier: decided with its requireActual below.
+      }
+    }
+    for (const { call, kind, literal } of pathCalls(ts, fsf)) {
+      if (p.resolve(literal.text, f) !== S) continue
+      const dSpec = p.spec(f, D, literal.text)
+      if (kind === 'mock' || kind === 'doMock') {
+        const keys = call.arguments[1] ? factoryKeys(ts, call.arguments[1]) : undefined
+        const where = `${p.rel(f)}:${fsf.getLineAndCharacterOfPosition(call.getStart(fsf)).line + 1}`
+        if (!keys) {
+          stale.push(`${where}: jest.${kind} of ${literal.text} without a plain factory (moved: ${[...askedOld.keys()].join(' ')})`)
+          continue
+        }
+        const go = keys.filter(k => askedOld.has(k))
+        if (!go.length) continue
+        if (go.length < keys.length) {
+          stale.push(`${where}: jest.${kind}('${literal.text}') keys ${go.join(' ')} moved to ${p.rel(D)}, ${keys.filter(k => !go.includes(k)).join(' ')} stayed`)
+          continue
+        }
+        if (go.some(k => askedOld.get(k) !== k)) throw new Error(`${where}: a mock key was renamed`)
+        fEdits.push([literal.getStart(fsf) + 1, literal.end - 1, dSpec])
+        const inner = n => {
+          if (n !== literal && ts.isStringLiteral(n) && p.resolve(n.text, f) === S) {
+            const parent = n.parent
+            const ok = (ts.isCallExpression(parent) && parent.arguments[0] === n) || ts.isLiteralTypeNode(parent)
+            if (ok) fEdits.push([n.getStart(fsf) + 1, n.end - 1, p.spec(f, D, n.text)])
+          }
+          ts.forEachChild(n, inner)
+        }
+        ts.forEachChild(call.arguments[1], inner)
+      } else if (kind === 'requireActual' || kind === 'requireMock') {
+        const insideMock = ts.findAncestor(call.parent, n => ts.isCallExpression(n) && pathCalls(ts, fsf).some(c => c.call === n && (c.kind === 'mock' || c.kind === 'doMock')))
+        if (insideMock) continue // a spread inside a factory: follows (or not) with its mock
+        const read = namesReadFrom(ts, fsf, call)
+        const where = `${p.rel(f)}:${fsf.getLineAndCharacterOfPosition(call.getStart(fsf)).line + 1}`
+        if (!read) {
+          stale.push(`${where}: jest.${kind}('${literal.text}') read whole (moved: ${[...askedOld.keys()].join(' ')})`)
+          continue
+        }
+        const go = read.filter(k => askedOld.has(k))
+        if (!go.length) continue
+        if (go.length < read.length) {
+          stale.push(`${where}: jest.${kind}('${literal.text}') reads ${go.join(' ')} (moved) and ${read.filter(k => !go.includes(k)).join(' ')} (stayed)`)
+          continue
+        }
+        fEdits.push([literal.getStart(fsf) + 1, literal.end - 1, dSpec])
+        for (const t of call.typeArguments || []) {
+          const visit = n => {
+            if (ts.isImportTypeNode(n) && ts.isLiteralTypeNode(n.argument) && p.resolve(n.argument.literal.text, f) === S) {
+              const l = n.argument.literal
+              fEdits.push([l.getStart(fsf) + 1, l.end - 1, p.spec(f, D, l.text)])
+            }
+            ts.forEachChild(n, visit)
+          }
+          visit(t)
+        }
+      } else if (kind === 'require') {
+        stale.push(`${p.rel(f)}: require('${literal.text}') of a module that lost names`)
+      }
+    }
+    // A `typeof import('S')` left with no qualifier and no requireActual beside it reads S's type
+    // whole; S still exists, so it stays (listed when the moved names are read through it).
+    if (!fEdits.length && !fImports.size) continue
+    fEdits.push(...importEdits(p, fsf, fImports, fEdits))
+    p.write(f, applyEdits(fsf.text, dedupeEdits(fEdits)))
+  }
+
+  const renamedFrom = new Map([...renames].map(([a, b]) => [b, a]))
+  return {
+    moved: [...movedNames].map(n => (renamedFrom.has(n) ? `${renamedFrom.get(n)}=${n}` : n)),
+    carried,
+    exportedBack,
+    stale,
+    notes,
+  }
+}
+
+/** The local symbols an import declaration binds. */
+function importSymbols(ts, checker, imp) {
+  const c = imp.importClause
+  if (!c) return []
+  const out = []
+  if (c.name) out.push(checker.getSymbolAtLocation(c.name))
+  const nb = c.namedBindings
+  if (nb && ts.isNamespaceImport(nb)) out.push(checker.getSymbolAtLocation(nb.name))
+  if (nb && ts.isNamedImports(nb)) for (const el of nb.elements) out.push(checker.getSymbolAtLocation(el.name))
+  return out.filter(Boolean)
+}
+
+function leftmost(ts, q) {
+  while (ts.isQualifiedName(q)) q = q.left
+  return q
+}
+
+/** Merges touching or overlapping cut ranges (consecutive moved statements). */
+function mergeCuts(edits) {
+  edits.sort((a, b) => a[0] - b[0])
+  for (let i = 0; i + 1 < edits.length; ) {
+    if (edits[i + 1][0] <= edits[i][1]) {
+      edits[i][1] = Math.max(edits[i][1], edits[i + 1][1])
+      edits.splice(i + 1, 1)
+    } else i++
+  }
+}
+
+function dedupeEdits(edits) {
+  const seen = new Set()
+  return edits.filter(e => {
+    const k = `${e[0]}:${e[1]}:${e[2]}`
+    if (seen.has(k)) return false
+    seen.add(k)
+    return true
+  })
+}
+
+// ---------------------------------------------------------------------------------------------
+// Formatting the import lines, and the record
+
+const FIX_RULES = [
+  'prettier/prettier',
+  'import/order',
+  'import/no-duplicates',
+  'import/newline-after-import',
+  '@stylistic/no-multiple-empty-lines',
+]
+
+/** Runs eslint's fixers for the import-format rules only over `files`, under the checks locks. */
+function lintFix(root, files, x = X_DEFAULT) {
+  if (!files.length) return
+  const list = path.join(x, `lint-fix-${process.pid}.txt`)
+  fs.mkdirSync(x, { recursive: true })
+  fs.writeFileSync(list, files.join('\n'))
+  const res = cp.spawnSync(
+    'flock',
+    [path.join(x, 'l1-wait.lock'), 'flock', path.join(x, 'checks.lock'), process.execPath, __filename, '--lint-fix-list', list, '--root', root],
+    { cwd: root, stdio: 'inherit' },
+  )
+  fs.rmSync(list, { force: true })
+  if (res.status !== 0) throw new Error(`lint fix failed (${res.status})`)
+}
+
+async function lintFixWorker(root, list) {
+  const { ESLint } = require(require.resolve('eslint', { paths: [root] }))
+  const files = fs.readFileSync(list, 'utf8').split('\n').filter(Boolean).filter(f => fs.existsSync(f))
+  const heads = new Map(files.map(f => [f, leadingDocblock(fs.readFileSync(f, 'utf8'))]))
+  const eslint = new ESLint({ cwd: root, fix: m => FIX_RULES.includes(m.ruleId) })
+  // eslint stops after 10 fix passes a file; a long import block may need more rounds.
+  let results
+  for (let round = 1; round <= 5; round++) {
+    results = await eslint.lintFiles(files)
+    await ESLint.outputFixes(results)
+    const fixed = results.filter(r => r.output !== undefined).length
+    const left = results.some(r => r.messages.some(m => m.severity === 2 && FIX_RULES.includes(m.ruleId)))
+    console.error(`lint fix round ${round}: ${fixed} files fixed`)
+    if (!left) break
+  }
+  let errors = 0
+  for (const r of results) {
+    for (const m of r.messages) {
+      if (m.severity === 2) {
+        errors++
+        console.error(`${path.relative(root, r.filePath)}:${m.line}:${m.column} ${m.ruleId} ${m.message}`)
+      }
+    }
+  }
+  // A test's leading @jest-environment docblock stays its first lines (round.md §3.1.2).
+  for (const [f, head] of heads) {
+    if (!head) continue
+    const t = fs.readFileSync(f, 'utf8')
+    if (t.startsWith(head)) continue
+    const at = t.indexOf(head)
+    if (at < 0) throw new Error(`${f}: its @jest-environment docblock is gone`)
+    const rest = (t.slice(0, at) + t.slice(at + head.length)).replace(/^\n+/, '')
+    fs.writeFileSync(f, head + rest)
+    console.error(`${path.relative(root, f)}: docblock put back first`)
+  }
+  console.error(`lint fix: ${files.length} files, ${errors} errors left`)
+  process.exitCode = errors ? 1 : 0
+}
+
+function leadingDocblock(text) {
+  const m = text.match(/^\/\*\*[\s\S]*?\*\/\n/)
+  return m && /@jest-environment/.test(m[0]) ? m[0] : ''
+}
+
+/** Appends records to R/tools/moves.tsv in the checkout. */
+function record(root, rows) {
+  const file = path.join(root, '.refactor/tools/moves.tsv')
+  let t = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : MOVES_HEADER + '\n'
+  t += rows.map(r => r.join('\t')).join('\n') + (rows.length ? '\n' : '')
+  fs.writeFileSync(file, t)
+}
+
+/** base path → current path, from moves.tsv's file records. */
+function baseMap(root) {
+  const file = path.join(root, '.refactor/tools/moves.tsv')
+  const map = new Map()
+  if (!fs.existsSync(file)) return map
+  for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
+    if (!line || line.startsWith('#')) continue
+    const [kind, , to, , base] = line.split('\t')
+    if (kind === 'file') map.set(base, to)
+  }
+  return map
+}
+
+/** `base<TAB>dest` of every name record in moves.tsv (a row done already, e.g. NotesPlace in commit 5). */
+function doneNames(root) {
+  const file = path.join(root, '.refactor/tools/moves.tsv')
+  const out = new Set()
+  if (!fs.existsSync(file)) return out
+  for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
+    const [kind, , to, , base] = line.split('\t')
+    if (kind === 'name') out.add(`${base}\t${to}`)
+  }
+  return out
+}
+
+// ---------------------------------------------------------------------------------------------
+// The spec, from owners.tsv's "moved in 2b" and "receives in 2b" notes
+
+// round.md §1.9.1: useTargetsOf moves with asks (which calls it), renamed (§0.6.5, fact 18).
+const SPEC_EXTRA = [
+  ['src/features/sheet/components/use-picker/utils.ts', 'src/components/character-sheet/use-picker.tsx', 'useTargetsOf=targetsFor'],
+]
+
+function tier(dest) {
+  const b = path.basename(dest)
+  if (dest.startsWith('src/types/')) return 0
+  if (dest === 'src/db/types.ts' || dest.startsWith('src/utils/requests/types')) return 1
+  if (b === 'types.ts') return 2
+  if (dest.startsWith('src/constants/')) return 3
+  if (b === 'constants.ts') return 4
+  if (dest.startsWith('src/utils/')) return 5
+  if (/\/utils(\/|\.ts$)/.test(dest) || b === 'utils.ts') return 6
+  if (b.startsWith('use-')) return 7
+  return 8
+}
+
+function specFromOwners(ownersFile) {
+  const rows = fs.readFileSync(ownersFile, 'utf8').split('\n').slice(1).filter(Boolean).map(l => l.split('\t'))
+  const out = []
+  for (const r of rows) {
+    const [base, after] = r
+    const dest = base === '-' ? after : after === '=' ? base : after.split(' ')[0]
+    const text = r.slice(2).join('\t')
+    const re = /(?:moved|receives) in 2b:\s*([^]*?)(?=(?:;\s*)?(?:gives in 2b|receives in 2b|moved in 2b|RollKindInfo appended|$|\t))/g
+    let m
+    while ((m = re.exec(text))) {
+      for (const part of m[1].split(';')) {
+        const mm = part.trim().match(/^(.*?)\s*←\s*(\S+)/)
+        if (mm) out.push([dest, 'src/' + mm[2], mm[1].trim()])
+      }
+    }
+  }
+  for (const e of SPEC_EXTRA) {
+    const row = out.find(o => o[0] === e[0] && o[1] === e[1])
+    if (row) row[2] += ' ' + e[2]
+    else out.push(e)
+  }
+  return out
+    .map((o, i) => ({ o, i }))
+    .sort((a, b) => tier(a.o[0]) - tier(b.o[0]) || a.i - b.i)
+    .map(({ o }) => o)
+}
+
+/**
+ * Whether a pending row's names reach (through file-private helpers) a name another pending row of
+ * the same source moves. Identifiers are matched by text: a false match only delays a row.
+ */
+function waitsFor(p, item, pending, bases) {
+  const ts = p.ts
+  const [, base, names] = item.r
+  const source = p.abs(bases.get(base) || base)
+  if (!p.exists(source)) return false
+  const others = new Set()
+  for (const o of pending) {
+    if (o === item || o.r[1] !== base) continue
+    for (const n of o.r[2].split(/\s+/)) if (n !== '*') others.add(n.split('=')[0])
+  }
+  if (!others.size) return false
+  const sf = p.sourceFile(source)
+  const decls = declarations(ts, sf)
+  const seen = new Set()
+  const queue = names.split(/\s+/).filter(n => n && n !== '*').map(n => n.split('=')[0])
+  while (queue.length) {
+    const name = queue.pop()
+    if (seen.has(name)) continue
+    seen.add(name)
+    for (const st of decls.get(name) || []) {
+      const walk = node => {
+        if (ts.isIdentifier(node) && node.text !== name && decls.has(node.text)) {
+          if (others.has(node.text)) throw Object.assign(new Error('waits'), { waits: true })
+          if (!decls.get(node.text).some(s => isExported(ts, s))) queue.push(node.text)
+        }
+        ts.forEachChild(node, walk)
+      }
+      try {
+        walk(st)
+      } catch (e) {
+        if (e.waits) return true
+        throw e
+      }
+    }
+  }
+  return false
+}
+
+// ---------------------------------------------------------------------------------------------
+// CLI
+
+function args(argv) {
+  const out = { _: [] }
+  for (let i = 0; i < argv.length; i++) {
+    const a = argv[i]
+    if (!a.startsWith('--')) out._.push(a)
+    else if (['--no-git', '--no-lint', '--dry', '--print-spec'].includes(a)) out[a.slice(2)] = true
+    else out[a.slice(2)] = argv[++i]
+  }
+  return out
+}
+
+function readSpec(file) {
+  return fs
+    .readFileSync(file, 'utf8')
+    .split('\n')
+    .filter(l => l && !l.startsWith('#'))
+    .map(l => l.split('\t'))
+}
+
+async function main() {
+  const a = args(process.argv.slice(2))
+  if (a['lint-fix-list']) return lintFixWorker(path.resolve(a.root), a['lint-fix-list'])
+  if (a['print-spec']) {
+    const rows = specFromOwners(a.owners)
+    process.stdout.write('# dest\tsource (24f808b path)\tnames  (export-move.cjs --print-spec, from owners.tsv)\n')
+    process.stdout.write(rows.map(r => r.join('\t')).join('\n') + '\n')
+    return
+  }
+  const root = path.resolve(a.root || process.cwd())
+  const x = a.x || X_DEFAULT
+  const p = new Project(root)
+  const bases = baseMap(root)
+  const rows = a.source
+    ? [[a.dest, a.source, a.names]]
+    : a.spec
+      ? readSpec(a.spec)
+      : specFromOwners(path.resolve(a.owners || path.join(root, '.refactor/owners.tsv')))
+  const from = Number(a.from || 1)
+  const to = Number(a.to || rows.length)
+  const records = []
+  const done = doneNames(root)
+  const report = { carried: [], exportedBack: [], stale: [], notes: [], skipped: [] }
+  const t0 = Date.now()
+  // Rows run in the spec's order, but a row whose names (or the private helpers they carry) use
+  // the names of a later row of the same source waits for it: the later row's names then come from
+  // their own home, and nothing is carried into the wrong one (a component into a hook's .ts).
+  const pending = rows.slice(from - 1, to).map((r, k) => ({ r, n: from + k }))
+  while (pending.length) {
+    let pick = pending.findIndex(item => !waitsFor(p, item, pending, bases))
+    if (pick < 0) {
+      pick = 0
+      report.notes.push(`row ${pending[0].n}: its names and a later row's use each other (run in order)`)
+    }
+    const [{ r: [dest, base, names], n }] = pending.splice(pick, 1)
+    const source = bases.get(base) || base
+    if (path.resolve(root, source) === path.resolve(root, dest)) {
+      report.skipped.push(`${n}: ${base} is already ${dest}`)
+      continue
+    }
+    if (done.has(`${base}\t${dest}`)) {
+      report.skipped.push(`${n}: ${base} → ${dest} moved already (moves.tsv)`)
+      continue
+    }
+    const res = exportMove(p, { source, dest, names: names.split(/\s+/).filter(Boolean) })
+    console.error(`${n}/${rows.length} ${source} → ${dest}: ${res.moved.join(' ')} (${((Date.now() - t0) / 1000).toFixed(0)} s)`)
+    for (const name of res.moved) records.push(['name', source, dest, name, base])
+    if (res.carried.length) report.carried.push(`${source} → ${dest}: ${res.carried.join(' ')}`)
+    if (res.exportedBack.length) report.exportedBack.push(`${dest}: ${res.exportedBack.join(' ')}`)
+    report.stale.push(...res.stale)
+    report.notes.push(...res.notes)
+  }
+  const changed = [...p.changed].map(f => p.rel(f))
+  if (a.dry) {
+    console.log(JSON.stringify({ changed, records, report }, null, 2))
+    return
+  }
+  p.flush({ git: !a['no-git'] })
+  if (!a['no-lint']) lintFix(root, [...p.changed], x)
+  if (!a['no-git']) cp.execFileSync('git', ['add', '-A', '--', ...changed], { cwd: root })
+  record(root, records)
+  console.log(JSON.stringify({ files: changed.length, names: records.length, report }, null, 2))
+}
+
+module.exports = {
+  Project,
+  X_DEFAULT,
+  MOVES_HEADER,
+  importLiterals,
+  pathCalls,
+  factoryKeys,
+  namesReadFrom,
+  declText,
+  declEdit,
+  applyEdits,
+  cutLines,
+  ImportSet,
+  importEdits,
+  exportMove,
+  lintFix,
+  record,
+  baseMap,
+  specFromOwners,
+}
+
+if (require.main === module) {
+  main().catch(e => {
+    console.error(e.stack || String(e))
+    process.exit(1)
+  })
+}
