@@ -0,0 +1,52 @@
+import { useState } from 'react'
+import { useMediaQuery } from '@/hooks/use-media-query'
+import type { Aside, Tab } from '@/features/table/types'
+
+/** From Tailwind's lg width, the sheet and the combat or chat column sit side by side. */
+const SIDE_BY_SIDE = '(min-width: 64rem)'
+
+/**
+ * The table's tabs: the one shown on a phone or tablet, the character, combat or the chat; what
+ * sits beside the sheet on a wide screen, combat or the chat; and whether the screen is that wide.
+ * @param fighting - Whether the page opened on a combat already started: combat then sits beside
+ *   the sheet, else the chat.
+ * @returns The tab and the column's choice; whether they sit side by side; whether the chat, the
+ *   combat pane and the Character pane are in view; and `show`, which shows a tab, and on a wide screen puts combat
+ *   or the chat beside the sheet.
+ */
+export function useTableTabs(fighting: boolean) {
+  const [aside, setAside] = useState<Aside>(() =>
+    fighting ? 'combat' : 'chat',
+  )
+  // The character comes first, in a fight too, where the Combat tab marks the player's turn; and
+  // without a sheet, where its tab says why.
+  const [tab, setTab] = useState<Tab>('character')
+  const sideBySide = useMediaQuery(SIDE_BY_SIDE)
+  // A screen that narrows from the sheet beside combat or the chat to one pane shows the
+  // character, keeping the part of the sheet shown. Widening changes nothing.
+  const [wasSideBySide, setWasSideBySide] = useState(sideBySide)
+  if (sideBySide !== wasSideBySide) {
+    setWasSideBySide(sideBySide)
+    if (!sideBySide) setTab('character')
+  }
+  // The chat is in view when it is the tab shown, or on a wide screen when it is what sits beside
+  // the sheet.
+  const chatInView = aside === 'chat' && (sideBySide || tab === 'chat')
+  // Whether the combat pane is shown: Combat chosen in one pane, or beside the sheet.
+  const combatShown = sideBySide ? aside === 'combat' : tab === 'combat'
+  // Whether the Character pane is in view: on a wide screen, or as its tab.
+  const characterInView = tab === 'character' || sideBySide
+  const show = (next: Tab) => {
+    if (next !== 'character') setAside(next)
+    setTab(next)
+  }
+  return {
+    tab,
+    aside,
+    sideBySide,
+    chatInView,
+    combatShown,
+    characterInView,
+    show,
+  }
+}
diff --git a/src/features/table/hooks/use-turn-ending.ts b/src/features/table/hooks/use-turn-ending.ts
new file mode 100644
index 0000000..fe815ed
--- /dev/null
+++ b/src/features/table/hooks/use-turn-ending.ts
@@ -0,0 +1,147 @@
+import { useEffect, useRef, useState } from 'react'
+import { useEndTurn } from './use-end-turn'
+import { useHold } from './use-hold'
+import { useTurnUndo } from './use-turn-undo'
+import {
+  END_TURN_QUIET_CLICKS,
+  holdDescription,
+  newlyNotMade,
+  refusalKey,
+  turnKey,
+} from '@/features/table/utils/end-turn'
+import type { EndTurnState, TabHold } from '@/features/table/types'
+import type { RollKind } from '@/types/roll'
+import type { EndableTurn, TableView } from '@/types/table'
+
+/** No rolls the game takes from here, the same each time. */
+const NO_KINDS: readonly RollKind[] = []
+
+/**
+ * Why the last End Turn wasn't made, which the turn panel says while it shows that turn: by the
+ * turn and its way's reason, as a refusal by this app's own server has no id.
+ */
+function useRefusal(ending: EndTurnState) {
+  const [refused, setRefused] = useState<{ turn: EndableTurn; key: string }>()
+  const lastSent = useRef(ending.sent)
+  useEffect(() => {
+    const was = lastSent.current
+    lastSent.current = ending.sent
+    if (newlyNotMade(was, ending.sent)) {
+      setRefused({ turn: ending.sent.turn, key: refusalKey(ending.sent.way) })
+    }
+  }, [ending.sent])
+  const turnShown = ending.turn && turnKey(ending.turn)
+  if (refused && turnShown !== turnKey(refused.turn)) setRefused(undefined)
+  return [refused, setRefused] as const
+}
+
+/**
+ * The Combat tab held to end the turn: whether a hold is past half a second, which its toast says;
+ * and once a hold has ended the turn, the page's tabs ignore clicks for a moment, so that the click
+ * that ends the press, wherever it lands, opens nothing.
+ * @param onEnd - Ends the turn the hold was made on.
+ */
+function useTurnHold(ending: EndTurnState, onEnd: (turn: EndableTurn) => void) {
+  const [held, setHeld] = useState(false)
+  const quietUntil = useRef(0)
+  const quiet = () => performance.now() < quietUntil.current
+  const hold = useHold({
+    key: ending.offered && ending.turn ? turnKey(ending.turn) : undefined,
+    onToast: () => setHeld(true),
+    onEnd: () => {
+      quietUntil.current = performance.now() + END_TURN_QUIET_CLICKS
+      setHeld(false)
+      if (ending.turn) onEnd(ending.turn)
+    },
+    onCancel: () => setHeld(false),
+  })
+  return { held, quiet, hold }
+}
+
+/**
+ * End Turn at the table (module 0.36.0): the seat's turn, its character's or a companion's, ended
+ * from the turn panel's button or the Combat tab held, with Undo in the toast that follows;
+ * wherever the game takes it from here. A character no longer in its campaign's game ends no turn.
+ * It composes `useEndTurn`, `useTurnUndo` and `useHold`, each as it is.
+ * @param api - The seat's API base, which its rolls go through.
+ * @param gm - Whether the seat is the Gamemaster's.
+ * @param sideBySide - Whether the sheet and the combat or chat column sit side by side.
+ * @param combatShown - Whether the combat pane is shown.
+ * @returns End Turn and Undo; how the last End Turn was sent, and why it wasn't made; `endTurn`;
+ *   whether a hold is past half a second, and whether the tabs ignore clicks now; the Combat tab of
+ *   each layout, and where focus on the turn goes; and `holdOf`, the hold as a Combat tab takes it.
+ */
+export function useTurnEnding({
+  api,
+  gm,
+  view,
+  sideBySide,
+  combatShown,
+}: {
+  api: string
+  gm: boolean
+  view: TableView
+  sideBySide: boolean
+  combatShown: boolean
+}) {
+  const kinds = (view.connected && view.rollsToTable) || NO_KINDS
+  const ending = useEndTurn({ api, gm, combat: view.combat, kinds })
+  const undoing = useTurnUndo({
+    api,
+    gm,
+    combat: view.combat,
+    kinds,
+    sent: ending.sent,
+  })
+  // How the last End Turn was sent, by the button or by a hold.
+  const [via, setVia] = useState<'button' | 'hold'>()
+  const [refused, setRefused] = useRefusal(ending)
+  const endTurn = (turn: EndableTurn, how: 'button' | 'hold') => {
+    setVia(how)
+    setRefused(undefined)
+    ending.end(turn)
+  }
+  const { held, quiet, hold } = useTurnHold(ending, turn =>
+    endTurn(turn, 'hold'),
+  )
+  // The Combat tab of each layout: the bottom bar's or rail's, and the column's.
+  const barCombat = useRef<HTMLButtonElement>(null)
+  const columnCombat = useRef<HTMLButtonElement>(null)
+  // Focus, where the control under it goes, as Undo does: to the turn panel's heading where the
+  // combat pane is shown, else to the Combat tab of the layout shown, never the page's body.
+  const focusTurn = () => {
+    const heading = document.querySelector<HTMLElement>('#turn-heading')
+    if (combatShown && heading) {
+      heading.focus({ preventScroll: true })
+      return
+    }
+    const combatTab = sideBySide ? columnCombat : barCombat
+    combatTab.current?.focus()
+  }
+  // The Combat tab held to end the turn, on the layout shown: its handlers on it always, which do
+  // nothing with no turn to end; while one may be ended, its fill and what it's described as.
+  const offeredTurn = ending.offered ? ending.turn : undefined
+  const holdOf = (id: string, shown: boolean): TabHold => ({
+    handlers: hold.handlers,
+    holding: shown && hold.holding,
+    touch: shown && (offeredTurn !== undefined || hold.pressed),
+    offer:
+      shown && offeredTurn
+        ? { fill: hold.fill, id, description: holdDescription(offeredTurn) }
+        : undefined,
+  })
+  return {
+    ending,
+    undoing,
+    via,
+    refused,
+    clearRefused: () => setRefused(undefined),
+    endTurn,
+    held,
+    quiet,
+    barCombat,
+    columnCombat,
+    focusTurn,
+    holdOf,
+  }
+}
diff --git a/src/features/table/hooks/use-typed-dice.ts b/src/features/table/hooks/use-typed-dice.ts
new file mode 100644
index 0000000..789f409
--- /dev/null
+++ b/src/features/table/hooks/use-typed-dice.ts
@@ -0,0 +1,50 @@
+import { useEffect, useState } from 'react'
+import { POLL_INTERVAL } from '@/constants/polling'
+import type { DiceSwitch } from '@/features/table/types'
+import type { TableView } from '@/types/table'
+
+/**
+ * Whether the player types in their own dice, as they chose on any device (module 0.32.0): the
+ * player's change, until a view agrees with it; one that disagrees, coming a poll after the
+ * save settled, is another device's later choice.
+ * @param setManualDice - Remembers the choice on every device. A player's page only.
+ * @returns The switch for it, where the game lets the player type in their own dice: never on the
+ *   Gamemaster's page, which has nowhere to remember it. Their companions' are the same.
+ */
+export function useTypedDice(
+  view: TableView,
+  setManualDice?: (on: boolean) => Promise<void>,
+): DiceSwitch | undefined {
+  const [diceChoice, setDiceChoice] = useState<{
+    on: boolean
+    settled?: number
+  }>()
+  const stored = view.manualDice?.on === true
+  const typing = diceChoice?.on ?? stored
+  useEffect(() => {
+    const told = view.manualDice?.on === true
+    setDiceChoice(held => {
+      if (!held || held.on === told) return
+      // A view polled before the save settled may still say what was stored before it.
+      const later =
+        held.settled !== undefined && Date.now() - held.settled > POLL_INTERVAL
+      return later ? undefined : held
+    })
+  }, [view])
+  const onManualDice = (next: boolean) => {
+    if (!setManualDice) return
+    const made = { on: next }
+    setDiceChoice(made)
+    setManualDice(next).then(
+      () =>
+        setDiceChoice(held =>
+          held === made ? { ...made, settled: Date.now() } : held,
+        ),
+      // Not saved: the switch shows what's stored again.
+      () => setDiceChoice(held => (held === made ? undefined : held)),
+    )
+  }
+  return view.connected && view.manualDice?.offered && setManualDice
+    ? { on: typing, onChange: onManualDice }
+    : undefined
+}
