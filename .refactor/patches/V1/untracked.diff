+import { useLayoutEffect, useRef, useState } from 'react'
+
+/**
+ * Where the turn's toast's card ends, for the roll toasts to start below it, as it shows, moves,
+ * changes or goes.
+ * @param onFoot - Told where the card ends, in pixels from the top, or that none shows.
+ * @param top - Where the toast starts, which moves the card with it.
+ * @returns The card's ref, which measures it.
+ */
+export function useToastFoot(
+  onFoot: ((foot: number | undefined) => void) | undefined,
+  top: number | undefined,
+) {
+  const [element, setElement] = useState<HTMLDivElement | null>(null)
+  const foot = useRef<number | undefined>(undefined)
+  const footing = useRef(onFoot)
+  useLayoutEffect(() => {
+    footing.current = onFoot
+  })
+  useLayoutEffect(() => {
+    // Where the card comes to rest, not where its entry has it now: its box as laid out in its
+    // region, which a transform doesn't move, as the card's first frame already has it 8 pixels
+    // higher and no resize follows to say otherwise.
+    const measure = () => {
+      const at = element
+        ? Math.ceil(
+            (element.parentElement?.getBoundingClientRect().top ?? 0) +
+              element.offsetTop +
+              element.offsetHeight,
+          )
+        : undefined
+      if (at === foot.current) return
+      foot.current = at
+      footing.current?.(at)
+    }
+    measure()
+    if (!element) return
+    const observer = new ResizeObserver(measure)
+    observer.observe(element)
+    globalThis.addEventListener('resize', measure)
+    return () => {
+      observer.disconnect()
+      globalThis.removeEventListener('resize', measure)
+    }
+  }, [element, top])
+  return setElement
+}
diff --git a/src/features/table/components/turn-toast/use-turn-toast-card.ts b/src/features/table/components/turn-toast/use-turn-toast-card.ts
new file mode 100644
index 0000000..e603371
--- /dev/null
+++ b/src/features/table/components/turn-toast/use-turn-toast-card.ts
@@ -0,0 +1,188 @@
+import { useEffect, useRef, useState } from 'react'
+import { lastsOf, nextCard, showsTurn } from './utils'
+import { POLL_INTERVAL } from '@/constants/polling'
+import type {
+  Card,
+  CardBody,
+  CardNext,
+  EndTurnState,
+  ToastSeen,
+  UndoState,
+} from '@/features/table/types'
+import type { TableCombat } from '@/types/table'
+
+/**
+ * How long a turn the game has ended, or taken back, may still be shown as it was before the page
+ * is taken to be showing the turn now, in milliseconds: two of the table's polls.
+ */
+const SETTLE_FOR = 2 * POLL_INTERVAL
+
+/**
+ * The turn's toast's card (module 0.36.0): one card at a time, each replacing the last, each
+ * numbered, so that the next is announced, and animates in, as a new one. What happened since the
+ * last render makes the card, in the order it did; an End Turn the game made but the page still
+ * shows as it was two polls on is told with no line and no Undo; an Undo made with the turn still
+ * not shown back two polls on goes all the same; and each card that lasts goes in its time, paused
+ * while the pointer is over it or focus is in it.
+ * @returns The card; `rest`, which pauses or resumes its time; and `takeBack`, Undo's own: its
+ *   card, and the Undo sent.
+ */
+export function useTurnToastCard({
+  ending,
+  undoing,
+  via,
+  held,
+  combatShown,
+  combat,
+}: {
+  ending: EndTurnState
+  undoing: UndoState
+  via?: 'button' | 'hold'
+  held: boolean
+  combatShown: boolean
+  combat?: TableCombat
+}) {
+  const [card, setCard] = useState<Card>()
+  const serials = useRef(0)
+  const make = (body: CardBody): Card => ({
+    ...body,
+    serial: (serials.current += 1),
+  })
+  // The End Turns whose ending has been told, by their ids: each is told once.
+  const told = useRef(new Set<string>())
+  // What was last seen of the hold, the End Turn sent last and its Undo's way.
+  const seen = useRef<ToastSeen>({ held: false })
+  // The card a hold's took the place of, which comes back if the hold is let go early.
+  const covered = useRef<Card>(undefined)
+  // What's left of the time of the card that lasts, by its number.
+  const remaining = useRef<{ serial: number; ms: number }>(undefined)
+  // The card next, numbered where it's new, with what was left of its time where it comes back.
+  const numbered = (next: CardNext): Card | undefined => {
+    if (!next) return undefined
+    if ('card' in next) return next.card
+    const made = make(next.make)
+    if (next.ms !== undefined) {
+      remaining.current = { serial: made.serial, ms: next.ms }
+    }
+    return made
+  }
+
+  const { sent } = ending
+  const { offer, way: undone } = undoing
+  // What happened since the last render, in the order it did; the last card made shows. It runs
+  // after every render, as it always has, and sets the card only where the card changes.
+  // eslint-disable-next-line react-hooks/exhaustive-deps -- after every render on purpose
+  useEffect(() => {
+    const was = seen.current
+    seen.current = { held, sent }
+    const step = nextCard(
+      card,
+      was,
+      {
+        held,
+        sent,
+        via,
+        combatShown,
+        combat,
+        turn: ending.turn,
+        offer,
+        undone,
+      },
+      {
+        told: told.current,
+        covered: covered.current,
+        remaining: remaining.current,
+      },
+    )
+    if (step.cover) covered.current = card
+    if (step.uncover) covered.current = undefined
+    if (step.tell) told.current.add(step.tell)
+    const next = numbered(step.next)
+    if (next !== card) setCard(next)
+  })
+
+  // An End Turn the game made, still shown as it was two polls on, as when the turn came back
+  // before the page saw it move: told with no line and no Undo.
+  const doneId = sent?.way.status === 'done' ? sent.way.requestId : undefined
+  const settling =
+    sent && doneId && showsTurn(combat, sent.turn) ? doneId : undefined
+  // Its turn, the same object for as long as it's the same End Turn.
+  const settlingTurn = settling === undefined ? undefined : sent?.turn
+  useEffect(() => {
+    if (settling === undefined || !settlingTurn) return
+    const timer = setTimeout(() => {
+      if (told.current.has(settling)) return
+      told.current.add(settling)
+      setCard(
+        make({ kind: 'ended', id: settling, turn: settlingTurn, undo: false }),
+      )
+    }, SETTLE_FOR)
+    return () => clearTimeout(timer)
+    // From when it was first seen so, however many polls show it.
+  }, [settling, settlingTurn])
+
+  // An Undo the game made, the turn still not shown back two polls on: it goes all the same.
+  const back =
+    card?.kind === 'taking' &&
+    undone?.for === card.id &&
+    undone.status === 'done'
+      ? card.serial
+      : undefined
+  useEffect(() => {
+    if (back === undefined) return
+    const timer = setTimeout(
+      () => setCard(shown => (shown?.serial === back ? undefined : shown)),
+      SETTLE_FOR,
+    )
+    return () => clearTimeout(timer)
+  }, [back])
+
+  // Its time, paused while the pointer is over it or focus is in it.
+  const [pause, setPause] = useState<{
+    serial: number
+    pointer: boolean
+    focus: boolean
+  }>()
+  const resting =
+    pause !== undefined &&
+    pause.serial === card?.serial &&
+    (pause.pointer || pause.focus)
+  const rest = (change: { pointer?: boolean; focus?: boolean }) => {
+    if (!card) return
+    setPause(was => ({
+      serial: card.serial,
+      pointer: false,
+      focus: false,
+      ...(was?.serial === card.serial && was),
+      ...change,
+    }))
+  }
+  useEffect(() => {
+    const lasts = card && lastsOf(card)
+    if (!card || lasts === undefined) return
+    if (remaining.current?.serial !== card.serial) {
+      remaining.current = { serial: card.serial, ms: lasts }
+    }
+    if (resting) return
+    const begun = Date.now()
+    const timer = setTimeout(
+      () =>
+        setCard(shown => (shown?.serial === card.serial ? undefined : shown)),
+      remaining.current.ms,
+    )
+    return () => {
+      clearTimeout(timer)
+      if (remaining.current?.serial === card.serial) {
+        remaining.current.ms -= Date.now() - begun
+      }
+    }
+  }, [card, resting])
+
+  // Undo, from its card: it says so until the page shows the turn back.
+  const takeBack = () => {
+    if (!offer) return
+    setCard(make({ kind: 'taking', id: offer.requestId, turn: offer.turn }))
+    undoing.undo()
+  }
+  return { card, rest, takeBack }
+}
diff --git a/src/features/table/components/turn-toast/utils.ts b/src/features/table/components/turn-toast/utils.ts
new file mode 100644
index 0000000..dea79df
--- /dev/null
+++ b/src/features/table/components/turn-toast/utils.ts
@@ -0,0 +1,240 @@
+import { NOT_MADE } from '@/constants/lifecycle'
+import { currentCombatant } from '@/features/table/utils/combat'
+import {
+  actingLine,
+  endTurnWords,
+  HOLD_HINT,
+  newlyNotMade,
+  reasonSentence,
+  refusalKey,
+  TURN_TOAST_FOR,
+  TURN_UNDO_FOR,
+  turnFragment,
+  turnSendingLine,
+} from '@/features/table/utils/end-turn'
+import type {
+  Card,
+  CardBody,
+  CardNext,
+  CardStep,
+  Sent,
+  ToastInputs,
+  ToastSeen,
+} from '@/features/table/types'
+import type { EndedTurn } from '@/types/roll'
+import type { SeatRole } from '@/types/seats'
+import type { TableCombat } from '@/types/table'
+
+/** Whether the page shows this turn now: its combat, started, at its round and combatant. */
+export function showsTurn(
+  combat: TableCombat | undefined,
+  turn: EndedTurn,
+): boolean {
+  return (
+    combat?.started === true &&
+    combat.id === turn.combatId &&
+    combat.round === turn.round &&
+    combat.currentId === turn.combatantId
+  )
+}
+
+/**
+ * Whether Undo's card has done its work: the page shows the turn it takes back, as the panel's
+ * heading does, whatever Undo's way says by now. The table's poll and the checks of Undo's way run
+ * apart, and the game moves the turn before it answers, so the panel can show the turn back a
+ * check before Undo's way says it's made: the card goes with the panel, never a check later.
+ */
+export function takenBack(
+  card: CardBody,
+  combat: TableCombat | undefined,
+): boolean {
+  return card.kind === 'taking' && showsTurn(combat, card.turn)
+}
+
+/** Who acts as the page shows the combat: by name, and whether it's the viewer's own character. */
+export function actingOf(
+  combat: TableCombat | undefined,
+): { name: string; mine: boolean } | undefined {
+  if (!combat?.started) return undefined
+  const current = currentCombatant(combat)
+  return current && { name: current.name, mine: current.side === 'me' }
+}
+
+/** How long a card shows, from when it's shown; none for one that follows a press or a way. */
+export function lastsOf(card: Card): number | undefined {
+  if (card.kind === 'ended') return card.undo ? TURN_UNDO_FOR : TURN_TOAST_FOR
+  if (card.kind === 'refused' || card.kind === 'kept') return TURN_TOAST_FOR
+  return undefined
+}
+
+/** A card's words, and the line under them, as the seat reads them. */
+export function wordsOf(
+  card: Card,
+  sent: Sent | undefined,
+  role: SeatRole,
+): { words: string; line?: string } {
+  const words = endTurnWords(card.turn)
+  switch (card.kind) {
+    case 'holding': {
+      return { words: words.ending, line: HOLD_HINT }
+    }
+    case 'sending': {
+      const way = sent?.turn === card.turn ? sent.way : undefined
+      return {
+        words: words.ending,
+        line: turnSendingLine(way ?? { status: 'sending' }, role),
+      }
+    }
+    case 'ended': {
+      return { words: words.ended, line: card.line }
+    }
+    case 'refused': {
+      const fragment = turnFragment(card.key, role)
+      return {
+        words: `${words.notEnded}.`,
+        line: fragment && reasonSentence(fragment),
+      }
+    }
+    case 'taking': {
+      return { words: words.takingBack }
+    }
+    case 'kept': {
+      const fragment = turnFragment(card.key, role)
+      return {
+        words: words.notTakenBack,
+        line: fragment && reasonSentence(fragment),
+      }
+    }
+  }
+}
+
+/**
+ * The card a hold's took the place of, shown again as a new one for what was left of its time, as
+ * the hold sent nothing; none where its time was up.
+ * @param remaining - What's left of the time of the card that lasts, by its number.
+ */
+function uncovered(
+  back: Card | undefined,
+  remaining: { serial: number; ms: number } | undefined,
+): CardNext {
+  if (!back) return undefined
+  const lasts = lastsOf(back)
+  if (lasts === undefined) return { make: back }
+  const left = remaining?.serial === back.serial ? remaining.ms : lasts
+  if (left <= 0) return undefined
+  return { make: back, ms: left }
+}
+
+/**
+ * A hold past half a second says it's ending the turn, taking the place of the card shown. Let go
+ * early, drifted or stopped, it goes at once, silently, and the card it took the place of, such as
+ * the last End Turn's with Undo, comes back where it's still to be shown.
+ */
+function holdStep(
+  card: Card | undefined,
+  was: ToastSeen,
+  now: ToastInputs,
+  covered: Card | undefined,
+  remaining: { serial: number; ms: number } | undefined,
+): Omit<CardStep, 'tell'> {
+  if (now.held && !was.held && now.turn) {
+    return {
+      next: { make: { kind: 'holding', turn: now.turn } },
+      cover: true,
+      uncover: false,
+    }
+  }
+  if (!now.held && was.held && card?.kind === 'holding') {
+    return { next: uncovered(covered, remaining), cover: false, uncover: true }
+  }
+  return { next: card && { card }, cover: false, uncover: false }
+}
+
+/**
+ * What the End Turn sent last says: a hold's on its way; the game made it, with who acts now, or
+ * with Undo while that's offered, told once, as the page shows the combat moved on; or it wasn't
+ * made, which the toast says for a hold's, or for the button's where the combat isn't shown.
+ * @param told - The End Turns whose ending has been told, by their ids.
+ */
+function wayStep(
+  next: CardNext,
+  was: ToastSeen,
+  now: ToastInputs,
+  told: ReadonlySet<string>,
+): { next: CardNext; tell?: string } {
+  const { sent, via, combat, offer } = now
+  let step: { next: CardNext; tell?: string } = { next }
+  if (sent && sent.turn !== was.sent?.turn && via === 'hold') {
+    step = { next: { make: { kind: 'sending', turn: sent.turn } } }
+  }
+  const id = sent?.way.status === 'done' ? sent.way.requestId : undefined
+  if (sent && id && !told.has(id) && !showsTurn(combat, sent.turn)) {
+    const undo = offer?.requestId === id
+    const left = undo ? offer.left : actingOf(combat)
+    step = {
+      next: {
+        make: {
+          kind: 'ended',
+          id,
+          turn: sent.turn,
+          line: left && actingLine(left),
+          undo,
+        },
+      },
+      tell: id,
+    }
+  }
+  if (newlyNotMade(was.sent, sent) && (via === 'hold' || !now.combatShown)) {
+    step = {
+      ...step,
+      next: {
+        make: { kind: 'refused', turn: sent.turn, key: refusalKey(sent.way) },
+      },
+    }
+  }
+  return step
+}
+
+/**
+ * What Undo's way says: the card goes as the page shows the turn taken back, or says Undo wasn't
+ * made; and once Undo is no longer offered, as the page shows another turn, the card offering it
+ * goes, silently.
+ */
+function undoStep(next: CardNext, now: ToastInputs): CardNext {
+  const body = next && ('card' in next ? next.card : next.make)
+  if (body?.kind === 'taking') {
+    if (takenBack(body, now.combat)) return undefined
+    const { undone } = now
+    if (undone?.for === body.id && NOT_MADE.has(undone.status)) {
+      return {
+        make: { kind: 'kept', turn: body.turn, key: refusalKey(undone) },
+      }
+    }
+  }
+  if (body?.kind === 'ended' && body.undo && now.offer?.requestId !== body.id) {
+    return undefined
+  }
+  return next
+}
+
+/**
+ * The toast's card from one render to the next: what happened since the last render, in the order
+ * it did; the last card made shows.
+ * @param was - What was last seen of the hold and the End Turn sent last.
+ * @param kept - The End Turns told, the card a hold's took the place of, and what's left of the
+ *   time of the card that lasts.
+ */
+export function nextCard(
+  card: Card | undefined,
+  was: ToastSeen,
+  now: ToastInputs,
+  kept: {
+    told: ReadonlySet<string>
+    covered?: Card
+    remaining?: { serial: number; ms: number }
+  },
+): CardStep {
+  const hold = holdStep(card, was, now, kept.covered, kept.remaining)
+  const way = wayStep(hold.next, was, now, kept.told)
+  return { ...hold, next: undoStep(way.next, now), tell: way.tell }
+}
