+  seatKey: string
+  addBack: string
+}>) {
+  return (
+    <>
+      {gm && <GmNote name={character.name} rolls={view.gm?.rolls ?? 'off'} />}
+      {playing && view.campaign && !view.connected && (
+        <NotConnected
+          name={character.name}
+          campaign={view.campaign.title}
+          addBack={addBack}
+        />
+      )}
+      {/* The game ended a Wild Shape (module 0.40.0): why, until dismissed. */}
