+    label: 'Offline',
+    dot: 'bg-text-secondary',
+    hint: unheard,
+  },
+  reconnecting: {
+    label: 'Reconnecting',
+    dot: 'bg-warning',
+    hint: 'Sending Stone cannot be reached. Trying again.',
