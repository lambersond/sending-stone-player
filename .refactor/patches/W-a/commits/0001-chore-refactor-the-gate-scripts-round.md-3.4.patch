diff --git a/.refactor/tools/gate-1.mjs b/.refactor/tools/gate-1.mjs
new file mode 100644
index 0000000..1711e51
--- /dev/null
+++ b/.refactor/tools/gate-1.mjs
@@ -0,0 +1,77 @@
+// Gate 1, assertions (round.md §3.4): per test (its describe/it title path and occurrence), the
+// ordered expect(...) statements, whitespace collapsed outside strings, at base and head; every
+// base list equals the head's for the same test, paths followed (moves.tsv, git's renames, the
+// checkout's moves.d splits). The goldens' tests are held the same way from the commit that added
+// them. Allowlist gate1.allow (path, reason): a test file whose tests may be gone (commit 26's
+// retirement of C1, C3 and C9 only).
+import fs from 'node:fs'
+import path from 'node:path'
+import {
+  BASE_DIR,
+  expectsOf,
+  frozenFiles,
+  gate,
+  git,
+  isTestFile,
+  parse,
+  readAllow,
+  testsOf,
+  verdict,
+} from './gate-lib.mjs'
+
+gate('1', checkout => {
+  const problems = []
+  const allowed = new Set(readAllow('gate1.allow').map(([file]) => file))
+  const headTests = file =>
+    checkout.memo(`tests:${file}`, () => {
+      const sf = checkout.parse(file)
+      const map = new Map()
+      for (const test of testsOf(sf)) {
+        if (test.kind === 'test') map.set(`${test.key}\0${test.occurrence}`, expectsOf(test, sf))
+      }
+      return map
+    })
+  let tests = 0
+  const compare = (origin, file, list, where) => {
+    for (const { key, occurrence, expects } of list) {
+      tests += 1
+      const now = where(key)
+      if (!now) {
+        if (!allowed.has(origin)) problems.push(`${origin}: gone (${key})`)
+        continue
+      }
+      const head = headTests(now).get(`${key}\0${occurrence}`)
+      if (!head) problems.push(`${origin} → ${now}: no test "${key}" #${occurrence}`)
+      else if (JSON.stringify(head) !== JSON.stringify(expects)) {
+        const at = expects.findIndex((line, i) => head[i] !== line)
+        const index = at === -1 ? expects.length : at
+        problems.push(
+          `${origin} → ${now}: "${key}" #${occurrence}, expect ${index + 1} of ${expects.length}: ` +
+            `base ${JSON.stringify(expects[index] ?? '(none)')}, head ${JSON.stringify(head[index] ?? '(none)')}`,
+        )
+      }
+    }
+  }
+  // The base test files.
+  const root = path.join(BASE_DIR, 'expects')
+  const baseFiles = checkout.baseFiles.filter(file => file.startsWith('src/') && isTestFile(file))
+  for (const file of baseFiles) {
+    const json = path.join(root, `${file}.json`)
+    if (!fs.existsSync(json)) throw new Error(`no ${json}: run R/tools/base.sh --force`)
+    compare(file, file, JSON.parse(fs.readFileSync(json, 'utf8')), key =>
+      checkout.headOfTest(file, key),
+    )
+  }
+  // The goldens' (and the kit test's) tests, from the commit that added each.
+  let frozen = 0
+  for (const { file, sha, gone } of frozenFiles(checkout)) {
+    if (!isTestFile(file) || file.endsWith('.snap')) continue
+    frozen += 1
+    const sf = parse(file, git(checkout.root, ['show', `${sha}:${file}`]))
+    const list = testsOf(sf)
+      .filter(test => test.kind === 'test')
+      .map(test => ({ key: test.key, occurrence: test.occurrence, expects: expectsOf(test, sf) }))
+    compare(file, file, list, () => (gone ? undefined : file))
+  }
+  return verdict(problems, `${tests} tests in ${baseFiles.length} base test files and ${frozen} frozen ones`)
+})
diff --git a/.refactor/tools/gate-10.mjs b/.refactor/tools/gate-10.mjs
new file mode 100644
index 0000000..fc9479f
--- /dev/null
+++ b/.refactor/tools/gate-10.mjs
@@ -0,0 +1,76 @@
+// Gate 10, goldens and the frozen kit (round.md §3.4, SA F5): every test under src/__tests__/golden/
+// passed; jest.json's snapshot counts added, unchecked and updated are 0; and from the commit that
+// added each (in the checkout's history since 24f808b), no change to src/__tests__/golden/**
+// (snapshots byte for byte), the kit (src/utils/test-utils.ts, test-utils.test.ts,
+// test-utils-node.ts, src/mocks/dice-renderer.ts, src/mocks/sheet-providers/**) but in import
+// declarations and the path strings of jest.mock and its kin. A file that commit added and the
+// checkout no longer has must be a counts.conf retirement (commit 26: C1, C3, C9 and their .snap).
+import ts from 'typescript'
+import { GOLDEN_DIR, frozenFiles, gate, git, parse, retired, verdict } from './gate-lib.mjs'
+
+const PATH_CALLS = new Set(['mock', 'doMock', 'requireActual', 'requireMock', 'unmock'])
+
+// The text with import declarations cut out and jest path strings replaced, as it is otherwise.
+function frozenText(file, text) {
+  if (!/\.[jt]sx?$/.test(file)) return text
+  const sf = parse(file, text)
+  const cuts = []
+  for (const statement of sf.statements) {
+    if (ts.isImportDeclaration(statement)) cuts.push([statement.getFullStart(), statement.getEnd(), ''])
+  }
+  const visit = node => {
+    if (
+      ts.isCallExpression(node) &&
+      ts.isPropertyAccessExpression(node.expression) &&
+      ts.isIdentifier(node.expression.expression) &&
+      node.expression.expression.text === 'jest' &&
+      PATH_CALLS.has(node.expression.name.text) &&
+      node.arguments[0] &&
+      ts.isStringLiteralLike(node.arguments[0])
+    ) {
+      cuts.push([node.arguments[0].getStart(sf), node.arguments[0].getEnd(), "'<path>'"])
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sf)
+  let out = text
+  for (const [start, end, put] of cuts.sort((a, b) => b[0] - a[0])) out = out.slice(0, start) + put + out.slice(end)
+  return out.replace(/^\s+/, '')
+}
+
+gate('10', checkout => {
+  const problems = []
+  const { snapshot, suites } = checkout.jest
+  for (const key of ['added', 'unchecked', 'updated']) {
+    if ((snapshot?.[key] ?? 0) !== 0) problems.push(`jest.json snapshot.${key} = ${snapshot[key]}`)
+  }
+  let goldenTests = 0
+  for (const suite of suites) {
+    if (!suite.file.startsWith(GOLDEN_DIR)) continue
+    if (suite.status !== 'passed') problems.push(`${suite.file}: ${suite.status} ${suite.message.slice(0, 200)}`)
+    for (const test of suite.tests) {
+      goldenTests += 1
+      if (test.status !== 'passed') problems.push(`${suite.file}: "${test.fullName}" ${test.status}`)
+    }
+  }
+  const ran = new Set(suites.map(suite => suite.file))
+  const gone = retired()
+  const frozen = frozenFiles(checkout)
+  for (const { file, sha, gone: missing } of frozen) {
+    if (missing) {
+      if (!gone.has(file)) problems.push(`${file}: added in ${sha.slice(0, 7)}, gone, and not a counts.conf retirement`)
+      continue
+    }
+    if (file.startsWith(GOLDEN_DIR) && /\.test\.[jt]sx?$/.test(file) && !ran.has(file)) problems.push(`${file}: not run`)
+    const then = git(checkout.root, ['show', `${sha}:${file}`])
+    const now = checkout.text(file)
+    if (file.endsWith('.snap') ? then !== now : frozenText(file, then) !== frozenText(file, now)) {
+      problems.push(`${file}: changed since ${sha.slice(0, 7)}, which added it`)
+    }
+  }
+  const pending = checkout.files.filter(
+    file => file.startsWith(GOLDEN_DIR) && !frozen.some(f => f.file === file),
+  )
+  const notes = pending.map(file => `not committed yet, held from the commit that adds it: ${file}`)
+  return verdict(problems, `${goldenTests} golden tests, ${frozen.length} frozen files held`, notes)
+})
diff --git a/.refactor/tools/gate-11.mjs b/.refactor/tools/gate-11.mjs
new file mode 100644
index 0000000..2cec029
--- /dev/null
+++ b/.refactor/tools/gate-11.mjs
@@ -0,0 +1,63 @@
+// Gate 11, directives (round.md §3.4, SA F7, §1.0 rule 9): every base module keeps its 'use client'
+// or 'use server' and gains none (paths followed); a new module has 'use client' only if it is a
+// component .tsx (not a types, constants, utils or use-* module), and none has 'use server'; the
+// 'use server' modules stay 2; every module in the head's server graph (from src/app's pages,
+// layouts, not-found, manifest, routes and actions through value imports, stopping at 'use client'
+// modules) is a base server-graph module (followed) or a new module with no component; and
+// header-account.tsx stays a Server Component.
+import path from 'node:path'
+import {
+  directiveOf,
+  gate,
+  hasComponent,
+  isTestFile,
+  readBaseJson,
+  serverGraph,
+  verdict,
+} from './gate-lib.mjs'
+
+const HEADER = 'src/components/site-header/header-account.tsx'
+
+gate('11', checkout => {
+  const problems = []
+  const notes = []
+  const base = readBaseJson('base.json')
+  const baseServer = new Set(base.server)
+  const modules = checkout.files.filter(file => file.startsWith('src/') && /\.(ts|tsx)$/.test(file) && !isTestFile(file))
+  let servers = 0
+  for (const file of modules) {
+    const directive = directiveOf(checkout.parse(file))
+    if (directive === 'use server') servers += 1
+    const was = checkout.base(file)
+    if (was !== undefined) {
+      const then = base.directives[was] ?? ''
+      if (directive !== then) problems.push(`${file}: '${then || 'no directive'}' at the base (${was}), '${directive || 'no directive'}' now`)
+      continue
+    }
+    if (directive === 'use server') problems.push(`${file}: a new 'use server' module`)
+    if (directive === 'use client') {
+      const name = path.basename(file)
+      const piece = /^(types|constants|utils)\.tsx?$/.test(name) || /^use-/.test(name) || !file.endsWith('.tsx')
+      if (piece || !hasComponent(file, checkout.parse(file))) problems.push(`${file}: a new 'use client' module that is not a component .tsx`)
+      else notes.push(`new 'use client' component: ${file}`)
+    }
+  }
+  if (servers !== 2) problems.push(`${servers} 'use server' modules, the base 2`)
+  const graph = serverGraph(modules, file => checkout.parse(file), checkout.resolver.resolve)
+  for (const file of graph.server) {
+    const was = checkout.base(file)
+    if (was !== undefined) {
+      if (!baseServer.has(was)) problems.push(`${file}: in the server graph now, not at the base (${was})`)
+    } else if (hasComponent(file, checkout.parse(file))) {
+      problems.push(`${file}: a new component module in the server graph`)
+    }
+  }
+  const header = checkout.head(HEADER)
+  if (!header) problems.push(`${HEADER}: gone`)
+  else if (!graph.server.includes(header)) problems.push(`${header}: not a Server Component in the server graph`)
+  return verdict(
+    problems,
+    `${modules.length} modules, ${graph.server.length} server modules (base ${base.server.length}), ${graph.boundaries.length} client boundaries`,
+    notes,
+  )
+})
diff --git a/.refactor/tools/gate-12.mjs b/.refactor/tools/gate-12.mjs
new file mode 100644
index 0000000..3eb497f
--- /dev/null
+++ b/.refactor/tools/gate-12.mjs
@@ -0,0 +1,32 @@
+// Gate 12, cycles (round.md §3.4, SA F14): the import graph of src (type-only imports included, as
+// R/analysis/metrics/graph.mjs counts it) has no strongly connected group the base lacks, and no
+// group grows: each head group's modules, followed back to the base, all sit in one base group,
+// and none is new since the base. Groups gone are listed (group 1 after commit 7, the db group
+// after commit 9, all four after integration; from commit 23 the import-cycle test holds it).
+import { gate, graphEdges, readBaseJson, stronglyConnected, verdict } from './gate-lib.mjs'
+
+gate('12', checkout => {
+  const problems = []
+  const notes = []
+  const base = readBaseJson('base.json')
+  const files = checkout.files.filter(file => file.startsWith('src/') && /\.(ts|tsx)$/.test(file))
+  const groups = stronglyConnected(graphEdges(files, file => checkout.parse(file), checkout.resolver.resolve))
+  const groupOf = new Map()
+  base.groups.forEach((group, index) => group.forEach(file => groupOf.set(file, index)))
+  const left = new Set()
+  for (const group of groups) {
+    const back = group.map(file => checkout.base(file))
+    const homes = new Set(back.map(file => (file === undefined ? undefined : groupOf.get(file))))
+    if (homes.size !== 1 || homes.has(undefined)) {
+      problems.push(`a cycle group the base lacks, or that grew: ${group.join(', ')}`)
+    } else {
+      const [home] = homes
+      left.add(home)
+      notes.push(`group of ${group.length} (base ${base.groups[home].length}): ${group.join(', ')}`)
+    }
+  }
+  base.groups.forEach((group, index) => {
+    if (!left.has(index)) notes.push(`base group gone: ${group.length} files from ${group[0]}`)
+  })
+  return verdict(problems, `${groups.length} cycle groups (base ${base.groups.length})`, notes)
+})
diff --git a/.refactor/tools/gate-1b.mjs b/.refactor/tools/gate-1b.mjs
new file mode 100644
index 0000000..0144228
--- /dev/null
+++ b/.refactor/tools/gate-1b.mjs
@@ -0,0 +1,338 @@
+// Gate 1b, the whole test file (round.md §3.4, SA F1): each base test file (paths followed) and its
+// head, both parsed, with these dropped from both: import declarations; the path strings of
+// jest.mock/requireActual/requireMock/doMock, require(), import() and `typeof import()`; a mock
+// factory's keys that are moved names (moves.tsv `name` rows), compared apart as a multiset of
+// `key: value` (a factory left with nothing but a requireActual spread goes); guardNoDb()
+// statements; the base's top-level helpers the kit replaced (R3.3: a name the head no longer
+// declares and imports from the kit, test-utils, test-utils-node or dice-renderer); comments;
+// type aliases and interfaces. Then printed with the TS printer, whitespace collapsed outside
+// strings: the two must be equal, and each file's leading `@jest-environment` docblock must be
+// equal and first. A split file (moves.d) is held test by test: each test's statement equal in
+// the file its split names, every other statement of a head piece one of the base's at the same
+// describe path, and every base statement in some piece.
+// Allowlist gate1b.allow: `<base path>\tmock\t<mock path>\t<reason>` (those jest.mock statements
+// left out on both sides) or `<base path>\tfile\t-\t<reason>` (the file not compared).
+import ts from 'typescript'
+import {
+  BASE_DIR,
+  KIT_MODULES,
+  gate,
+  importsOf,
+  isTestFile,
+  leadingDocblock,
+  movedNames,
+  parse,
+  print,
+  propertyName,
+  readAllow,
+  squeeze,
+  testsOf,
+  topLevelNames,
+  verdict,
+} from './gate-lib.mjs'
+import fs from 'node:fs'
+import path from 'node:path'
+
+const PATH_CALLS = new Set(['mock', 'doMock', 'requireActual', 'requireMock', 'unmock'])
+const PLACEHOLDER = '<path>'
+
+const isJestCall = (node, names) =>
+  ts.isCallExpression(node) &&
+  ts.isPropertyAccessExpression(node.expression) &&
+  ts.isIdentifier(node.expression.expression) &&
+  node.expression.expression.text === 'jest' &&
+  names.has(node.expression.name.text)
+
+const MOCKS = new Set(['mock', 'doMock'])
+const mockOf = statement => {
+  if (!ts.isExpressionStatement(statement)) return undefined
+  const call = statement.expression
+  const spec = isJestCall(call, MOCKS) ? call.arguments[0] : undefined
+  return spec && ts.isStringLiteralLike(spec) ? call : undefined
+}
+
+const returnedObject = factory => {
+  if (!factory || !(ts.isArrowFunction(factory) || ts.isFunctionExpression(factory))) return undefined
+  let at = ts.isBlock(factory.body)
+    ? factory.body.statements.findLast(s => ts.isReturnStatement(s))?.expression
+    : factory.body
+  while (at && (ts.isParenthesizedExpression(at) || ts.isAsExpression(at))) at = at.expression
+  return at && ts.isObjectLiteralExpression(at) ? at : undefined
+}
+
+const isRequireActualSpread = property =>
+  ts.isSpreadAssignment(property) &&
+  ts.isCallExpression(property.expression) &&
+  isJestCall(property.expression, new Set(['requireActual']))
+
+// The normalizer of one side of a file: `norm(node)` prints a node with the dropped parts gone
+// ('' when the whole node goes); `movedKeys` gathers the moved mock keys it took out.
+function normalizer(sf, { moved, dropHelpers, dropMocks }) {
+  const movedKeys = []
+  const marked = new Set()
+  const dropped = new Set()
+  const visitStatements = (statements, top) => {
+    for (const statement of statements) {
+      if (
+        ts.isImportDeclaration(statement) ||
+        ts.isImportEqualsDeclaration(statement) ||
+        ts.isTypeAliasDeclaration(statement) ||
+        ts.isInterfaceDeclaration(statement)
+      ) {
+        dropped.add(statement)
+      } else if (
+        ts.isExpressionStatement(statement) &&
+        ts.isCallExpression(statement.expression) &&
+        ts.isIdentifier(statement.expression.expression) &&
+        statement.expression.expression.text === 'guardNoDb'
+      ) {
+        dropped.add(statement)
+      } else if (top && dropHelpers.size > 0) {
+        const names = topLevelNames({ statements: [statement] })
+        if (names.size > 0 && [...names].every(name => dropHelpers.has(name))) dropped.add(statement)
+      }
+      const mock = mockOf(statement)
+      if (mock) {
+        if (dropMocks.has(mock.arguments[0].text)) {
+          dropped.add(statement)
+          continue
+        }
+        const object = returnedObject(mock.arguments[1])
+        if (object) {
+          let took = 0
+          for (const property of object.properties) {
+            const name = !ts.isSpreadAssignment(property) && property.name && propertyName(property)
+            if (name && moved.has(name)) {
+              took += 1
+              movedKeys.push(squeeze(print(property, sf)))
+            }
+          }
+          if (took > 0) {
+            marked.add(object)
+            const left = object.properties.filter(
+              p => !(!ts.isSpreadAssignment(p) && p.name && moved.has(propertyName(p))),
+            )
+            if (left.every(isRequireActualSpread)) dropped.add(statement)
+          }
+        }
+      }
+    }
+  }
+  const walk = node => {
+    if (ts.isSourceFile(node) || ts.isBlock(node) || ts.isModuleBlock(node)) {
+      visitStatements(node.statements, ts.isSourceFile(node))
+    }
+    ts.forEachChild(node, walk)
+  }
+  walk(sf)
+  const literal = node => ts.isStringLiteralLike(node)
+  const transformer = context => {
+    const { factory } = context
+    const visit = node => {
+      if (dropped.has(node)) return undefined
+      if (
+        (ts.isPropertyAssignment(node) || ts.isShorthandPropertyAssignment(node) || ts.isMethodDeclaration(node)) &&
+        node.parent &&
+        marked.has(node.parent) &&
+        moved.has(propertyName(node))
+      ) {
+        return undefined
+      }
+      if (ts.isCallExpression(node) && node.arguments.length > 0 && literal(node.arguments[0])) {
+        const isPath =
+          isJestCall(node, PATH_CALLS) ||
+          node.expression.kind === ts.SyntaxKind.ImportKeyword ||
+          (ts.isIdentifier(node.expression) && node.expression.text === 'require')
+        if (isPath) {
+          const visited = ts.visitEachChild(node, visit, context)
+          return factory.updateCallExpression(visited, visited.expression, visited.typeArguments, [
+            factory.createStringLiteral(PLACEHOLDER),
+            ...visited.arguments.slice(1),
+          ])
+        }
+      }
+      if (ts.isImportTypeNode(node)) {
+        const visited = ts.visitEachChild(node, visit, context)
+        return factory.updateImportTypeNode(
+          visited,
+          factory.createLiteralTypeNode(factory.createStringLiteral(PLACEHOLDER)),
+          visited.attributes,
+          visited.qualifier,
+          visited.typeArguments,
+          visited.isTypeOf,
+        )
+      }
+      return ts.visitEachChild(node, visit, context)
+    }
+    return root => ts.visitNode(root, visit)
+  }
+  const norm = node => {
+    if (dropped.has(node)) return ''
+    const result = ts.transform(node, [transformer])
+    const out = result.transformed[0]
+    const text = out ? squeeze(ts.isSourceFile(out) ? ts.createPrinter({ removeComments: true }).printFile(out) : print(out, sf)) : ''
+    result.dispose()
+    return text
+  }
+  return { norm, movedKeys }
+}
+
+// The base's top-level helpers the head no longer declares and imports from the kit.
+function kitReplaced(checkout, baseSf, heads) {
+  const declared = new Set(heads.flatMap(file => [...topLevelNames(checkout.parse(file))]))
+  const fromKit = new Map()
+  for (const file of heads) {
+    for (const edge of importsOf(checkout.parse(file))) {
+      if (edge.typeOnly) continue
+      const target = checkout.resolver.resolve(edge.spec, file).file
+      if (!target || !KIT_MODULES.has(target)) continue
+      for (const { imported, local } of edge.names) fromKit.set(local, { imported, target })
+    }
+  }
+  const names = new Map()
+  for (const name of topLevelNames(baseSf)) {
+    if (!declared.has(name) && fromKit.has(name)) names.set(name, fromKit.get(name))
+  }
+  return names
+}
+
+// A declaration's JavaScript, `export` dropped, for comparing a replaced helper with the kit's.
+function javascriptOf(sf, name, as = name) {
+  for (const statement of sf.statements) {
+    if (!topLevelNames({ statements: [statement] }).has(name)) continue
+    const text = statement
+      .getText(sf)
+      .replace(/^export\s+/, '')
+      .replaceAll(new RegExp(`\\b${name}\\b`, 'g'), as)
+    const js = ts.transpileModule(text, {
+      compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.ESNext, jsx: ts.JsxEmit.Preserve },
+      fileName: sf.fileName,
+    }).outputText
+    return squeeze(js)
+  }
+  return undefined
+}
+
+// A test file's pieces for a split: its tests' statements by key and occurrence, and its other
+// statements by the describe path they sit in.
+function piecesOf(sf, norm) {
+  const leaves = new Map()
+  const context = []
+  const tests = testsOf(sf)
+  const byNode = new Map(tests.map(test => [test.node, test]))
+  for (const test of tests) {
+    if (test.kind === 'test') leaves.set(`${test.key}\0${test.occurrence}`, norm(test.statement ?? test.node))
+  }
+  const scan = (statements, at) => {
+    for (const statement of statements) {
+      const call = ts.isExpressionStatement(statement) ? byNode.get(statement.expression) : undefined
+      if (call?.kind === 'describe') {
+        const callback = call.node.arguments.at(-1)
+        if (callback && (ts.isArrowFunction(callback) || ts.isFunctionExpression(callback)) && ts.isBlock(callback.body)) {
+          scan(callback.body.statements, call.key)
+        }
+      } else if (!call) {
+        const text = norm(statement)
+        if (text) context.push(`${at}\0${text}`)
+      }
+    }
+  }
+  scan(sf.statements, '')
+  return { leaves, context }
+}
+
+gate('1b', checkout => {
+  const problems = []
+  const notes = []
+  const moved = movedNames()
+  const allow = readAllow('gate1b.allow')
+  const allowFile = new Set(allow.filter(([, what]) => what === 'file').map(([file]) => file))
+  const allowMocks = file => new Set(allow.filter(([f, what]) => f === file && what === 'mock').map(([, , spec]) => spec))
+  const baseFiles = checkout.baseFiles.filter(file => file.startsWith('src/') && isTestFile(file))
+  let compared = 0
+  for (const file of baseFiles) {
+    if (allowFile.has(file)) {
+      notes.push(`skipped ${file} (gate1b.allow)`)
+      continue
+    }
+    const stored = path.join(BASE_DIR, 'files', file)
+    const baseText = fs.existsSync(stored) ? fs.readFileSync(stored, 'utf8') : checkout.baseText(file)
+    const baseSf = parse(file, baseText)
+    const splits = checkout.splitsOf(file)
+    const remainder = checkout.head(file)
+    const heads = [...new Set([...splits.map(s => s.to), ...(remainder ? [remainder] : [])])]
+    if (heads.length === 0) {
+      problems.push(`${file}: gone`)
+      continue
+    }
+    const replaced = kitReplaced(checkout, baseSf, heads)
+    for (const [name, { imported, target }] of replaced) {
+      const kit = javascriptOf(checkout.parse(target), imported, name)
+      const local = javascriptOf(baseSf, name)
+      if (kit !== local) notes.push(`note ${file}: helper ${name} replaced by ${target}'s ${imported}, whose JavaScript differs (review)`)
+    }
+    const dropMocks = allowMocks(file)
+    const base = normalizer(baseSf, { moved, dropHelpers: new Set(replaced.keys()), dropMocks })
+    const baseBlock = leadingDocblock(baseText)
+    for (const head of heads) {
+      if (leadingDocblock(checkout.text(head)) !== baseBlock) {
+        problems.push(`${file} → ${head}: the leading docblock is not the base's, or not first`)
+      }
+    }
+    compared += 1
+    if (splits.length === 0) {
+      const headSide = normalizer(checkout.parse(heads[0]), { moved, dropHelpers: new Set(), dropMocks })
+      const a = base.norm(baseSf)
+      const b = headSide.norm(checkout.parse(heads[0]))
+      if (a !== b) {
+        let at = 0
+        while (at < a.length && a[at] === b[at]) at += 1
+        problems.push(
+          `${file} → ${heads[0]}: differs at ${at}: base …${JSON.stringify(a.slice(Math.max(0, at - 60), at + 80))}… ` +
+            `head …${JSON.stringify(b.slice(Math.max(0, at - 60), at + 80))}…`,
+        )
+      }
+      const keysA = [...base.movedKeys].sort().join(' | ')
+      const keysB = [...headSide.movedKeys].sort().join(' | ')
+      if (keysA !== keysB) problems.push(`${file} → ${heads[0]}: moved mock keys differ: base [${keysA}], head [${keysB}]`)
+      continue
+    }
+    // A split: test by test, and the rest statement by statement.
+    const basePieces = piecesOf(baseSf, base.norm)
+    const baseContext = new Set(basePieces.context)
+    const seenContext = new Set()
+    const headKeys = []
+    for (const head of heads) {
+      const sf = checkout.parse(head)
+      const side = normalizer(sf, { moved, dropHelpers: new Set(), dropMocks })
+      const pieces = piecesOf(sf, side.norm)
+      headKeys.push(...side.movedKeys)
+      for (const [key, text] of pieces.leaves) {
+        const [title] = key.split('\0')
+        if (checkout.headOfTest(file, title) !== head) continue
+        const was = basePieces.leaves.get(key)
+        if (was === undefined) continue
+        if (was !== text) problems.push(`${file} → ${head}: test "${title}" differs`)
+      }
+      for (const item of pieces.context) {
+        if (!baseContext.has(item)) problems.push(`${file} → ${head}: a statement not in the base: ${JSON.stringify(item.split('\0')[1].slice(0, 160))}`)
+        seenContext.add(item)
+      }
+    }
+    for (const [key] of basePieces.leaves) {
+      const [title] = key.split('\0')
+      const head = checkout.headOfTest(file, title)
+      const sf = head && checkout.parse(head)
+      if (!sf || !testsOf(sf).some(test => test.kind === 'test' && `${test.key}\0${test.occurrence}` === key)) {
+        problems.push(`${file}: test "${title}" is in no piece`)
+      }
+    }
+    for (const item of baseContext) {
+      if (!seenContext.has(item)) problems.push(`${file}: a base statement in no piece: ${JSON.stringify(item.split('\0')[1].slice(0, 160))}`)
+    }
+    if ([...base.movedKeys].sort().join(' | ') !== headKeys.sort().join(' | ')) {
+      problems.push(`${file}: moved mock keys differ across its pieces`)
+    }
+  }
+  return verdict(problems, `${compared} base test files compared, ${moved.size} moved names`, notes)
+})
diff --git a/.refactor/tools/gate-2.mjs b/.refactor/tools/gate-2.mjs
new file mode 100644
index 0000000..be0056c
--- /dev/null
+++ b/.refactor/tools/gate-2.mjs
@@ -0,0 +1,37 @@
+// Gate 2, per test (round.md §3.4): each base test (X/base/jest-base.tsv) is present at head (its
+// file followed, its fullName and occurrence), `status: passed`, numPassingAsserts ≥ the base's.
+// A test red in jest.json that l1.sh's rerun alone found green (reruns.tsv) counts as passed and
+// is listed as a flake.
+import path from 'node:path'
+import { gate, readBaseTests, readTsv, retired, unescapeField, verdict } from './gate-lib.mjs'
+
+gate('2', checkout => {
+  const problems = []
+  const notes = []
+  const head = new Map()
+  for (const suite of checkout.jest.suites) {
+    for (const test of suite.tests) head.set(`${suite.file}\0${test.fullName}\0${test.occurrence}`, test)
+  }
+  const reruns = new Map(
+    readTsv(path.join(checkout.outdir, 'reruns.tsv')).map(([file, fullName, status]) => [
+      `${file}\0${unescapeField(fullName)}`,
+      status,
+    ]),
+  )
+  const gone = retired()
+  const base = readBaseTests()
+  for (const test of base) {
+    if (gone.has(test.file)) continue
+    const file = checkout.headOfTest(test.file, test.fullName)
+    const now = file && head.get(`${file}\0${test.fullName}\0${test.occurrence}`)
+    const where = `${test.file}${file && file !== test.file ? ` → ${file}` : ''}: "${test.fullName}"${test.occurrence ? ` #${test.occurrence}` : ''}`
+    if (!now) problems.push(`${where}: not run`)
+    else if (now.status !== 'passed') {
+      if (reruns.get(`${file}\0${test.fullName}`) === 'passed') notes.push(`flake ${where}: ${now.status}, green alone`)
+      else problems.push(`${where}: ${now.status}`)
+    } else if (now.numPassingAsserts < test.numPassingAsserts) {
+      problems.push(`${where}: ${now.numPassingAsserts} passing asserts, base ${test.numPassingAsserts}`)
+    }
+  }
+  return verdict(problems, `${base.length} base tests`, notes)
+})
diff --git a/.refactor/tools/gate-3.mjs b/.refactor/tools/gate-3.mjs
new file mode 100644
index 0000000..a9f2963
--- /dev/null
+++ b/.refactor/tools/gate-3.mjs
@@ -0,0 +1,46 @@
+// Gate 3, counts (round.md §3.4), derived from the checkout: head suites ≥ base suites − retired
+// (counts.conf's `retire` rows, commit 26's only); every head test not in the base sits in a file
+// absent at the base or in a split's target (moves.d), so no base file gains a test; and the head
+// runs at least as many tests as the base less the retired ones.
+import { gate, readBaseTests, retired, verdict } from './gate-lib.mjs'
+
+gate('3', checkout => {
+  const problems = []
+  const base = readBaseTests()
+  const gone = retired()
+  const baseSuites = new Set(base.map(test => test.file))
+  const keep = [...baseSuites].filter(file => !gone.has(file))
+  const known = new Set(
+    base.map(test => {
+      const file = checkout.headOfTest(test.file, test.fullName)
+      return `${file}\0${test.fullName}\0${test.occurrence}`
+    }),
+  )
+  const targets = new Set(checkout.splits.map(split => split.to))
+  const { suites, totals } = checkout.jest
+  if (suites.length < keep.length) {
+    problems.push(`${suites.length} suites ran, the base had ${baseSuites.size} (${gone.size} retired)`)
+  }
+  let added = 0
+  const addedIn = new Map()
+  for (const suite of suites) {
+    const baseFile = checkout.base(suite.file)
+    const newFile = baseFile === undefined
+    for (const test of suite.tests) {
+      if (known.has(`${suite.file}\0${test.fullName}\0${test.occurrence}`)) continue
+      added += 1
+      addedIn.set(suite.file, (addedIn.get(suite.file) ?? 0) + 1)
+      if (!newFile && !targets.has(suite.file)) {
+        problems.push(`${suite.file} (base ${baseFile}): a test the base did not have: "${test.fullName}"`)
+      }
+    }
+  }
+  const baseTests = base.filter(test => !gone.has(test.file)).length
+  if (totals.tests < baseTests) problems.push(`${totals.tests} tests ran, the base had ${baseTests}`)
+  const notes = [...addedIn].map(([file, count]) => `new ${file}: ${count} test(s)`)
+  return verdict(
+    problems,
+    `${suites.length} suites (base ${baseSuites.size}), ${totals.tests} tests (base ${base.length}), ${added} new`,
+    notes,
+  )
+})
diff --git a/.refactor/tools/gate-4.mjs b/.refactor/tools/gate-4.mjs
new file mode 100644
index 0000000..870226e
--- /dev/null
+++ b/.refactor/tools/gate-4.mjs
@@ -0,0 +1,52 @@
+// Gate 4, stale mocks (round.md §3.4): in every test file, each jest.mock / doMock / requireActual
+// / requireMock path resolves (tsconfig paths, `@/`, src modulePaths, relative to the test's
+// folder, packages); for a jest.mock or doMock the module is in the import closure of the test's
+// own imports (a requireActual target needs no importer: R3.3's dice-renderer lines); and every
+// key of a mock factory's object literal is an export of the module (`__esModule` aside; a
+// package's keys are not checked).
+import {
+  closure,
+  exportsOf,
+  factoryObject,
+  gate,
+  isTestFile,
+  jestCalls,
+  verdict,
+} from './gate-lib.mjs'
+
+gate('4', checkout => {
+  const problems = []
+  const tests = checkout.files.filter(file => file.startsWith('src/') && isTestFile(file) && /\.[jt]sx?$/.test(file))
+  let mocks = 0
+  let packages = 0
+  for (const file of tests) {
+    const sf = checkout.parse(file)
+    const calls = jestCalls(sf)
+    if (calls.length === 0) continue
+    const reach = checkout.memo(`closure:${file}`, () => closure(checkout, [file, 'jest.setup.ts']))
+    for (const { method, spec, factory } of calls) {
+      if (method === 'unmock') continue
+      mocks += 1
+      const target = checkout.resolver.resolve(spec, file)
+      if (!target.file && !target.external) {
+        problems.push(`${file}: jest.${method}('${spec}') resolves to nothing`)
+        continue
+      }
+      if (method !== 'mock' && method !== 'doMock') continue
+      const reached = target.file ? reach.files.has(target.file) : reach.packages.has(target.external)
+      if (!reached) problems.push(`${file}: jest.${method}('${spec}') mocks a module the test never imports`)
+      if (target.external) {
+        packages += 1
+        continue
+      }
+      const object = factoryObject(factory)
+      if (!object) continue
+      const names = exportsOf(checkout, target.file)
+      for (const { name } of object.keys) {
+        if (name === '__esModule') continue
+        if (!names.has(name)) problems.push(`${file}: jest.${method}('${spec}') mocks ${name}, which ${target.file} does not export`)
+      }
+    }
+  }
+  return verdict(problems, `${mocks} mock paths in ${tests.length} test files (${packages} package mocks' keys not checked)`)
+})
diff --git a/.refactor/tools/gate-4b.mjs b/.refactor/tools/gate-4b.mjs
new file mode 100644
index 0000000..8af6a40
--- /dev/null
+++ b/.refactor/tools/gate-4b.mjs
@@ -0,0 +1,63 @@
+// Gate 4b, mocks that leave a name out (round.md §3.4, SA F8): for a jest.mock factory with no
+// spread (no requireActual), every value name a module in the test's closure imports from the
+// mocked module is a key of the factory (else it is `undefined` there: NaN timers, B20). The
+// closure starts at the test and goes through value imports, not into a module a factory
+// replaces. Base cases are allowlisted in gate4b.allow: `<test at base>\t<mocked module at
+// base>\t<name>\t<reason>`, matched with paths followed; a new case fails.
+import {
+  closure,
+  factoryObject,
+  gate,
+  importsOf,
+  isTestFile,
+  jestCalls,
+  readAllow,
+  verdict,
+} from './gate-lib.mjs'
+
+gate('4b', checkout => {
+  const problems = []
+  const notes = []
+  const allow = new Set(readAllow('gate4b.allow').map(([test, module, name]) => `${test}\0${module}\0${name}`))
+  const used = new Set()
+  const tests = checkout.files.filter(file => file.startsWith('src/') && isTestFile(file) && /\.[jt]sx?$/.test(file))
+  let checked = 0
+  for (const file of tests) {
+    const sf = checkout.parse(file)
+    const replaced = new Map()
+    for (const { method, spec, factory } of jestCalls(sf)) {
+      if (method !== 'mock' && method !== 'doMock') continue
+      const target = checkout.resolver.resolve(spec, file).file
+      if (!target) continue
+      const object = factoryObject(factory)
+      if (factory && (!object || !object.spread)) replaced.set(target, { spec, object })
+    }
+    if (replaced.size === 0) continue
+    const reach = closure(checkout, [file], module => replaced.has(module) && module !== file)
+    for (const module of reach.files) {
+      if (replaced.has(module) || !/\.(ts|tsx)$/.test(module)) continue
+      for (const edge of importsOf(checkout.parse(module))) {
+        if (edge.typeOnly) continue
+        const target = checkout.resolver.resolve(edge.spec, module).file
+        const mock = target && replaced.get(target)
+        if (!mock?.object) continue
+        const keys = new Set(mock.object.keys.map(key => key.name))
+        for (const { imported } of edge.names) {
+          if (imported === '*') continue
+          checked += 1
+          if (keys.has(imported)) continue
+          const key = `${checkout.base(file) ?? file}\0${checkout.base(target) ?? target}\0${imported}`
+          if (allow.has(key)) {
+            used.add(key)
+            continue
+          }
+          problems.push(`${file}: its mock of '${mock.spec}' (${target}) leaves out ${imported}, which ${module} imports`)
+        }
+      }
+    }
+  }
+  for (const key of allow) {
+    if (!used.has(key)) notes.push(`note gate4b.allow row no longer needed: ${key.split('\0').join(' ')}`)
+  }
+  return verdict(problems, `${checked} imported names checked against full mocks`, notes)
+})
diff --git a/.refactor/tools/gate-5.mjs b/.refactor/tools/gate-5.mjs
new file mode 100644
index 0000000..d7051b9
--- /dev/null
+++ b/.refactor/tools/gate-5.mjs
@@ -0,0 +1,58 @@
+// Gate 5, overridden constants (round.md §3.4): the five overrides a test makes by jest.mock still
+// bite. For each, the test (path followed) still mocks a module with the name as a key; that module
+// declares the name itself; some module in the test's closure imports the name from it; and no
+// other module in the closure declares the name at its top level (a copy the mock would miss).
+import { closure, factoryObject, gate, importsOf, jestCalls, topLevelNames, verdict } from './gate-lib.mjs'
+
+const OVERRIDES = [
+  ['src/components/character-sheet/effect-controls.test.tsx', 'EFFECT_SETTLE'],
+  ['src/components/character-sheet/wild-shape.test.tsx', 'WILD_SHAPE_SETTLE'],
+  ['src/components/cookbook-card/cookbook-dish-list.test.tsx', 'DISH_ATTEMPTS'],
+  ['src/app/api/cookbook/dishes/route.test.ts', 'MOST_DISHES_WAITING'],
+  ['src/hooks/use-sheet-roller.elven-off.test.tsx', 'ELVEN_LINE'],
+]
+
+gate('5', checkout => {
+  const problems = []
+  const notes = []
+  for (const [baseTest, name] of OVERRIDES) {
+    const test = checkout.head(baseTest)
+    if (!test) {
+      problems.push(`${baseTest}: gone`)
+      continue
+    }
+    const mock = jestCalls(checkout.parse(test)).find(
+      call => call.method === 'mock' && factoryObject(call.factory)?.keys.some(key => key.name === name),
+    )
+    if (!mock) {
+      problems.push(`${test}: no jest.mock overrides ${name} any more`)
+      continue
+    }
+    const module = checkout.resolver.resolve(mock.spec, test).file
+    if (!module) {
+      problems.push(`${test}: '${mock.spec}' resolves to no module`)
+      continue
+    }
+    if (!topLevelNames(checkout.parse(module)).has(name)) {
+      problems.push(`${test}: ${module} does not declare ${name} itself`)
+      continue
+    }
+    const reach = closure(checkout, [test])
+    const readers = []
+    for (const file of reach.files) {
+      if (file === module || file === test || !/\.(ts|tsx)$/.test(file)) continue
+      const sf = checkout.parse(file)
+      if (topLevelNames(sf).has(name)) problems.push(`${test}: ${file} declares its own ${name}, which the mock misses`)
+      const reads = importsOf(sf).some(
+        edge =>
+          !edge.typeOnly &&
+          checkout.resolver.resolve(edge.spec, file).file === module &&
+          edge.names.some(n => n.imported === name),
+      )
+      if (reads) readers.push(file)
+    }
+    if (readers.length === 0) problems.push(`${test}: nothing it imports reads ${name} from ${module}`)
+    else notes.push(`${test}: ${name} from ${module}, read by ${readers.sort().join(', ')}`)
+  }
+  return verdict(problems, `${OVERRIDES.length} overrides`, notes)
+})
diff --git a/.refactor/tools/gate-6.mjs b/.refactor/tools/gate-6.mjs
new file mode 100644
index 0000000..cfcfa46
--- /dev/null
+++ b/.refactor/tools/gate-6.mjs
@@ -0,0 +1,112 @@
+// Gate 6, framework exports (round.md §3.4, SA F11): per route.ts, page.tsx, layout.tsx,
+// not-found.tsx and manifest.ts the exported value names equal the base's (framework-exports.txt,
+// made from 24f808b: `node gate-6.mjs --baseline <checkout at the base>`), with metadata, viewport
+// and generateMetadata; no framework file appears or goes; the two 'use server' modules export the
+// same 15 names, each an async function, and no other 'use server' file appears.
+import fs from 'node:fs'
+import path from 'node:path'
+import ts from 'typescript'
+import {
+  Checkout,
+  FRAMEWORK_FILE,
+  TOOLS,
+  directiveOf,
+  gate,
+  isSource,
+  isTestFile,
+  readTsv,
+  verdict,
+} from './gate-lib.mjs'
+
+const BASELINE = path.join(TOOLS, 'framework-exports.txt')
+
+const hasModifier = (node, kind) => ts.getModifiers?.(node)?.some(m => m.kind === kind) ?? false
+
+// A module's exported value names (types left out); for each, whether it is an async function.
+function valueExports(sf) {
+  const names = new Map()
+  for (const statement of sf.statements) {
+    if (ts.isExportAssignment(statement)) names.set('default', false)
+    else if (ts.isExportDeclaration(statement)) {
+      if (statement.isTypeOnly || !statement.exportClause || ts.isNamespaceExport(statement.exportClause)) continue
+      for (const element of statement.exportClause.elements) {
+        if (!element.isTypeOnly) names.set(element.name.text, false)
+      }
+    } else if (hasModifier(statement, ts.SyntaxKind.ExportKeyword)) {
+      if (ts.isTypeAliasDeclaration(statement) || ts.isInterfaceDeclaration(statement)) continue
+      const isDefault = hasModifier(statement, ts.SyntaxKind.DefaultKeyword)
+      if (ts.isFunctionDeclaration(statement)) {
+        names.set(isDefault ? 'default' : statement.name.text, hasModifier(statement, ts.SyntaxKind.AsyncKeyword))
+      } else if (ts.isVariableStatement(statement)) {
+        for (const declaration of statement.declarationList.declarations) {
+          const init = declaration.initializer
+          const async =
+            init !== undefined &&
+            (ts.isArrowFunction(init) || ts.isFunctionExpression(init)) &&
+            hasModifier(init, ts.SyntaxKind.AsyncKeyword)
+          if (ts.isIdentifier(declaration.name)) names.set(declaration.name.text, async)
+        }
+      } else if (statement.name) names.set(isDefault ? 'default' : statement.name.text, false)
+    }
+  }
+  return names
+}
+
+const frameworkFiles = checkout =>
+  checkout.files.filter(
+    file =>
+      file.startsWith('src/app/') &&
+      isSource(file) &&
+      !isTestFile(file) &&
+      (FRAMEWORK_FILE.test(file) || directiveOf(checkout.parse(file)) === 'use server'),
+  )
+
+if (process.argv[2] === '--baseline') {
+  const checkout = new Checkout(path.resolve(process.argv[3]), '/tmp')
+  const rows = frameworkFiles(checkout).map(file => {
+    const sf = checkout.parse(file)
+    const directive = directiveOf(sf) === 'use server' ? 'use server' : '-'
+    return [file, directive, [...valueExports(sf).keys()].sort().join(',')].join('\t')
+  })
+  fs.writeFileSync(
+    BASELINE,
+    '# Gate 6\'s baseline: the framework files of 24f808b (pages, layouts, not-found, manifest, routes, the\n' +
+      "# 'use server' actions), each with its directive and its exported value names (W-a, Phase 1).\n" +
+      rows.join('\n') +
+      '\n',
+  )
+  process.stdout.write(`${rows.length} framework files\n`)
+  process.exit(0)
+}
+
+gate('6', checkout => {
+  const problems = []
+  const baseline = readTsv(BASELINE)
+  if (baseline.length === 0) throw new Error(`no ${BASELINE}`)
+  const seen = new Set()
+  let actions = 0
+  for (const [baseFile, directive, list] of baseline) {
+    const file = checkout.head(baseFile)
+    if (!file) {
+      problems.push(`${baseFile}: gone`)
+      continue
+    }
+    seen.add(file)
+    const sf = checkout.parse(file)
+    const names = valueExports(sf)
+    const now = [...names.keys()].sort().join(',')
+    if (now !== list) problems.push(`${file}: exports ${now || '(none)'}, the base ${list || '(none)'}`)
+    const isServer = directiveOf(sf) === 'use server'
+    if (isServer !== (directive === 'use server')) problems.push(`${file}: 'use server' ${isServer ? 'gained' : 'lost'}`)
+    if (directive === 'use server') {
+      for (const [name, async] of names) {
+        actions += 1
+        if (!async) problems.push(`${file}: ${name} is not an async function`)
+      }
+    }
+  }
+  for (const file of frameworkFiles(checkout)) {
+    if (!seen.has(file)) problems.push(`${file}: a framework or 'use server' file the base did not have`)
+  }
+  return verdict(problems, `${baseline.length} framework files, ${actions} actions`)
+})
diff --git a/.refactor/tools/gate-7.mjs b/.refactor/tools/gate-7.mjs
new file mode 100644
index 0000000..0abb134
--- /dev/null
+++ b/.refactor/tools/gate-7.mjs
@@ -0,0 +1,48 @@
+// Gate 7, shims (round.md §3.4, SA F2): no `v0.43-shim` comment; no re-export-only module (only
+// `export … from` statements) but the base's barrels, which commit 5 deletes; and no `export … from`
+// of a name that moved after 24f808b (moves.tsv `name` rows), a re-export a move left behind;
+// except files in shims.allow (`path<TAB>reason`; expected empty, and empty again after commit 23).
+import ts from 'typescript'
+import { gate, isSource, movedNames, readAllow, verdict } from './gate-lib.mjs'
+
+gate('7', checkout => {
+  const problems = []
+  const allowed = new Set(readAllow('shims.allow').map(([file]) => file))
+  const moved = movedNames()
+  const files = checkout.files.filter(file => file.startsWith('src/') && isSource(file))
+  const baseOnly = file => {
+    const base = checkout.base(file)
+    if (!base) return false
+    const text = checkout.baseText(base)
+    return text !== undefined && reexportOnly(ts.createSourceFile(base, text, ts.ScriptTarget.Latest, true))
+  }
+  let barrels = 0
+  for (const file of files) {
+    if (allowed.has(file)) continue
+    const text = checkout.text(file)
+    if (text.includes('v0.43-shim')) problems.push(`${file}: a v0.43-shim comment`)
+    const sf = checkout.parse(file)
+    if (reexportOnly(sf)) {
+      if (baseOnly(file)) barrels += 1
+      else problems.push(`${file}: a module of re-exports only`)
+    }
+    for (const statement of sf.statements) {
+      if (!ts.isExportDeclaration(statement) || !statement.moduleSpecifier) continue
+      const clause = statement.exportClause
+      if (!clause || ts.isNamespaceExport(clause)) continue
+      for (const element of clause.elements) {
+        const name = (element.propertyName ?? element.name).text
+        if (moved.has(name)) problems.push(`${file}: re-exports ${name}, a name that moved`)
+      }
+    }
+  }
+  return verdict(problems, `${files.length} modules; ${barrels} base barrels left; ${moved.size} moved names`)
+})
+
+function reexportOnly(sf) {
+  const statements = sf.statements
+  return (
+    statements.length > 0 &&
+    statements.every(s => ts.isExportDeclaration(s) && s.moduleSpecifier !== undefined)
+  )
+}
diff --git a/.refactor/tools/gate-8.mjs b/.refactor/tools/gate-8.mjs
new file mode 100644
index 0000000..edd72bf
--- /dev/null
+++ b/.refactor/tools/gate-8.mjs
@@ -0,0 +1,38 @@
+// Gate 8, prisma (round.md §3.4, R3.4), from commit 2 (once the node kit, test-utils-node.ts, is
+// in the checkout): each of the 25 route suites that use no prismaMock
+// (R/analysis/T/route-suites.txt, "noprisma") calls guardNoDb() at its top level, and passed.
+import fs from 'node:fs'
+import path from 'node:path'
+import ts from 'typescript'
+import { ANALYSIS, gate, notApplicable, verdict } from './gate-lib.mjs'
+
+gate('8', checkout => {
+  if (!checkout.exists('src/utils/test-utils-node.ts')) return notApplicable('no node kit yet (commit 2)')
+  const list = fs
+    .readFileSync(path.join(ANALYSIS, 'T/route-suites.txt'), 'utf8')
+    .split('\n')
+    .filter(line => line.startsWith('noprisma '))
+    .map(line => line.split(' ')[2])
+  const problems = []
+  const status = new Map(checkout.jest.suites.map(suite => [suite.file, suite.status]))
+  for (const baseFile of list) {
+    const file = checkout.head(baseFile)
+    if (!file) {
+      problems.push(`${baseFile}: gone`)
+      continue
+    }
+    const guarded = checkout
+      .parse(file)
+      .statements.some(
+        s =>
+          ts.isExpressionStatement(s) &&
+          ts.isCallExpression(s.expression) &&
+          ts.isIdentifier(s.expression.expression) &&
+          s.expression.expression.text === 'guardNoDb',
+      )
+    if (!guarded) problems.push(`${file}: no guardNoDb()`)
+    if (status.get(file) !== 'passed') problems.push(`${file}: ${status.get(file) ?? 'not run'}`)
+  }
+  if (list.length !== 25) problems.push(`route-suites.txt names ${list.length} noprisma suites, not 25`)
+  return verdict(problems, `${list.length} suites`)
+})
diff --git a/.refactor/tools/gate-9.mjs b/.refactor/tools/gate-9.mjs
new file mode 100644
index 0000000..273f7fa
--- /dev/null
+++ b/.refactor/tools/gate-9.mjs
@@ -0,0 +1,66 @@
+// Gate 9, the lint ratchet (round.md §3.4): `eslint -f json` warnings per (unit, rule) and, for
+// no-restricted-syntax, per (unit, check) ≤ the ratchet's, the unit being src/features/<feature>
+// and otherwise src/<top folder> (the repo's top folder outside src); errors stay 0. The ratchet
+// is R/analysis/ratchet-base.json (commit 1) until src/features exists (commit 5), then
+// R/analysis/ratchet-moved.json (taken after commit 5 under these conditions).
+import fs from 'node:fs'
+import path from 'node:path'
+import { syntaxCheck } from '../analysis/metrics/lint.mjs'
+import { ANALYSIS, gate, verdict } from './gate-lib.mjs'
+
+function unitOf(file) {
+  const parts = file.split('/')
+  if (parts[0] !== 'src') return parts.length > 1 ? parts[0] : '(root)'
+  if (parts[1] === 'features' && parts.length > 3) return `src/features/${parts[2]}`
+  return parts.length > 2 ? `src/${parts[1]}` : 'src'
+}
+
+gate('9', checkout => {
+  const moved = checkout.has('src/features') || checkout.files.some(file => file.startsWith('src/features/'))
+  const name = moved ? 'ratchet-moved.json' : 'ratchet-base.json'
+  const ratchetFile = path.join(ANALYSIS, name)
+  if (!fs.existsSync(ratchetFile)) return verdict([`no ${ratchetFile} (taken after commit 5)`], name)
+  const ratchet = JSON.parse(fs.readFileSync(ratchetFile, 'utf8'))
+  const lint = JSON.parse(fs.readFileSync(path.join(checkout.outdir, 'eslint.json'), 'utf8'))
+  const byUnit = new Map()
+  const byCheck = new Map()
+  let errors = 0
+  let warnings = 0
+  const add = (map, unit, key) => {
+    if (!map.has(unit)) map.set(unit, new Map())
+    map.get(unit).set(key, (map.get(unit).get(key) ?? 0) + 1)
+  }
+  for (const result of lint) {
+    const file = path.relative(checkout.root, result.filePath)
+    errors += result.errorCount
+    for (const message of result.messages) {
+      if (message.severity === 2) continue
+      warnings += 1
+      const rule = message.ruleId ?? '(no rule)'
+      add(byUnit, unitOf(file), rule)
+      if (rule === 'no-restricted-syntax') add(byCheck, unitOf(file), syntaxCheck(message.message))
+    }
+  }
+  const problems = []
+  if (errors > 0) {
+    const where = lint
+      .filter(r => r.errorCount > 0)
+      .flatMap(r =>
+        r.messages
+          .filter(m => m.severity === 2)
+          .map(m => `${path.relative(checkout.root, r.filePath)}:${m.line} ${m.ruleId}: ${m.message}`),
+      )
+    problems.push(`${errors} lint error(s): ${where.slice(0, 20).join(' | ')}`)
+  }
+  const compare = (now, then, what) => {
