From f3c0010d1f80b178eb565807215904334a314ba2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 20:14:16 +0000
Subject: [PATCH 2/3] fix(sheet): the pane's panel types its layout by
 ActionsLayout, not the layouts' constants

sheet-panel.tsx typed its `layout` prop with `Layout` from actions-layout/constants.ts, an
import the pane did not have before commit 17. That module is the U2 lane's, whose types are
leaving constants.ts for actions-layout/types.ts in this phase (rule (b)), so the prop is typed as
`ActionsLayout['layout']` from actions-layout/types.ts, a name both trees keep. Type-only: no
emitted code changes.

L1 on this tree: see the U1 report (jest, typegen, tsc, eslint, gates 1-12).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01821Sr9FKASxJn47SNudpbR
---
 src/features/sheet/components/character-pane/sheet-panel.tsx | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/features/sheet/components/character-pane/sheet-panel.tsx b/src/features/sheet/components/character-pane/sheet-panel.tsx
index ab80214..a8f4f82 100644
--- a/src/features/sheet/components/character-pane/sheet-panel.tsx
+++ b/src/features/sheet/components/character-pane/sheet-panel.tsx
@@ -10,7 +10,7 @@ import { InventoryTab } from '../inventory-tab/inventory-tab'
 import { SpellsTab } from '../spells-tab/spells-tab'
 import { Scroller } from '@/components/scroller/scroller'
 import type { PaneActions, SheetTab } from './types'
-import type { Layout } from '../actions-layout/constants'
+import type { ActionsLayout } from '../actions-layout/types'
 import type { PartySheets } from '../party-sheets/types'
 import type { NotesPlace } from '@/features/notes/types'
 import type { TransferControls } from '@/features/transfers/types'
@@ -56,7 +56,7 @@ export function SheetPanel({
   notes?: NotesPlace
   parties?: PartySheets
   transfers: TransferControls
-  layout: Layout
+  layout: ActionsLayout['layout']
   actions: PaneActions
   onShowConditions: (id: string) => void
 }>) {
