index 0000000..31059ef
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-description-links.ts
@@ -0,0 +1,90 @@
+import { sheetTools } from '../description-actions/utils'
+import { blockedReason } from './utils'
+import type { Command, PaneRoller, PaneTable, UnlessLocked } from './types'
+import type { ShowConditions } from '../conditions/types'
+import type { DescriptionActions } from '../description-actions/types'
+import type { RollKind, SheetRoll } from '@/types/roll'
+import type { SeatRole } from '@/types/seats'
+import type { TableSheet } from '@/types/table'
+
+/**
+ * What the links in descriptions do, on every tab, favorite and dialog: each roll they make, and
+ * the table asked, shows in the tray, whichever tab it's on (`described`); nothing rolls once the
+ * pane's rolls are locked.
+ * @param onRoll - A roll as the pane makes it, an attack picked at first.
+ * @param rollsToTable - The rolls the game takes now.
+ */
+export function useDescriptionLinks({
+  table,
+  roller: { rollDamage, rollFormula, logAsk },
+  onRoll,
+  sheet,
+  role,
+  rollsToTable,
+  setDescribed,
+  unlessLocked,
+  command,
+  showConditions,
+}: Readonly<{
+  table: PaneTable
+  roller: Pick<PaneRoller, 'rollDamage' | 'rollFormula' | 'logAsk'>
+  onRoll: (request: SheetRoll) => void
+  sheet: TableSheet
+  role: SeatRole
+  rollsToTable?: RollKind[]
+  setDescribed: (described: boolean) => void
+  unlessLocked: UnlessLocked
+  command: Command
+  showConditions: ShowConditions
+}>): DescriptionActions {
+  return {
+    roll: unlessLocked(request => {
+      setDescribed(true)
+      onRoll(request)
+    }),
+    rollDamage: unlessLocked(request => {
+      setDescribed(true)
+      void rollDamage(request)
+    }),
+    rollFormula: unlessLocked(request => {
+      setDescribed(true)
+      void rollFormula(request)
+    }),
+    takes: table.takes,
+    // A description's damage at the table: changed, where the game takes it so, which it does
+    // only from module 0.19.0, whose sheets say how it makes a critical hit's, and on its first
+    // die whatever its sign before module 0.21.0; and as one, where they say how.
+    ...(table.takes('textDamage') && {
+      damage: {
+        modifies: table.modifiesText && sheet.critical !== undefined,
+        signed: table.signsText,
+        ...(sheet.critical && { critical: sheet.critical }),
+      },
+    }),
+    ask: unlessLocked(({ label, text, link }) => {
+      if (!table.takes('ask')) return
+      setDescribed(true)
+      command(
+        () => logAsk(label),
+        logged => table.sendAsk(logged, { text, link }),
+        { acts: false },
+      )
+    }),
+    askBlocked: blockedReason('ask', table, role, rollsToTable),
+    useBlocked: blockedReason('use', table, role, rollsToTable),
+    // Where only this device's switch keeps the table from being asked, a way to turn it on, as
+    // the switch in the sheet's settings is a step away.
+    ...(table.available &&
+      !table.sending &&
+      rollsToTable?.includes('ask') && {
+        sendRolls: () => table.setSending(true),
+      }),
+    abilities: sheet.abilities,
+    skills: sheet.skills,
+    tools: sheetTools(sheet),
+    proficiency: sheet.proficiency,
+    conditions: sheet.conditions,
+    rules: sheet.rules,
+    showConditions,
+  }
+}
diff --git a/src/features/sheet/components/character-pane/use-due-damage.ts b/src/features/sheet/components/character-pane/use-due-damage.ts
new file mode 100644
index 0000000..3338ba1
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-due-damage.ts
@@ -0,0 +1,77 @@
+import { useEffect, useRef, type RefObject } from 'react'
+import { choicesOf, damageRollOf } from '@/features/rolling/utils/damage-due'
+import type { PaneRoller, PaneTable, UnlessLocked } from './types'
+import type { DueDamage, RollDue } from '@/features/rolling/types'
+import type { DamageModifiers, SheetDamageRoll } from '@/types/roll'
+
+/**
+ * An attack's or a use's damage, while the game waits for it, rolled for the game, as the game
+ * said, as the kind of damage chosen, if any, and changed as the player chose, if they did
+ * (`rollDue`); and a damage roll as a row asks for it (`onRollDamage`). A use's damage or healing
+ * is rolled as soon as the game says it's due, once; unless its kind is to be chosen first, in the
+ * tray; or, while the player types in their own dice, offered there for them to roll it, rather
+ * than asking for their dice by itself; and so too while the pane isn't the one shown (module
+ * 0.36.0), whose dice would land over another's, or while its rolls are locked, as a gone
+ * companion's are, whose use made before it went may still come back with its damage. Either way
+ * only once, so that turning typing off after, or showing the pane, never rolls it by itself.
+ */
+export function useDueDamage({
+  table,
+  rollDamage,
+  unlessLocked,
+  lockedNow,
+  typing,
+  paneShown,
+}: Readonly<{
+  table: PaneTable
+  rollDamage: PaneRoller['rollDamage']
+  unlessLocked: UnlessLocked
+  lockedNow: RefObject<boolean>
+  typing: boolean
+  paneShown: boolean
+}>) {
+  const rollDue: RollDue = unlessLocked(
+    (
+      name: string,
+      due: DueDamage,
+      type?: string,
+      modifiers?: DamageModifiers,
+    ) => {
+      void rollDamage(damageRollOf(name, due, type, modifiers ?? due.modifiers))
+    },
+  )
+  const rolledFor = useRef(new Set<string>())
+  const { offerDamage } = table
+  useEffect(() => {
+    for (const [id, state] of table.states) {
+      const { name, requestId, damage } = state
+      if (!name || state.status !== 'done' || !requestId || !damage) continue
+      if (state.damaged || rolledFor.current.has(requestId)) continue
+      if (choicesOf(damage).length > 0) continue
+      rolledFor.current.add(requestId)
+      if (typing || !paneShown || lockedNow.current) {
+        offerDamage(id)
+        continue
+      }
+      const { modifiers } = state
+      void rollDamage(damageRollOf(name, { use: requestId, damage, modifiers }))
+    }
+  }, [table.states, rollDamage, typing, paneShown, offerDamage, lockedNow])
+  const onRollDamage = unlessLocked((request: SheetDamageRoll) => {
+    const due = request.source && table.dueFor(request.source)
+    if (due) {
+      rollDue(
+        request.label.replace(/ (damage|healing)$/, ''),
+        due,
+        undefined,
+        request.modifiers,
+      )
+      return
+    }
+    // Damage on its own, from module 0.36.0, is rolled as its row gave it: its dice the game's
+    // plan, a critical hit's where chosen, as the kind chosen; sent as such, unless the switch went
+    // off since, when it's the player's alone. Any other is rolled here, as ever.
+    void rollDamage(request)
+  })
+  return { rollDue, onRollDamage }
+}
diff --git a/src/features/sheet/components/character-pane/use-favorites-layout.ts b/src/features/sheet/components/character-pane/use-favorites-layout.ts
