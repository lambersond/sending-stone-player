@@ -0,0 +1,65 @@
+import { useMemo } from 'react'
+import { useGiveControls } from '@/features/transfers/hooks/use-give-controls'
+import { useRemoveControls } from '@/features/transfers/hooks/use-remove-controls'
+import type { PaneTable } from './types'
+import type { TableMoves } from '@/types/party'
+import type { LocalMove, LocalUse } from '@/types/roll'
+import type { SeatRole } from '@/types/seats'
+import type { TableSheet } from '@/types/table'
+
+/**
+ * Give and Remove…, on the Inventory tab: Send to…, from module 0.31.0, its dialog held here, so
+ * that it outlives the row it was opened from, and the controls going, as when the game stops
+ * taking moves; and Remove…, from module 0.33.0, beside it, with moves off too. Neither while the
+ * character is transformed (`shaped`), whose gear isn't on.
+ */
+export function useGiveRemove({
+  moves,
+  removes,
+  shaped,
+  sheet,
+  table,
+  role,
+  name,
+  actorId,
+  logMove,
+  setActed,
+}: Readonly<{
+  moves?: TableMoves
+  removes?: boolean
+  shaped: boolean
+  sheet: TableSheet
+  table: PaneTable
+  role: SeatRole
+  name: string
+  actorId?: string
+  logMove: (move: LocalMove) => LocalUse
+  setActed: (acted: boolean) => void
+}>) {
+  const giving = useGiveControls({
+    moves: shaped ? undefined : moves,
+    table,
+    role,
+    name,
+    actorId,
+    logMove,
+    setActed,
+  })
+  const removing = useRemoveControls({
+    removes: removes === true && !shaped,
+    inventory: sheet.inventory,
+    table,
+    role,
+    name,
+    logMove,
+    setActed,
+  })
+  const transfers = useMemo(
+    () =>
+      removing.remove
+        ? { ...giving.controls, remove: removing.remove }
+        : giving.controls,
+    [giving.controls, removing.remove],
+  )
+  return { giving, removing, transfers }
+}
diff --git a/src/features/sheet/components/character-pane/use-pane-commands.ts b/src/features/sheet/components/character-pane/use-pane-commands.ts
new file mode 100644
index 0000000..10d0567
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-pane-commands.ts
@@ -0,0 +1,185 @@
+import { useCallback } from 'react'
+import { useSlotWaits } from './use-slot-waits'
+import { slotName } from '@/features/sheet/utils/slot-words'
+import { capitalized } from '@/utils/wild-shape-words'
+import type { Command, PaneRoller, PaneTable } from './types'
+import type { ChargeActions } from '../charging/types'
+import type { ConcentrationActions } from '../concentration/types'
+import type { EnchantActions } from '../enchantments/types'
+import type { Belonging } from '@/features/sheet/types'
+import type {
+  FavoriteTarget,
+  WildShapeInput,
+  WildShapeLogged,
+} from '@/types/roll'
+import type {
+  EffectOp,
+  PrepareOp,
+  SheetEffect,
+  SheetSpell,
+} from '@/types/sending-stone'
+import type { TableSheet } from '@/types/table'
+
+/**
+ * The commands a pane sends the game, each logged among its rolls as it's sent: once one is, the
+ * tray shows its line whichever tab it's on (`acted`), but for Heroic Inspiration and an
+ * enchantment's end, which never did. Each is the same steps: the tray told, its line logged, the
+ * line sent, its local id returned.
+ */
+export function usePaneCommands({
+  table,
+  roller,
+  sheet,
+  shaped,
+  belongings,
+  setActed,
+}: Readonly<{
+  table: PaneTable
+  roller: PaneRoller
+  sheet: TableSheet
+  /** Whether the character is transformed, as by Wild Shape, whose slots wait then. */
+  shaped: boolean
+  /** What the character has that an enchantment may be put on. */
+  belongings: ReadonlyMap<string, Belonging>
+  setActed: (acted: boolean) => void
+}>) {
+  const command = useCallback<Command>(
+    (log, send, { acts = true } = {}) => {
+      if (acts) setActed(true)
+      const logged = log()
+      send(logged)
+      return logged.id
+    },
+    [setActed],
+  )
+  const {
+    logFavorite,
+    logPrepare,
+    logEffect,
+    logWildShape,
+    logEnd,
+    logCharge,
+  } = roller
+  // Favorites added and removed from a row's menu, from module 0.37.0: a line among the rolls says
+  // how it went, on whichever tab it was chosen, Effects among them.
+  const { sendFavorite, sendPrepare, sendEffect, sendWildShape } = table
+  const favoriteOf = useCallback(
+    (target: FavoriteTarget, op: 'add' | 'remove', label: string) =>
+      command(
+        () => logFavorite(label, op),
+        logged => sendFavorite(logged, { ...target, op }),
+      ),
+    [command, logFavorite, sendFavorite],
+  )
+  // The character's spells prepared and unprepared from a row's menu, from module 0.42.1: a line
+  // among the rolls says how it went, as for a favorite.
+  const prepareOf = useCallback(
+    (spell: SheetSpell, op: PrepareOp) =>
+      command(
+        () => logPrepare(spell.name, op),
+        logged => sendPrepare(logged, { op, id: spell.id }),
+      ),
+    [command, logPrepare, sendPrepare],
+  )
+  // The character's own effects turned off, on and deleted, from module 0.39.0: a line among the
+  // rolls says how it went, as for a favorite; from 0.42.1, one a roll made, beneath it.
+  const effectOf = useCallback(
+    (effect: SheetEffect, op: EffectOp, at?: number) =>
+      command(
+        () => logEffect(effect.name, op, at),
+        logged => sendEffect(logged, effect),
+      ),
+    [command, logEffect, sendEffect],
+  )
+  // Wild Shape from here, from module 0.40.0: a line among the rolls says how each went, on
+  // whichever tab.
+  const wildShapeOf = useCallback(
+    (
+      input: Exclude<WildShapeInput, { op: 'forms' }>,
+      logged: WildShapeLogged,
+    ) =>
+      command(
+        () => logWildShape(logged),
+        line => sendWildShape(line, input),
+      ),
+    [command, logWildShape, sendWildShape],
+  )
+  // Enchantments on the character's items, ended as dnd5e's chat card ends them, while the game
+  // takes it, each item named as the sheet lists it; and each enchant activity's latest use, which
+  // its switch follows.
+  const enchanting: EnchantActions = {
+    latestFor: table.latestFor,
+    belongings,
+    ...(table.takes('endEnchantment') && {
+      end: (item, { id, name: ended }, source) =>
+        command(
+          () => logEnd(ended),
+          logged => table.sendEnd(logged, { item, effect: id }, source),
+          { acts: false },
+        ),
+    }),
+  }
+  // The character's concentrations, each ended as dnd5e's Break Concentration ends it, while the
+  // game takes it from here, as it never does from the Gamemaster's page, where it would leave no
+  // mark; nothing goes to the game's chat.
+  const concentrating: ConcentrationActions = {
+    effects: sheet.concentration?.effects,
+    ...(table.takes('endConcentration') && {
+      end: ({ id, name: on }) => {
+        command(
+          () => logEnd(`Concentration on ${on}`),
+          logged => table.sendEndConcentration(logged, id),
+        )
+      },
+    }),
+  }
+  // From module 0.42.1, one of the character's spell slots spent or restored from the dots, while
+  // the game takes it from here, never while transformed, as the slots wait then: a line among the
+  // rolls says how it went, on whichever tab, and each pool waits for the game once one is sent.
+  const slotWaits = useSlotWaits(table.states, sheet.spells)
+  // A counter's charges spent directly, and Heroic Inspiration used or gained, while the game takes
+  // them from here: each posts a line in the game's chat, the Gamemaster's marked as theirs.
+  const charging: ChargeActions = {
+    ...(table.takes('spend') && {
+      spend: (counter, count, counterName) => {
+        command(
+          () => logCharge(counterName, { spent: count }),
+          logged => table.sendSpend(logged, { counter, count }),
+        )
+      },
+    }),
+    ...(table.takes('inspiration') && {
+      inspire: inspiration => {
+        command(
+          () => logCharge('Heroic Inspiration', { inspiration }),
+          logged => table.sendInspiration(logged, inspiration),
+          { acts: false },
+        )
+      },
+    }),
+    ...(table.takes('spellSlot') &&
+      !shaped && {
+        slot: (pool, op, from) => {
+          if (slotWaits.waiting(pool.id)) return
+          command(
+            () => logCharge(capitalized(slotName(pool)), { slot: op }),
+            logged => {
+              table.sendSpellSlot(logged, { op, id: pool.id, from })
+              slotWaits.sent(pool.id, { id: logged.id, op, from })
+            },
+          )
+        },
+        slotWaiting: slotWaits.waiting,
+      }),
+  }
+  return {
+    command,
+    favoriteOf,
+    prepareOf,
+    effectOf,
+    wildShapeOf,
+    enchanting,
+    concentrating,
+    charging,
+  }
+}
diff --git a/src/features/sheet/components/character-pane/use-pane-lock.ts b/src/features/sheet/components/character-pane/use-pane-lock.ts
new file mode 100644
index 0000000..91df5b3
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-pane-lock.ts
@@ -0,0 +1,23 @@
+import { useCallback, useLayoutEffect, useRef } from 'react'
+import type { UnlessLocked } from './types'
+
+/**
+ * Whether a pane's rolls are locked now, as a gone companion's are (module 0.36.0), for what was
+ * opened before it went, such as a description's menu, to roll nothing after: `lockedNow` as it
+ * is at each call, and `unlessLocked`, a call made only while they aren't, checked as it's made.
+ */
+export function usePaneLock(locked: boolean) {
+  const lockedNow = useRef(locked)
+  useLayoutEffect(() => {
+    lockedNow.current = locked
+  }, [locked])
+  const unlessLocked = useCallback<UnlessLocked>(
+    run =>
+      (...args) => {
+        if (lockedNow.current) return
+        run(...args)
+      },
+    [],
+  )
+  return { lockedNow, unlessLocked }
+}
diff --git a/src/features/sheet/components/character-pane/use-pane-status.ts b/src/features/sheet/components/character-pane/use-pane-status.ts
new file mode 100644
index 0000000..dc74802
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-pane-status.ts
@@ -0,0 +1,52 @@
+import { useEffect, useMemo } from 'react'
+import { SETTLED } from '@/constants/lifecycle'
+import { useGmRolls } from '@/features/rolling/hooks/use-gm-rolls'
+import { needsPlayer } from '@/features/rolling/utils/damage-due'
+import { withGmRolls } from '@/features/rolling/utils/gm-rolls'
+import type { PaneRoller, PaneTable } from './types'
+import type { GmRollView } from '@/types/roll'
+import type { TableCombat } from '@/types/table'
+
+/**
+ * The pane's rolls as shown (`shown`): the Gamemaster's rolls as the character (#156) among the
+ * player's own, wherever they're shown, with nothing to roll after them; their area attacks'
+ * targets named as this page's own combat names them, which never holds one hidden from players.
+ * Where several panes share the Character pane (module 0.36.0), it says whether any of its rolls
+ * waits for its player, as damage to roll, which its tab marks while it's hidden (`onPending`);
+ * and whether any is still on its way to the game, while the page must keep it mounted, so as not
+ * to lose it (`onBusy`).
+ */
+export function usePaneStatus({
+  rolls,
+  table,
+  gmRolls,
+  combat,
+  onPending,
+  onBusy,
+}: Readonly<{
+  rolls: PaneRoller['rolls']
+  table: PaneTable
+  gmRolls?: GmRollView[]
+  combat?: TableCombat
+  onPending?: (pending: boolean) => void
+  onBusy?: (busy: boolean) => void
+}>) {
+  const fromGm = useGmRolls(gmRolls, combat)
+  const shown = useMemo(
+    () => withGmRolls(rolls, table.states, fromGm),
+    [rolls, table.states, fromGm],
+  )
+  const pending = shown.rolls.some(roll =>
+    needsPlayer(roll, shown.states.get(roll.id)),
+  )
+  const busy = [...table.states.values()].some(
+    ({ status }) => !SETTLED.has(status),
+  )
+  useEffect(() => {
+    onPending?.(pending)
+  }, [pending, onPending])
+  useEffect(() => {
+    onBusy?.(busy)
+  }, [busy, onBusy])
+  return shown
+}
diff --git a/src/features/sheet/components/character-pane/use-picking.ts b/src/features/sheet/components/character-pane/use-picking.ts
new file mode 100644
index 0000000..6f58f38
--- /dev/null
+++ b/src/features/sheet/components/character-pane/use-picking.ts
@@ -0,0 +1,193 @@
+import { useEffect, useMemo, useRef, useState, type RefObject } from 'react'
+import { actionTitle, verbOf } from '../action-entry/utils'
+import { asks, enchantPicks } from '../use-picker/utils'
+import { alonePicked, pickedAttack } from './utils'
+import { isItemCast } from '@/utils/casts'
+import { sheetActions } from '@/utils/sheet-actions'
+import type { PaneRoller, PaneTable, UnlessLocked } from './types'
+import type { AlonePick } from '../action-entry/types'
+import type { Picked, Picking } from '../use-picker/types'
+import type { DamageModifiers } from '@/types/roll'
+import type {
+  CastIndex,
+  FavoriteEntry,
+  SheetAction,
+} from '@/types/sending-stone'
+import type { TableCombat, TableSheet } from '@/types/table'
+
+/**
+ * An attack or a use made at the table, while its player picks whom at, and with what (`picking`,
+ * which the picker shows). One open as the pane's rolls lock, as a companion's that has gone,
+ * closes: nothing it picks is made.
+ */
+export function usePicking({
+  locked,
+  lockedNow,
+  unlessLocked,
+  table,
+  roller: { roll, logUse },
+  sheet,
+  entries,
+  itemCasts,
+  combat,
+}: Readonly<{
+  locked: boolean
+  lockedNow: RefObject<boolean>
+  unlessLocked: UnlessLocked
+  table: PaneTable
+  roller: Pick<PaneRoller, 'roll' | 'logUse'>
+  sheet: TableSheet
+  entries: FavoriteEntry[]
+  itemCasts: CastIndex
+  combat?: TableCombat
+}>) {
+  const [picking, setPicking] = useState<Picking>()
+  if (locked && picking) setPicking(undefined)
+  // Damage on its own whose choices are being picked, from module 0.41.0: how it goes on once
+  // they are, and the chip it was rolled from, which has focus back once the picker closes
+  // without a pick, as it does once the picker's dialog has closed.
+  const aloneGoing = useRef<AlonePick>(undefined)
+  const returnTo = useRef<HTMLElement>(undefined)
+  useEffect(() => {
+    if (picking || !returnTo.current) return
+    if (returnTo.current.isConnected) returnTo.current.focus()
+    returnTo.current = undefined
+  }, [picking])
+  const [lastTarget, setLastTarget] = useState<string>()
+  // An attack or a use opens the picker where there's anything to pick, saying whether it did.
+  const ask = (asking: Picking) => {
+    if (!asks(asking, combat, sheet.spells, itemCasts, table.selfTargets)) {
+      return false
+    }
+    setPicking(asking)
+    return true
+  }
+  const makeUse = (
+    action: SheetAction,
+    chose: Picked,
+    modifiers?: DamageModifiers,
+  ) => {
+    if (!action.activity) return
+    // An enchant activity used without asking is used as dnd5e would use it, in the first way it
+    // may enchant.
+    const picked =
+      action.activity.type === 'enchant' && !chose.enchant
+        ? { ...chose, ...enchantPicks(action, sheet.spells, itemCasts) }
+        : chose
+    const used = logUse(
+      actionTitle(action),
+      verbOf(action) === 'Cast',
+      isItemCast(action),
+    )
+    // A combat that ended while they picked leaves no one to target; its user, as Self, is still
+    // its user, where the game makes a use at them as asked.
+    const self =
+      picked.self === true ||
+      (!combat &&
+        table.selfTargets &&
+        picked.targets.some(({ side }) => side === 'me'))
+    table.sendUse(
+      used,
+      {
+        kind: 'use',
+        item: action.id,
+        activity: action.activity.id,
+        targets: combat
+          ? picked.targets.map(({ id }) => ({
+              combatId: combat.id,
+              combatantId: id,
+            }))
+          : [],
+        ...(self && { self: true as const }),
+        slot: picked.slot,
+        ...(picked.enchant && { enchant: picked.enchant }),
+      },
+      modifiers,
+    )
+  }
+  // Damage on its own's choices, from module 0.41.0, where the game takes them: picked first where
+  // there's anything to ask, as an attack's or a use's are, else it goes on at once.
+  const pickAlone = (pick: AlonePick) => {
+    if (lockedNow.current) return
+    const asking: Picking = {
+      kind: 'alone',
+      action: pick.action,
+      healing: pick.healing,
+      choice: pick.choice,
+    }
+    if (!asks(asking, combat, sheet.spells)) {
+      pick.onPicked({}, { action: pick.action, spells: sheet.spells })
+      return
+    }
+    aloneGoing.current = pick
+    setPicking(asking)
+  }
+  // Damage on its own's row as the sheet has it now, from module 0.41.0: the page's next poll may
+  // change it while its player picks, as a slot the Gamemaster gives brings the plan of that level,
+  // so the picker draws its chips from the row as it is now, and what's picked is rolled from that
+  // row. Where the sheet lists it more than once, the listing it was tapped on, by its name; as it
+  // was, where the sheet no longer plans it.
+  const aloneRow = useMemo(() => {
+    if (picking?.kind !== 'alone') return
+    const { action } = picking
+    const activity = action.attackId ?? action.activity?.id
+    const listed = sheetActions(sheet, entries).filter(
+      each =>
+        each.id === action.id &&
+        (each.attackId ?? each.activity?.id) === activity &&
+        !!each.tableDamage,
+    )
+    return (
+      listed.find(
+        each =>
+          each.name === action.name &&
+          each.activityName === action.activityName,
+      ) ??
+      listed[0] ??
+      action
+    )
+  }, [picking, sheet, entries])
+  const shownPicking: Picking | undefined =
+    picking?.kind === 'alone' && aloneRow
+      ? { ...picking, action: aloneRow }
+      : picking
+  const closePicker = () => {
+    returnTo.current = aloneGoing.current?.anchor
+    aloneGoing.current = undefined
+    setPicking(undefined)
+  }
+  const pick = (picked: Picked) => {
+    const asked = shownPicking
+    const going = aloneGoing.current
+    aloneGoing.current = undefined
+    setPicking(undefined)
+    // Nothing picked at a pane whose rolls have locked since is made (module 0.36.0).
+    if (lockedNow.current) return
+    if (asked?.kind === 'alone') {
+      going?.onPicked(alonePicked(picked), {
+        action: asked.action,
+        spells: sheet.spells,
+      })
+      return
+    }
+    if (asked?.kind === 'use') {
+      makeUse(asked.action, picked, asked.modifiers)
+      return
+    }
+    const source = asked?.request.source
+    if (!asked || source?.kind !== 'attack') return
+    const area = !!table.areas && !!asked.action.attackArea
+    const [combatant] = picked.targets
+    if (!area && combatant) setLastTarget(combatant.id)
+    void roll(pickedAttack(asked, source, picked, combat, area))
+  }
+  return {
+    picking: shownPicking,
+    ask,
+    makeUse,
+    pickAlone,
+    closePicker,
+    pick,
+    lastTarget,
+  }
+}
diff --git a/src/features/sheet/components/character-pane/use-prompt-answers.ts b/src/features/sheet/components/character-pane/use-prompt-answers.ts
