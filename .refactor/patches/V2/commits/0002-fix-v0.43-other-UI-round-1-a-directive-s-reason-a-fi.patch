From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 21:01:00 +0000
Subject: [PATCH 2/2] fix: v0.43 other UI, round 1 (a directive's reason; a
 file-wide disable narrowed)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Commit 20's review (V2-3, V2-4). use-image-fallback.test.tsx's no-img-element
directive gets its reason, as owners.tsv's row and §1.7.2 ask. The
creature-switcher test's file-wide no-this-outside-of-class disable becomes a
disable/enable range around the five layout getter mocks in beforeEach plus
one next-line directive on the focus mock, so no directive covers the whole
file (Q2). Line-level throughout would take nine directives, one per line
that reads `this`; G settles the final shape in commit 23.

Comments only: no statement, expectation or product file changes, and the
two files' eslint findings are the same as before (gate 1b drops comments).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01821Sr9FKASxJn47SNudpbR
---
 .../components/creature-switcher/creature-switcher.test.tsx | 6 ++++--
 src/hooks/use-image-fallback.test.tsx                       | 2 +-
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/features/companions/components/creature-switcher/creature-switcher.test.tsx b/src/features/companions/components/creature-switcher/creature-switcher.test.tsx
index 69966da..7f95cf1 100644
--- a/src/features/companions/components/creature-switcher/creature-switcher.test.tsx
+++ b/src/features/companions/components/creature-switcher/creature-switcher.test.tsx
@@ -1,5 +1,3 @@
-/* eslint-disable unicorn/no-this-outside-of-class --
- * the layout's getters, mocked, read the element they're called on */
 import { useState } from 'react'
 import {
   act,
@@ -61,6 +59,8 @@ let observers: (() => void)[] = []
 beforeEach(() => {
   boxWidth = 1000
   observers = []
+  /* eslint-disable unicorn/no-this-outside-of-class --
+   * the layout's getters, mocked, read the element they're called on */
   jest
     .spyOn(HTMLElement.prototype, 'offsetWidth', 'get')
     .mockImplementation(function (this: HTMLElement) {
@@ -90,6 +90,7 @@ beforeEach(() => {
     .mockImplementation(function (this: Element, value: number) {
       scrolls.set(this, value)
     })
+  /* eslint-enable unicorn/no-this-outside-of-class */
   globalThis.ResizeObserver = jest.fn().mockImplementation(callback => {
     observers.push(() => callback([]))
     return { observe: jest.fn(), unobserve: jest.fn(), disconnect: jest.fn() }
@@ -535,6 +536,7 @@ describe('CreatureSwitcher', () => {
       this: HTMLElement,
       options,
     ) {
+      // eslint-disable-next-line unicorn/no-this-outside-of-class -- the element focused
       if (!this.closest('[hidden]')) focus.call(this, options)
     })
     // As the page has it: the character's panel hidden while the gone tab is chosen, and shown in
diff --git a/src/hooks/use-image-fallback.test.tsx b/src/hooks/use-image-fallback.test.tsx
index 9026cb7..67f9c4b 100644
--- a/src/hooks/use-image-fallback.test.tsx
+++ b/src/hooks/use-image-fallback.test.tsx
@@ -9,7 +9,7 @@ function Picture({ src }: Readonly<{ src?: string | null }>) {
   const fallback = useImageFallback(src)
   given = fallback
   if (!src || !fallback.shown) return <span>fallback</span>
-  // eslint-disable-next-line @next/next/no-img-element
+  // eslint-disable-next-line @next/next/no-img-element -- the plain img the components draw
   return <img ref={fallback.ref} src={src} alt='' onError={fallback.onError} />
 }
 
