+      mode='give'
+      mover={role === 'gm' ? name : 'You'}
+      what={giving.what}
+      recipients={giving.recipients}
+      onMove={({ to, items, currency, words }) => {
+        setActed(true)
+        table.sendTransfer(logMove(words), {
+          from: giving.from,
+          to,
+          ...(items && { items }),
+          ...(currency && { currency }),
+        })
+      }}
+    />
+  )
+}
