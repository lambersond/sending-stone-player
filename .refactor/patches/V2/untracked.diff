@@ -0,0 +1,49 @@
+import type { NoteDraft } from '@/features/notes/types'
+import type { NoteChange, NoteInput } from '@/types/notes'
+
+/** The most heading hints listed one by one, before the rest are counted. */
+const MOST_HINTS = 3
+
+/**
+ * The editor's hint for the lines that would be the journal's own headings, one sentence a line,
+ * at most three, then how many more: the scanner's lines, from 1, as showdown makes them h1 or h2,
+ * and as a refusal's lines number them. A line it found under-ruled is the text above the rule,
+ * which the hint names, as the rule makes it the heading.
+ */
+export function headingHint(markdown: string, lines: number[]): string {
+  if (lines.length === 0) return ''
+  const rows = markdown.split(/\r\n|\r|\n/)
+  const said = lines.slice(0, MOST_HINTS).map(line => {
+    const text = (rows[line - 1] ?? '')
+      .replace(/^(?:[ \t]*>)+/, '')
+      .replace(/^(?:[ \t]*(?:[*+-]|\d+\.)[ \t]+)+/, '')
+      .trimStart()
+    return text.startsWith('#')
+      ? String.raw`Line ${line} is a # or ## heading. Use ### or more, or put a \ before the #.`
+      : `Line ${line} has = or - on the line below it, which makes it a heading. Leave a blank line between them.`
+  })
+  const more = lines.length - said.length
+  return more > 0 ? `${said.join(' ')} …and ${more} more` : said.join(' ')
+}
+
+/** A draft not yet made, as it's sent to make its note or chapter. */
+export function inputOf(made: NoteDraft): NoteInput {
+  const title = made.title.trim()
+  return made.role === 'entry'
+    ? {
+        role: 'entry',
+        title,
+        body: made.body,
+        chapterId: made.chapterId,
+      }
+    : { role: 'chapter', title }
+}
+
+/** A draft of a change, as it's sent to change its note or chapter from the stamp it began at. */
+export function changeOf(made: NoteDraft): NoteChange {
+  const title = made.title.trim()
+  const stamp = made.stamp ?? ''
+  return made.role === 'entry'
+    ? { title, body: made.body, chapterId: made.chapterId, stamp }
+    : { title, stamp }
+}
diff --git a/src/features/notes/utils/groups.ts b/src/features/notes/utils/groups.ts
new file mode 100644
index 0000000..d9d2b4c
--- /dev/null
+++ b/src/features/notes/utils/groups.ts
@@ -0,0 +1,58 @@
+import { LOOSE_TITLE } from '@/features/notes/constants'
+import type { JournalGroup } from '@/features/notes/types'
+import type { NoteGroupView, NoteState, NotesView } from '@/types/notes'
+
+/**
+ * A book's groups: the notes in no chapter first, then each chapter as `chapters` lists them,
+ * oldest first, each holding its notes in `entries`' order, which is the server's, never sorted
+ * here. A note whose chapter the seat doesn't see is in no chapter.
+ */
+export function groupsOf(view: NotesView): JournalGroup[] {
+  const known = new Set(view.chapters.map(({ id }) => id))
+  const orderOf = (chapterId: string | null): NoteGroupView =>
+    view.groups.find(group => group.chapterId === chapterId) ?? {
+      chapterId,
+      state: 'synced',
+      stamp: '',
+    }
+  const loose: JournalGroup = {
+    chapterId: null,
+    title: LOOSE_TITLE,
+    entries: view.entries.filter(
+      ({ chapterId }) => chapterId === null || !known.has(chapterId),
+    ),
+    order: orderOf(null),
+  }
+  return [
+    loose,
+    ...view.chapters.map((chapter, index) => ({
+      chapterId: chapter.id,
+      chapter,
+      n: index + 1,
+      title: chapter.title,
+      entries: view.entries.filter(({ chapterId }) => chapterId === chapter.id),
+      order: orderOf(chapter.id),
+    })),
+  ]
+}
+
+/** The states the contents' warning mark, and the card's count, take as a choice to make. */
+const CHOICES = new Set<NoteState>(['conflict', 'gone', 'failed'])
+
+/** Does a note or chapter in this state wait on the seat's choice? A delete waiting doesn't. */
+export function needsChoice(state: NoteState): boolean {
+  return CHOICES.has(state)
+}
+
+/** Does a group wait on the seat's choice: its chapter, a note in it, or its order? */
+export function groupNeedsChoice(group: JournalGroup): boolean {
+  return (
+    (group.chapter !== undefined && needsChoice(group.chapter.state)) ||
+    group.entries.some(({ state }) => needsChoice(state)) ||
+    group.order.state === 'conflict' ||
+    group.order.state === 'failed'
+  )
+}
+
+/** A group's key among its siblings: its chapter's id, or '' for the notes in no chapter. */
+export const keyOf = (chapterId: string | null) => chapterId ?? ''
diff --git a/src/features/notes/utils/permissions.ts b/src/features/notes/utils/permissions.ts
