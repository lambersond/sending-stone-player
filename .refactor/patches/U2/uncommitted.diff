-function withTool(
-  skill: SheetSkill,
-  tool: SheetTool | undefined,
-  bonus: number | null,
-): number {
-  if (!tool || bonus === null || tool.proficiency <= skill.proficiency) return 0
-  return (
-    Math.floor(tool.proficiency * bonus) - Math.floor(skill.proficiency * bonus)
-  )
-}
