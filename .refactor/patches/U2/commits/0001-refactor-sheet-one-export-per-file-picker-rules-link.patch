@@ -0,0 +1,64 @@
+import { useState, type FormEvent } from 'react'
+import { mostOf } from './utils'
+import { MOST_HIT_DICE } from '@/constants/sending-stone'
+import type { HitDiceCount, HitDicePool } from '@/types/roll'
+
+/**
+ * How many hit dice of each size are chosen to spend at once, as `HitDiceMenu` offers them: the
+ * size it opened for from 1, any other from none, where the character has more than one size; kept
+ * within the least and as many as are left, no more than the most at once in all, and pulled back
+ * should the sheet say fewer are left while it's open. `submit` spends them, once any are chosen.
+ */
+export function useHitDiceChoice({
+  die,
+  pools,
+  onSpend,
+}: {
+  die: string
+  pools: HitDicePool[]
+  onSpend: (counts: HitDiceCount[]) => void
+}) {
+  const [chosen, setChosen] = useState<ReadonlyMap<string, number>>(
+    () => new Map([[die, 1]]),
+  )
+  // One size alone is spent from 1; of several, any may be left at none.
+  const single = pools.length === 1
+  const least = single ? 1 : 0
+  const counts = pools.map(pool => ({
+    die: pool.die,
+    count: chosen.get(pool.die) ?? 0,
+  }))
+  // No more than are left, should the sheet say fewer are while it's open; nor more again, should
+  // it then say more are.
+  const over = pools.some(
+    pool => (chosen.get(pool.die) ?? 0) > Math.max(least, mostOf(pool)),
+  )
+  if (over) {
+    setChosen(
+      new Map(
+        pools.map(pool => [
+          pool.die,
+          Math.min(chosen.get(pool.die) ?? 0, Math.max(least, mostOf(pool))),
+        ]),
+      ),
+    )
+  }
+  const total = counts.reduce((all, { count }) => all + count, 0)
+  // Whether one more of a size can be spent: one more is left, and there are fewer than the most
+  // at once in all.
+  const roomFor = (pool: HitDicePool) =>
+    (chosen.get(pool.die) ?? 0) < mostOf(pool) && total < MOST_HIT_DICE
+  // Kept within the least and as many as are left, no more than the most in all; its buttons stay
+  // where they can't go further, so that focus isn't lost from one.
+  const step = (pool: HitDicePool, by: number) => {
+    const count = chosen.get(pool.die) ?? 0
+    if (by > 0 ? !roomFor(pool) : count <= least) return
+    setChosen(new Map(chosen).set(pool.die, count + by))
+  }
+  const submit = (event: FormEvent) => {
+    event.preventDefault()
+    if (total === 0) return
+    onSpend(counts.filter(({ count }) => count > 0))
+  }
+  return { chosen, single, least, counts, total, roomFor, step, submit }
+}
diff --git a/src/features/sheet/components/hit-dice/utils.ts b/src/features/sheet/components/hit-dice/utils.ts
index 1fce8e4..f6ec256 100644
--- a/src/features/sheet/components/hit-dice/utils.ts
+++ b/src/features/sheet/components/hit-dice/utils.ts
@@ -6,7 +6,7 @@ import {
   atFullHitPoints,
 } from '@/utils/formulas'
 import type { HitDieSpending } from './types'
-import type { SheetFormulaRoll, HitDicePool } from '@/types/roll'
+import type { HitDiceCount, SheetFormulaRoll, HitDicePool } from '@/types/roll'
 import type { TableSheet } from '@/types/table'
 
 /** How a sheet's hit dice are spent, given what rolls them; none where nothing rolls them. */
@@ -41,3 +41,49 @@ export function hitDiceText(pool: HitDicePool): string {
 export function countOf({ value, max }: HitDicePool): string {
   return `${value ?? '–'}/${max ?? '–'}`
 }
+
+/** The character's hit dice by size, with a button's own, should they leave its size out. */
+export function withPool(
+  pools: HitDicePool[],
+  pool: HitDicePool,
+): HitDicePool[] {
+  if (pools.some(({ die }) => die === pool.die)) return pools
+  return [...pools, pool].toSorted(
+    (a, b) => Number(b.die.slice(1)) - Number(a.die.slice(1)),
+  )
+}
+
+/** How many are left, such as "3 of 5 left", saying a count the sheet doesn't know so. */
+export function leftOf({ value, max }: HitDicePool, unknown: string): string {
+  const left = value ?? unknown
+  return max === null ? `${left} left` : `${left} of ${max} left`
+}
+
+/**
+ * How many of a size may be spent at once: as many as are left, or where the sheet doesn't say, as
+ * many as there are.
+ */
+export function mostOf({ value, max }: HitDicePool): number {
+  return value ?? max ?? 1
+}
+
+/** What spending these of one size is, after how many, for a screen reader: " d8 hit dice". */
+export function spentOne(die: string, count: number): string {
+  return ` ${die} hit ${count === 1 ? 'die' : 'dice'}`
+}
+
+/**
+ * What spending these of every size is, after how many, for a screen reader: " hit dice: 2d10 and
+ * 1d8", or of one die alone, " d10 hit die".
+ */
+export function spentOf(counts: HitDiceCount[], total: number): string {
+  const spent = counts.filter(({ count }) => count > 0)
+  if (total === 1) return spentOne(spent[0].die, 1)
+  const dice = spent.map(({ die, count }) => `${count}${die}`)
+  if (dice.length === 0) return ' hit dice'
+  const listed =
+    dice.length > 1
+      ? `${dice.slice(0, -1).join(', ')} and ${dice.at(-1)}`
+      : dice[0]
+  return ` hit dice: ${listed}`
+}
