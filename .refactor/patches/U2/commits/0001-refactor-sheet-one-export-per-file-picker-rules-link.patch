+  return (
+    // Its chips wrap under its name where both don't fit, as an action's row's do.
+    <li className='flex flex-wrap items-center gap-x-2 gap-y-0 py-0.5 pr-1.5'>
+      <span
+        tabIndex={onMenu ? 0 : undefined}
+        {...press.props}
+        className={clsx(
+          'min-w-[8.5rem] flex-1 py-0.5',
