+export function entryDetail(
+  action: SheetAction,
+  {
+    note,
+    section,
+    view,
+    cast,
+    more,
+    uses,
+  }: {
+    note?: string
+    section?: string
+    view: ReturnType<typeof viewOf>
+    cast: SheetCast | null | undefined
+    more: number
+    uses: SheetUses | null | undefined
+  },
