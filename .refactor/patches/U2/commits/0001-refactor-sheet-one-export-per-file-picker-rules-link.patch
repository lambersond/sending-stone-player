+      activationIn(activity, section),
+    range && activity.range !== parent.range && activity.range,
+    [
+      ...new Set(
+        activity.damage.flatMap(part => (part.type ? [part.type] : [])),
+      ),
+    ].join(', '),
+    castNote(cast),
