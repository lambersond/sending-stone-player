- * one, where the sheet says how and they take what it adds, and changed where the game takes it
- * so, as a module before 0.21.0, which changes its first die whatever its sign, does only where
- * that's one it adds; where the player alone rolls it, a critical hit's is as dnd5e makes one by
- * default. One whose formula the app can't read is only its text.
- */
-function DamageButton({
-  link,
-  label,
-  hash,
-  origin,
-  actions,
-  menus,
-}: Readonly<{
-  link: DamageLink
-  label: string
-  hash: string
-  origin: DescriptionOrigin
-  actions: DescriptionActions
-  menus: LinkMenus
-}>) {
-  const locked = useRollsLocked()
-  const terms = link.parts.map(part => formulaTerms(part.formula))
-  const read = terms.flatMap(each => (each ? [each] : []))
-  if (read.length !== link.parts.length) return label
-  const kind = link.healing ? 'healing' : 'damage'
-  const name = `${origin.name} ${kind}`
-  const formula = link.parts.map(part => part.formula).join(' + ')
-  const choice = link.parts.find(part => part.types.length > 1)
-  const table = actions.damage
-  const rule = table?.critical
-  // What a critical hit adds, where one is offered: as the world's rules make one, where the game
-  // rolls it too, or else as dnd5e does by default.
-  const adds = criticalOffered(link, table ? rule : EVERY_DIE_TWICE)
-  const ways = damageWays(read, table, adds)
-  const roll = (
-    chosen: string | undefined,
-    { critical = false, modifiers }: DamageChoice = {},
-  ) => {
-    const types = link.parts.map(part =>
-      chosen && part.types.includes(chosen)
-        ? chosen
-        : // a part of no kind has none, as the sheet's
-          (part.types[0] ?? null),
-    )
-    actions.rollDamage({
-      label: name,
-      parts: read.map((part, index) => ({
-        terms: part,
-        type: typeLabel(types[index]),
-      })),
-      healing: link.healing,
-      text: { text: hash, link: link.n },
-      // The kind chosen, for each part that offers a choice, for the game to roll it so.
-      ...(choice && {
-        types: link.parts.map((part, index) =>
-          part.types.length > 1 ? types[index] : null,
-        ),
-      }),
-      // A critical hit's as the game makes one, where it rolls it too and says how; else every
-      // die twice, the player's alone; with what a critical hit adds, either way.
-      ...(critical && {
-        critical,
-        ...(rule && { criticalRule: rule }),
-        ...(adds && { criticalAdds: adds }),
-      }),
-      ...(modifiers && changes(modifiers) && { modifiers }),
-    })
-  }
-  // Which kind first, where it offers a choice, then rolled so, the way chosen: the menu says what
-  // will be thrown, as the damage menu says it, and how.
-  const rollFrom = (
-    anchor: HTMLElement,
-    way?: DamageChoice,
-    point?: MenuPoint,
-  ) => {
-    if (!choice) {
-      roll(undefined, way)
-      return
-    }
-    const critical = way?.critical === true
-    const maximum = way?.modifiers?.maximize === true
-    const thrown = way ? thrownBy(read, way, rule, adds || undefined) : formula
-    const how = [critical && 'Critical hit', maximum && 'Maximum']
-      .filter(Boolean)
-      .map(word => ` · ${word}`)
-      .join('')
-    let adjective = ''
-    if (critical) adjective = 'critical '
-    else if (maximum) adjective = 'maximum '
-    menus.open({
-      anchor,
-      point,
-      title: `${name} ${thrown}${how}`,
-      items: choice.types.map(type => ({
-        id: type,
-        label: link.healing
-          ? `Roll ${adjective}${typeLabel(type)}`
-          : `Roll ${adjective}${typeLabel(type)} damage`,
-        icon: link.healing ? HeartPulse : Swords,
-        tint: link.healing ? 'text-primary' : 'text-damage',
-      })),
-      onChoose: type => roll(type, way),
-    })
-  }
-  const props = {
-    label: `${label}, roll ${kind}`,
-    className: clsx(
-      PILL,
-      link.healing
-        ? 'bg-primary/12 text-primary-text hover:bg-primary/20'
-        : 'bg-damage/15 text-damage hover:bg-damage/25',
-    ),
-  }
-  if (ways.length === 0) {
-    return (
-      <button
-        type='button'
-        aria-label={props.label}
-        {...(choice && { 'aria-haspopup': 'menu' as const })}
-        disabled={locked}
-        onClick={event => rollFrom(event.currentTarget)}
-        className={clsx(props.className, locked && LOCKED)}
-      >
-        {label}
-      </button>
-    )
-  }
-  return (
-    <RollButton
-      target={link}
-      onRoll={(_link, anchor) => rollFrom(anchor)}
-      onMenu={(anchor, _link, point) =>
-        menus.damage(
-          anchor,
-          {
-            label: name,
-            formula,
-            // As thrown unchanged, each part as the kind it is, where it offers no choice.
-            parts: read.map((part, index) => {
-              const { types } = link.parts[index]
-              return {
-                terms: part,
-                type: types.length === 1 ? typeLabel(types[0]) : null,
-              }
-            }),
-            healing: link.healing,
-            choices: ways,
-            ...(rule && { criticalRule: rule }),
-            ...(adds && { criticalAdds: adds }),
-            onChoose: way => rollFrom(anchor, way, point),
-          },
-          point,
-        )
-      }
-      {...props}
-    >
-      {label}
-    </RollButton>
-  )
-}
-
-/**
- * What a description's damage or healing will throw, rolled the way chosen: changed as the player
- * chose, and as a critical hit's, as the world's rules make one, where the game says how, or else
- * every die twice, with what a critical hit adds; such as "4d10 + 2d6".
- */
-function thrownBy(
-  parts: ExtraTerm[][],
-  { critical = false, modifiers }: DamageChoice,
-  rule?: CriticalRule,
-  adds?: CriticalAdds,
-): string {
-  const changed = withModifiers(
-    parts.map(terms => ({ terms, type: null })),
-    modifiers,
-    1,
-  )
-  if (critical) {
-    return formulaOf(criticalParts(changed, rule ?? EVERY_DIE_TWICE, adds))
-  }
-  return formulaOf(changed)
-}
-
-/**
- * The other ways a description's damage or healing may be rolled, as an action's may: as a critical
- * hit's, where one is offered, as `criticalOffered` says, and at its highest, unless it takes a die
- * away, or with its first die changed, where it has one, never one it takes away. Where the game
- * rolls it too, only those it takes: a critical hit's where the sheet says how the world makes
- * one, and changed where it takes it so, as a module before 0.21.0, which changes its first die
- * whatever its sign, does only where that's one it adds.
- * @param adds - What a critical hit adds, where one is offered.
- */
-function damageWays(
-  parts: ExtraTerm[][],
-  table: DescribedDamage | undefined,
-  adds: CriticalAdds | false,
-): RollChoice[] {
-  const changed = !table || table.modifies
-  const read = parts.map(terms => ({ terms }))
-  // A module before 0.21.0 changes its first die whatever its sign: only where that's one it adds.
-  const fixed =
-    table !== undefined && table.signed !== true && !sameFirstDie(read)
-  return [
-    ...(adds ? (['critical'] as const) : []),
-    ...(changed ? damageChanges(read, fixed) : []),
-  ]
-}
