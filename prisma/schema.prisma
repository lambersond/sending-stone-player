generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------
// Enums
// -----------------------

// Where a player's roll for the Gamemaster's game stands: waiting for the module to fetch it,
// fetched, or made in the game, or not.
enum RollRequestStatus {
  pending
  claimed
  done
  failed
}

// -----------------------
// User model
// -----------------------

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  characters    Character[]
  // The campaigns this user runs as Gamemaster.
  campaigns     Campaign[]

  @@unique([email])
  @@map("user")
}

// -----------------------
// Authentication models for Better Auth
// -----------------------
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -------------------------
// Application models
// -------------------------

// A character a user plays: one of a campaign's characters, chosen from its list after following
// the Gamemaster's invite link.
model Character {
  id            String        @id @default(cuid())
  // The character's name in Foundry when it was chosen.
  name          String
  // The game's origin, such as https://my-game.forge-vtt.com, and the campaign's title, when the
  // character was chosen.
  gameUrl       String
  campaignTitle String
  // The campaign, and the Foundry actor in it, that this character is. Unset for a character made
  // before players chose from a campaign's characters, until its player chooses, and for one whose
  // campaign was removed.
  campaignId    String?
  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  actorId       String?
  // When its player last had the chat in view, or another device of theirs did: messages sent
  // after it are unread.
  chatReadAt    DateTime?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rollRequests  RollRequest[]

  // One player per character.
  @@unique([campaignId, actorId], name: "campaignActor")
  @@index([userId])
  @@map("character")
}

// A campaign in a Foundry game, set up here by its Gamemaster with the secret their Sending Stone
// module sends. The module's campaign with the same title is bound to it by its first event.
// Players join it through the Gamemaster's invite link.
model Campaign {
  id             String        @id @default(cuid())
  // The origin the game is served from, which its events arrive with.
  origin         String
  // The module's id for the campaign, which never changes. Unset until its first event.
  foundryId      String?
  // The module's campaign with this title is the one bound to it. Renaming it in the module renames
  // it here.
  title          String
  worldId        String?
  worldTitle     String?
  // The Gamemaster who set the campaign up. Unset only for a campaign from before Gamemasters set
  // campaigns up here, which accepts no events until one sets it up.
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // A hash of the secret the module sends with each event.
  secretHash     String?
  // The code in the link the Gamemaster shares to invite players. Resetting it retires the old link.
  inviteCode     String?       @unique
  // The campaign's characters, from its latest bridge.hello.
  characters     Json          @default("[]")
  // The module session whose bridge.hello was last applied. An event from another session means
  // this may be missing the campaign's state, such as when its hello was refused before the
  // campaign was set up here, so the module is asked to send it again.
  helloSession   String?
  // Bumped on every change, so a viewer can tell cheaply whether anything is new.
  version        Int           @default(0)
  lastEventAt    DateTime?
  // When anything, an event or a heartbeat, last arrived: whether the Gamemaster is connected.
  lastSeenAt     DateTime?
  // Whether the Gamemaster lets the campaign's players roll in their game from here, and which
  // rolls the module can make, from its latest bridge.hello.
  rollsEnabled   Boolean       @default(false)
  rollKinds      String[]      @default([])
  // What else the module can do with them, such as take damage a player changed, or ask players
  // for the saving throws their game asks of their characters.
  rollFeatures   String[]      @default([])
  // When the module last fetched players' rolls: whether it is fetching them now.
  bridgePolledAt DateTime?
  // When one of the campaign's players last had their table open: whether a roll may be coming,
  // so the module's fetch is held open for one.
  playersSeenAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       ChatMessage[]
  combats        Combat[]
  sheets         ActorSheet[]
  texts          SheetText[]
  players        Character[]
  rollRequests   RollRequest[]
  rollPrompts    RollPrompt[]

  @@unique([origin, foundryId], name: "originCampaign")
  @@index([ownerId])
  @@map("campaign")
}

model ChatMessage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Foundry's id for the message.
  messageId  String
  sentAt     DateTime
  public     Boolean
  // Actor ids of the campaign's characters whose players can read the message.
  readers    String[]
  // The message as the module serialized it for this campaign.
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, messageId], name: "campaignMessage")
  @@index([campaignId, sentAt])
  @@map("chat_message")
}

model Combat {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Foundry's id for the combat.
  combatId   String
  // The latest snapshot of the combat for this campaign, combatants in turn order.
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, combatId], name: "campaignCombat")
  @@map("combat")
}

// One of a campaign's characters' sheets, as the module last sent it under dnd5e: abilities, saves,
// skills and the like. Only the character's own player is shown it.
model ActorSheet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The Foundry actor whose sheet it is.
  actorId    String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, actorId], name: "campaignActor")
  @@map("actor_sheet")
}

// A description that a campaign's sheets refer to by hash, such as a feature's. Sent once, apart
// from the sheets, since descriptions are most of their size.
model SheetText {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The module's hash of where the description comes from.
  hash       String
  // Sanitised, with images and links pointing at the game.
  html       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, hash], name: "campaignHash")
  @@map("sheet_text")
}

// A roll a player made here, for their character to make in the Gamemaster's game with the same
// dice. The Gamemaster's module fetches it, makes it, and reports what came of it. It is fetched
// at most once: a fetch whose answer is lost loses the roll, rather than making it twice.
model RollRequest {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  characterId  String
  character    Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // The Foundry actor that rolls.
  actorId      String
  // Such as "skill" or "save".
  kind         String
  // What to roll and how, and the dice the player rolled: the command the module is sent.
  payload      Json
  // For damage, the attack it follows.
  useId        String?
  status       RollRequestStatus @default(pending)
  // Which fetch took it, and from which module session.
  claimToken   String?
  claimSession String?
  claimedAt    DateTime?
  // What the module reported: the roll as the game made it, or why it couldn't.
  result       Json?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([campaignId, status, createdAt])
  @@index([characterId, createdAt])
  @@index([useId])
  @@map("roll_request")
}

// A saving throw a campaign's game asks of one of its characters, such as a concentration check,
// which its player rolls here: from the module's roll.prompt.opened until its roll.prompt.closed,
// or its time runs out.
model RollPrompt {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The module's id for it: its chat card's id and its character's.
  promptId     String
  // The Foundry actor asked.
  actorId      String
  // What it asks, as the module described it: the kind of save, its abilities, DC and label.
  data         Json
  openedAt     DateTime
  // When it stops waiting for its player, if nothing closes it first.
  expiresAt    DateTime
  // Once closed: when, and why, such as "answered" or "gone".
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([campaignId, promptId], name: "campaignPrompt")
  @@index([campaignId, actorId, closedAt])
  @@map("roll_prompt")
}
