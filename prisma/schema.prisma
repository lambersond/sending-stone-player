generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------
// Enums
// -----------------------



// -----------------------
// User model
// -----------------------

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  characters    Character[]

  @@unique([email])
  @@map("user")
}

// -----------------------
// Authentication models for Better Auth
// -----------------------
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -------------------------
// Application models
// -------------------------

// A character a user plays, and the Forge game whose Sending Stone events it follows.
model Character {
  id        String   @id @default(cuid())
  name      String
  // The game's origin, such as https://my-game.forge-vtt.com. The Sending Stone module posts
  // from the Gamemaster's browser, so this is the Origin its events arrive with.
  gameUrl   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("character")
}

// A Foundry game whose Gamemaster sends events through the Sending Stone module. Keyed by the
// origin the game is served from, which is the Origin its events arrive with and what a
// character's gameUrl holds.
model Game {
  id          String        @id @default(cuid())
  origin      String        @unique
  worldId     String?
  worldTitle  String?
  // The connected characters from the latest bridge.hello or characters.updated.
  characters  Json          @default("[]")
  // Bumped on every change, so a viewer can tell cheaply whether anything is new.
  version     Int           @default(0)
  lastEventAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  combats     Combat[]

  @@map("game")
}

model ChatMessage {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Foundry's id for the message.
  messageId String
  sentAt    DateTime
  public    Boolean
  // Actor ids of the connected characters whose players can read the message.
  readers   String[]
  // The message as the module serialized it.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, messageId], name: "gameMessage")
  @@index([gameId, sentAt])
  @@map("chat_message")
}

model Combat {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  // Foundry's id for the combat.
  combatId  String
  // The latest snapshot of the combat, combatants in turn order.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, combatId], name: "gameCombat")
  @@map("combat")
}
