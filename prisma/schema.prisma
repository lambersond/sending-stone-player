generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------
// Enums
// -----------------------

// Where a player's roll for the Gamemaster's game stands: waiting for the module to fetch it,
// fetched, or made in the game, or not.
enum RollRequestStatus {
  pending
  claimed
  done
  failed
}

// Who sent a roll for a character: its player, or its campaign's Gamemaster rolling as it (#156).
enum RollRole {
  player
  gm
}

// Whose journal of notes, from module 0.34.0: a character's own, or a party's.
enum JournalKind {
  personal
  party
}

// A journal note: a chapter, a level 1 heading in Foundry's journal, or an entry under one, a level 2.
enum NoteRole {
  chapter
  entry
}

// What a change made here asks of Foundry.
enum NoteOp {
  create
  update
  delete
}

// Where a change made here stands: waiting for the module, fetched, refused because the note was
// changed or deleted in Foundry meanwhile, refused otherwise, or made (kept an hour, for the
// seat's limit, and then deleted).
enum NoteWriteStatus {
  pending
  claimed
  conflict
  failed
  made
}

// -----------------------
// User model
// -----------------------

model User {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  characters    Character[]
  // The campaigns this user runs as Gamemaster.
  campaigns     Campaign[]
  // The rolls this user sent here, as a player or as a Gamemaster.
  rollRequests  RollRequest[]

  @@unique([email])
  @@map("user")
}

// -----------------------
// Authentication models for Better Auth
// -----------------------
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// -------------------------
// Application models
// -------------------------

// A character a user plays: one of a campaign's characters, chosen from its list after following
// the Gamemaster's invite link.
model Character {
  id            String        @id @default(cuid())
  // The character's name in Foundry when it was chosen.
  name          String
  // The game's origin, such as https://my-game.forge-vtt.com, and the campaign's title, when the
  // character was chosen.
  gameUrl       String
  campaignTitle String
  // The campaign, and the Foundry actor in it, that this character is. Unset for a character made
  // before players chose from a campaign's characters, until its player chooses, and for one whose
  // campaign was removed.
  campaignId    String?
  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  actorId       String?
  // When its player last had the chat in view, or another device of theirs did: messages sent
  // after it are unread.
  chatReadAt    DateTime?
  // When its player's page last asked for its table, at most every few seconds: within the last
  // few, the character is open in the app, and the Gamemaster's module waits for its answers to
  // what Midi-QOL asks of it (module 0.27.0). Never the Gamemaster's page's.
  tableSeenAt   DateTime?
  // Whether its player types in what their own dice show for its rolls, on every device, as they
  // set it in the sheet's settings: offered only while its campaign's game lets them (module 0.32.0).
  manualDice    Boolean       @default(false)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  rollRequests  RollRequest[]

  // One player per character.
  @@unique([campaignId, actorId], name: "campaignActor")
  @@index([userId])
  @@map("character")
}

// A campaign in a Foundry game, set up here by its Gamemaster with the secret their Sending Stone
// module sends. The module's campaign with the same title is bound to it by its first event.
// Players join it through the Gamemaster's invite link.
model Campaign {
  id                  String           @id @default(cuid())
  // The origin the game is served from, which its events arrive with.
  origin              String
  // The module's id for the campaign, which never changes. Unset until its first event.
  foundryId           String?
  // The module's campaign with this title is the one bound to it. Renaming it in the module renames
  // it here.
  title               String
  worldId             String?
  worldTitle          String?
  // The Gamemaster who set the campaign up. Unset only for a campaign from before Gamemasters set
  // campaigns up here, which accepts no events until one sets it up.
  ownerId             String?
  owner               User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // A hash of the secret the module sends with each event.
  secretHash          String?
  // The code in the link the Gamemaster shares to invite players. Resetting it retires the old link.
  inviteCode          String?          @unique
  // The campaign's characters, from its latest bridge.hello.
  characters          Json             @default("[]")
  // The campaign's Group actors, such as its party, from its latest bridge.hello and each
  // group.updated since (module 0.30.0): who may see each, never its sheet, which is kept apart.
  groups              Json             @default("[]")
  // The campaign's characters' companions, from module 0.36.0's hello and each companions.listed
  // since: the creatures each character summoned in Foundry and the NPCs its player owns there,
  // each with the characters it's a companion of, never its sheet, which is kept apart. Never
  // claimable or seated as a character.
  companions          Json             @default("[]")
  // The kinds a companion's rolls may be, from module 0.36.0's hello. A module before it says
  // nothing, which clears it.
  companionKinds      String[]         @default([])
  // How its characters' companions enter initiative, from module 0.36.0's hello: "own", each
  // rolls its own, or "after", right after its character, where the game sets it. A module
  // before it says nothing, which sets it back to "own".
  companionInitiative String           @default("own")
  // The module session whose bridge.hello was last applied. An event from another session means
  // this may be missing the campaign's state, such as when its hello was refused before the
  // campaign was set up here, so the module is asked to send it again.
  helloSession        String?
  // Bumped on every change, so a viewer can tell cheaply whether anything is new.
  version             Int              @default(0)
  lastEventAt         DateTime?
  // When anything, an event or a heartbeat, last arrived: whether the Gamemaster is connected.
  lastSeenAt          DateTime?
  // Whether the Gamemaster lets the campaign's players roll in their game from here, and which
  // rolls the module can make, from its latest bridge.hello.
  rollsEnabled        Boolean          @default(false)
  rollKinds           String[]         @default([])
  // What else the module can do with them, such as take damage a player changed, or ask players
  // for the saving throws their game asks of their characters.
  rollFeatures        String[]         @default([])
  // Whether the Gamemaster lets the campaign's players move items and coins from here, from module
  // 0.31.0's hello: apart from the rolls.
  transfersEnabled    Boolean          @default(false)
  // What else the module does with moves, from module 0.32.0's hello: a party's things sent
  // elsewhere by its Owner, and a party's coin distributed among its characters.
  transferFeatures    String[]         @default([])
  // Whether the module removes characters' items for the app, from module 0.33.0's hello: under
  // dnd5e, with no switch of its own, apart from the rolls and the moves.
  removalsEnabled     Boolean          @default(false)
  // Whether the module keeps journal notes for the app, from module 0.34.0's hello, with no switch.
  notesEnabled        Boolean          @default(false)
  // What else the module does with journal notes, from module 0.35.0's hello: 'orders' where it
  // takes the app's orders of a group's notes. A module before it says nothing, which clears it.
  noteFeatures        String[]         @default([])
  // When the module last fetched players' rolls: whether it is fetching them now.
  bridgePolledAt      DateTime?
  // When one of the campaign's players last had their table open: whether a roll may be coming,
  // so the module's fetch is held open for one.
  playersSeenAt       DateTime?
  // The latest post from Foundry refused that could be tied to the campaign, which its card shows
  // for a day: when, why (a reason the module shares), its status, and what more there is to say,
  // such as the title Foundry sent. Cleared when the campaign is bound, or its secret changed.
  refusedAt           DateTime?
  refusalReason       String?
  refusalStatus       Int?
  refusalDetail       String?
  // What Foundry last said of itself for this campaign: versions, and from module 0.30.0 its
  // settings and what players see. Read on the Gamemaster's campaign card only.
  foundry             Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  messages            ChatMessage[]
  combats             Combat[]
  sheets              ActorSheet[]
  groupSheets         GroupSheet[]
  companionSheets     CompanionSheet[]
  texts               SheetText[]
  players             Character[]
  rollRequests        RollRequest[]
  rollPrompts         RollPrompt[]
  journalBooks        JournalBook[]

  @@unique([origin, foundryId], name: "originCampaign")
  @@index([ownerId])
  @@map("campaign")
}

model ChatMessage {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Foundry's id for the message.
  messageId  String
  sentAt     DateTime
  public     Boolean
  // Actor ids of the campaign's characters whose players can read the message.
  readers    String[]
  // The message as the module serialized it for this campaign.
  data       Json
  // Made for one of this app's rolls by the campaign's Gamemaster as a character: set here, from
  // the rolls this app handed over, never from what the message says, and never unset.
  byGm       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, messageId], name: "campaignMessage")
  @@index([campaignId, sentAt])
  @@map("chat_message")
}

model Combat {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Foundry's id for the combat.
  combatId   String
  // The latest snapshot of the combat for this campaign, combatants in turn order.
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, combatId], name: "campaignCombat")
  @@map("combat")
}

// One of a campaign's characters' sheets, as the module last sent it under dnd5e: abilities, saves,
// skills and the like. Only the character's own player is shown it.
model ActorSheet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The Foundry actor whose sheet it is.
  actorId    String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, actorId], name: "campaignActor")
  @@map("actor_sheet")
}

// One of a campaign's Group actors' sheets, as the module last sent it. Kept apart from ActorSheet,
// so a group can never be claimed, seated or served as a character.
model GroupSheet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  actorId    String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, actorId], name: "campaignGroup")
  @@map("group_sheet")
}

// One of a campaign's characters' companions' sheets, as the module last sent it (module
// 0.36.0). Kept apart from ActorSheet, so a companion can never be claimed, seated or served as
// a character; only its characters' players and the Gamemaster are shown it.
model CompanionSheet {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The companion's key: its actor's id, or for a token's creature `<sceneId>-<tokenId>`.
  key        String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, key], name: "campaignCompanion")
  @@map("companion_sheet")
}

// A description that a campaign's sheets refer to by hash, such as a feature's. Sent once, apart
// from the sheets, since descriptions are most of their size.
model SheetText {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The module's hash of where the description comes from.
  hash       String
  // Sanitised, with images and links pointing at the game.
  html       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([campaignId, hash], name: "campaignHash")
  @@map("sheet_text")
}

// A roll a player made here, for their character to make in the Gamemaster's game with the same
// dice. The Gamemaster's module fetches it, makes it, and reports what came of it. It is fetched
// at most once: a fetch whose answer is lost loses the roll, rather than making it twice.
model RollRequest {
  id            String            @id @default(cuid())
  campaignId    String
  campaign      Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The player's character it was sent for; unset for one the Gamemaster sent.
  characterId   String?
  character     Character?        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // Who sent it: the character's player, or the campaign's Gamemaster as the character (#156).
  role          RollRole          @default(player)
  // The user who sent it. Set on every row since #156, unset on older ones.
  requestedById String?
  requestedBy   User?             @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  // The Foundry actor that rolls.
  actorId       String
  // For a companion's roll, from module 0.36.0: the campaign character whose companion `actorId`
  // is, as the module is told it. Unset for a character's own roll.
  ofActorId     String?
  // Such as "skill" or "save".
  kind          String
  // What the Gamemaster's page called it, such as "Perception check", for its player's page to show
  // it by (#156): only ever shown as text. Unset for a player's roll, and one sent before it was.
  label         String?
  // What to roll and how, and the dice the player rolled: the command the module is sent.
  payload       Json
  // For damage, the attack it follows.
  useId         String?
  status        RollRequestStatus @default(pending)
  // Which fetch took it, and from which module session.
  claimToken    String?
  claimSession  String?
  claimedAt     DateTime?
  // What the module reported: the roll as the game made it, or why it couldn't.
  result        Json?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([campaignId, status, createdAt])
  @@index([characterId, createdAt])
  @@index([campaignId, actorId, role, createdAt])
  @@index([useId])
  @@map("roll_request")
}

// A saving throw a campaign's game asks of one of its characters, such as a concentration check,
// which its player rolls here: from the module's roll.prompt.opened until its roll.prompt.closed,
// or its time runs out.
model RollPrompt {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // The module's id for it: its chat card's id and its character's.
  promptId     String
  // The Foundry actor asked.
  actorId      String
  // What it asks, as the module described it: the kind of save, its abilities, DC and label.
  data         Json
  openedAt     DateTime
  // When it stops waiting for its player, if nothing closes it first.
  expiresAt    DateTime
  // Once closed: when, and why, such as "answered" or "gone".
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([campaignId, promptId], name: "campaignPrompt")
  @@index([campaignId, actorId, closedAt])
  @@map("roll_prompt")
}

// A character's or a party's journal of notes, from module 0.34.0: the app's mirror of Foundry's
// journal, and the changes made here waiting for it. Keyed on the actor, never the Character, so a
// player leaving deletes none of it.
model JournalBook {
  id          String         @id @default(cuid())
  campaignId  String
  campaign    Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  kind        JournalKind
  // The character's actor, or the party's Group actor.
  actorId     String
  // Bumped on every change to its notes or its changes waiting, here or from Foundry.
  version     Int            @default(0)
  // Foundry's journal, as the module last said: unset while it has none.
  journalId   String?
  journalName String?
  // Why Foundry last sent no notes: { reason: 'private' } or { reason: 'tooLarge', bytes, limit }.
  withheld    Json?
  syncedAt    DateTime?
  // The journal's last change that leaves no note to show it, from module 0.35.0: a note deleted,
  // or a group's notes put in order, here or in Foundry; by whom, when, and where, 'app' or
  // 'foundry'. Unset until one is made.
  changedAt   DateTime?
  changedBy   String?
  changedIn   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  notes       JournalNote[]
  writes      JournalWrite[]
  orders      JournalOrder[]

  @@unique([campaignId, kind, actorId], name: "campaignBook")
  @@map("journal_book")
}

// A note as Foundry last held it: never changed here but from what the module sends.
model JournalNote {
  bookId        String
  book          JournalBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  noteId        String
  role          NoteRole
  chapterId     String?
  title         String
  // 2 for Markdown, 1 for HTML written in Foundry's own editor.
  format        Int
  // Its Markdown; for format 1, empty.
  body          String
  // As drawn here: rendered and sanitised for its book (secrets kept in a personal one only).
  html          String
  cut           Boolean     @default(false)
  // A party page Foundry sent as HTML for the secret its Markdown holds: changed only in Foundry.
  secret        Boolean     @default(false)
  // Who wrote it from the app: a character, or the Gamemaster; none for one written in Foundry.
  authorActorId String?
  authorGm      Boolean     @default(false)
  authorName    String?
  createdAt     DateTime
  modifiedAt    DateTime
  modifiedBy    String
  // 'app' or 'foundry'.
  modifiedIn    String
  revision      String
  // Its place in its group as Foundry last sent the journal, from 0 (module 0.35.0): a chapter's
  // among the chapters, a note's among the notes of its chapter, or of none.
  place         Int         @default(0)

  @@id([bookId, noteId])
  @@map("journal_note")
}

// A change made here to a note, waiting for the module to make it in Foundry: at most one per note.
// Nothing about it expires while it waits. Made, it's kept an hour, then deleted.
model JournalWrite {
  id            String          @id
  // Bumped by every change to it; the command's id is `<id>.<seq>`, and the page's stamp names it.
  seq           Int             @default(0)
  campaignId    String
  bookId        String
  book          JournalBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  noteId        String
  op            NoteOp
  role          NoteRole
  chapterId     String?
  title         String
  body          String
  html          String
  // The note's author and when it was created: for a create, the seat and now; else the note's.
  authorActorId String?
  authorGm      Boolean         @default(false)
  authorName    String
  noteCreatedAt DateTime
  // Who made this change: the character's player or the campaign's Gamemaster, and as which
  // character (none for the Gamemaster). Not a foreign key: a write outlives nothing it names.
  seat          RollRole        @default(player)
  requestedById String
  writerActorId String?
  modifiedAt    DateTime
  modifiedBy    String
  // The revision it was made from; unset for a create.
  base          String?
  status        NoteWriteStatus @default(pending)
  // Why the module refused it, for a conflict or a failure.
  reason        String?
  // The page's revision as the module refused it against: what "Use yours" goes again from where
  // the mirror can't say Foundry's revision now, in a book Foundry holds back as too large.
  foundryRev    String?
  claimToken    String?
  claimSession  String?
  claimedAt     DateTime?
  // When this note's change was first queued: the claim's order. Kept by folds.
  queuedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([bookId, noteId])
  @@index([campaignId, status, queuedAt])
  // The seat's limit counts its own changes by when it made them, not when the module answered.
  @@index([requestedById, modifiedAt])
  @@map("journal_write")
}

// A new order of one group's notes, a chapter's or those in no chapter, made here and waiting for
// the module to make it in Foundry (module 0.35.0): at most one per group, whoever made it.
// Nothing about it expires while it waits. Made, it's kept an hour, then deleted.
model JournalOrder {
  id            String          @id
  // Bumped by every change to it; the command's id is `<id>.<seq>`.
  seq           Int             @default(0)
  campaignId    String
  bookId        String
  book          JournalBook     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // The group: the chapter's note id, or '' for the notes in no chapter.
  chapterId     String
  // The notes' ids in the new order, as the seat who made it saw them.
  ids           String[]
  // The group's order in Foundry it was made from, as the mirror held it: the module refuses it
  // where those notes were reordered there since.
  was           String[]
  // Who made it, as a note's change records it.
  seat          RollRole        @default(player)
  requestedById String
  writerActorId String?
  modifiedAt    DateTime
  modifiedBy    String
  status        NoteWriteStatus @default(pending)
  reason        String?
  claimToken    String?
  claimSession  String?
  claimedAt     DateTime?
  // When it was last changed: the claim's order. Set again by every fold (round 0.35.0 §4.2),
  // so the changes of the notes it lists, queued before it, are made first.
  queuedAt      DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([bookId, chapterId])
  @@index([campaignId, status, queuedAt])
  @@index([requestedById, modifiedAt])
  @@map("journal_order")
}
