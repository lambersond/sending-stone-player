to w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></header><div class="grid min-w-0 gap-4 @min-[900px]/index:grid-cols-[340px_minmax(0,1fr)] @min-[900px]/index:items-start"><div class="-m-1 min-w-0 flex-col gap-2 p-1 @min-[900px]/index:sticky @min-[900px]/index:top-4 @min-[900px]/index:max-h-[calc(100dvh-2rem)] @min-[900px]/index:overflow-y-auto flex"><h2 id="campaigns-rest" class="sr-only">Campaigns</h2><ul aria-labelledby="campaigns-rest" class="grid gap-2"><li><button type="button" data-campaign="strahd" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">Curse of Strahd</span><span class="block truncate text-[13px] text-text-secondary">Barovia · mists.forge-vtt.com</span></span><span><span data-state="live" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full bg-primary motion-safe:animate-pulse"></span>Live</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="inline-flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1"><span aria-hidden="true" data-seats="true" class="inline-flex items-center"><span title="Alice as Thorin Oakenshield" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full bg-primary/15 text-[10px] font-bold text-primary-text ring-2 ring-card first:ml-0">A</span><span title="Bob as Vex" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full bg-primary/15 text-[10px] font-bold text-primary-text ring-2 ring-card first:ml-0">B</span><span title="Kasimir, not chosen yet" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full border border-dashed border-text-secondary bg-page text-[10px] font-bold text-text-secondary ring-2 ring-card first:ml-0">?</span></span><span class="text-xs text-text-secondary">2 of 3 characters chosen</span></span></span></button></li></ul></div><div class="min-w-0 flex-col gap-4 hidden @min-[900px]/index:flex"><article aria-labelledby="campaign-strahd" class="grid min-w-0 gap-5 rounded-2xl border border-border bg-card p-5 sm:p-6"><header class="flex min-w-0 flex-wrap items-start justify-between gap-3"><div class="min-w-0"><h2 id="campaign-strahd" tabindex="-1" class="text-xl font-semibold tracking-tight break-words outline-none">Curse of Strahd</h2><p class="text-sm text-text-secondary wrap-anywhere">Barovia · mists.forge-vtt.com</p></div><span class="inline-flex shrink-0 flex-col items-end gap-0.5"><span data-state="live" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full bg-primary motion-safe:animate-pulse"></span>Live</span></span></header><div class="grid min-w-0 gap-5 @min-[900px]/index:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] @min-[900px]/index:items-start"><div class="grid min-w-0 gap-5"><section class="grid gap-2"><h3 class="text-sm font-medium">Characters</h3><p class="-mt-1 text-xs text-text-secondary">Open one to see its sheet and roll as it.</p><ul class="grid gap-1.5 text-sm"><li class="flex min-h-11 flex-wrap items-center justify-between gap-3 rounded-lg bg-page pr-1 pl-3 py-1"><a id="campaign-strahd-sheet-thorin" aria-label="Open Thorin Oakenshield's sheet" class="truncate font-medium text-text-primary underline-offset-2 hover:text-primary hover:underline" href="/campaigns/strahd/characters/thorin">Thorin Oakenshield</a><span class="flex min-w-0 items-center gap-1"><span class="text-xs wrap-anywhere font-semibold text-primary">Alice</span><button type="button" aria-label="Remove Alice as Thorin Oakenshield" title="Remove Alice as Thorin Oakenshield" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-danger/10 hover:text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-minus size-4" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="22" x2="16" y1="11" y2="11"></line></svg></button><dialog aria-labelledby="id-3" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></span></li><li class="flex min-h-11 flex-wrap items-center justify-between gap-3 rounded-lg bg-page pr-1 pl-3 py-1"><a id="campaign-strahd-sheet-vex" aria-label="Open Vex's sheet" class="truncate font-medium text-text-primary underline-offset-2 hover:text-primary hover:underline" href="/campaigns/strahd/characters/vex">Vex</a><span class="flex min-w-0 items-center gap-1"><span class="text-xs wrap-anywhere font-semibold text-primary">Bob</span><button type="button" aria-label="Remove Bob as Vex" title="Remove Bob as Vex" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-danger/10 hover:text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-minus size-4" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="22" x2="16" y1="11" y2="11"></line></svg></button><dialog aria-labelledby="id-4" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></span></li><li class="flex min-h-11 flex-wrap items-center justify-between gap-3 rounded-lg bg-page pr-1 pl-3 py-1"><a id="campaign-strahd-sheet-kasimir" aria-label="Open Kasimir's sheet" class="truncate font-medium text-text-primary underline-offset-2 hover:text-primary hover:underline" href="/campaigns/strahd/characters/kasimir">Kasimir</a><span class="flex min-w-0 items-center gap-1"><span class="text-xs wrap-anywhere pr-2 text-text-secondary">Not chosen yet</span></span></li></ul></section></div><div class="grid min-w-0 gap-5"><section class="grid gap-1.5"><h3 class="text-sm font-medium">Invite link</h3><span class="flex min-w-0 items-center gap-2 rounded-lg border border-border bg-page py-1 pr-1 pl-3"><code class="min-w-0 flex-1 font-mono text-xs text-text-primary truncate">https://stone.example/join/code-strahd</code><button type="button" aria-label="Copied" title="Copied" class="shrink-0 rounded-md text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary inline-flex min-h-9 items-center gap-1.5 px-2.5 text-xs font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-4 text-primary" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>Copied</button></span><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm text-text-secondary">Share it with your players. They sign in and choose their character.</p><button type="button" class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw size-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>Reset link</button><dialog aria-labelledby="id-5" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dices size-4 text-text-secondary" aria-hidden="true"><rect width="12" height="12" x="2" y="10" rx="2" ry="2"></rect><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6"></path><path d="M6 18h.01"></path><path d="M10 14h.01"></path><path d="M15 6h.01"></path><path d="M18 9h.01"></path></svg>Players' rolls</h3><p class="text-sm text-text-secondary">Checks, saves, initiative, death saves, attacks and spells your players roll and cast here are made in your game too, with the same dice. Their attacks, spells and features spend ammunition, uses and spell slots there. When your game asks one of their characters for a saving throw, such as a concentration check, its player is asked here to roll it.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right size-4 text-text-secondary" aria-hidden="true"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg>Items and coins</h3><p class="text-sm text-text-secondary">Players can’t move items and coins from here. To let them, tick Players move items and coins on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cooking-pot size-4 text-text-secondary" aria-hidden="true"><path d="M2 12h20"></path><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="m4 8 16-4"></path><path d="m8.86 6.78-.45-1.81a2 2 0 0 1 1.45-2.43l1.94-.48a2 2 0 0 1 2.43 1.46l.45 1.8"></path></svg>Cookbook dishes</h3><p class="text-sm text-text-secondary">Off. To take dishes, tick Dishes from the Magical Recipe Book on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars size-4 text-text-secondary" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Players' effects</h3><p class="text-sm text-text-secondary">Off. To let them, tick Allow Players to disable &amp; remove their own active effects on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paw-print size-4 text-text-secondary" aria-hidden="true"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="20" cy="16" r="2"></circle><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path></svg>Wild Shape</h3><p class="text-sm text-text-secondary">Off. To let them, tick Allow Players to use Wild Shape from the app on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><details class="min-w-0"><summary class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary -ml-2.5 cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-2 size-4" aria-hidden="true"><path d="M14 17H5"></path><path d="M19 7h-9"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg>Foundry settings</summary><div class="mt-3 grid min-w-0 gap-4 text-sm"><p class="text-text-secondary">Foundry hasn't sent its settings yet. They arrive the next time your game connects.</p></div></details></div></div><footer class="flex flex-wrap items-start justify-between gap-3 border-t border-border pt-4"><details class="group min-w-0 flex-1"><summary class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round size-4" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Change secret</summary><div class="mt-3 max-w-md"><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')" class="grid gap-1.5"><label for="id-6" class="text-sm font-medium">New secret</label><div class="flex gap-2"><input id="id-6" minlength="12" maxlength="200" autocomplete="off" autocapitalize="none" spellcheck="false" required="" class="h-10 min-w-0 flex-1 rounded-xl border border-border bg-page px-3 font-mono text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/25 aria-invalid:border-danger" name="secret"><button type="submit" class="inline-flex h-10 shrink-0 items-center gap-2 rounded-xl border border-border px-3.5 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary/5 disabled:opacity-60">Save secret</button></div></form></div></details><button type="button" class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-danger/10 hover:text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2 size-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>Delete campaign</button><dialog aria-labelledby="id-7" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></footer></article></div></div></div><p role="status" class="sr-only"></p><p aria-hidden="true" data-page-toast="true" class="pointer-events-none fixed bottom-5 left-1/2 z-40 max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-xl bg-text-primary px-3.5 py-2.5 text-sm font-medium text-card shadow-lg">Invite link copied</p></div></div>"`;

exports[`golden C1: markup the campaigns and the pages every campaign, in the index: index 1`] = `"<div><div class="mx-auto w-full max-w-[70rem] px-4 pt-6 pb-8 md:px-8 md:pt-8 md:pb-10"><div class="@container/index flex min-w-0 flex-col gap-5"><header class="flex flex-wrap items-end justify-between gap-3"><div class="min-w-0"><h1 id="your-campaigns" tabindex="-1" class="text-2xl font-semibold tracking-tight outline-none">Your campaigns</h1><p class="mt-1 max-w-[46ch] text-text-secondary">Set up each campaign you run as Gamemaster, then share its invite link with your players.</p></div><div class="flex flex-wrap gap-2"><button type="button" class="inline-flex h-10 items-center gap-2 rounded-xl border border-border px-4 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary/5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>Connect Foundry</button><dialog aria-labelledby="id-1" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog><button type="button" class="inline-flex h-10 items-center gap-2 rounded-xl bg-primary px-4 text-sm font-medium text-on-primary transition-colors hover:bg-primary-hover"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>New campaign</button><dialog aria-labelledby="id-2" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></header><div class="grid min-w-0 gap-4 @min-[900px]/index:grid-cols-[340px_minmax(0,1fr)] @min-[900px]/index:items-start"><div class="-m-1 min-w-0 flex-col gap-2 p-1 @min-[900px]/index:sticky @min-[900px]/index:top-4 @min-[900px]/index:max-h-[calc(100dvh-2rem)] @min-[900px]/index:overflow-y-auto flex"><h2 id="campaigns-needs" class="mt-2 px-0.5 text-[11px] font-bold tracking-[0.06em] text-text-secondary uppercase">Needs you</h2><ul aria-labelledby="campaigns-needs" class="grid gap-2"><li><button type="button" data-campaign="toa" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">Tomb of Annihilation</span><span class="block truncate text-[13px] text-text-secondary">Chult · mists.forge-vtt.com</span></span><span><span data-state="refused" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-danger/45 text-danger"><span aria-hidden="true" class="size-2 rounded-full bg-danger"></span>Refused</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="inline-flex min-w-0 items-center gap-1.5 text-xs font-semibold text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-alert lucide-alert-circle size-4 shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>Foundry’s posts refused: wrong secret</span><span class="text-xs whitespace-nowrap text-text-secondary">Last heard <time datetime="2026-10-04T09:30:00.000Z">⟨time⟩</time></span></span></button></li><li><button type="button" data-campaign="salt" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">Ghosts of Saltmarsh</span><span class="block truncate text-[13px] text-text-secondary">mists.forge-vtt.com</span></span><span><span data-state="waiting" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full border-[1.5px] border-dashed border-text-secondary"></span>Waiting for Foundry</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="inline-flex min-w-0 items-center gap-1.5 text-xs font-semibold text-warning"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug size-4 shrink-0" aria-hidden="true"><path d="M12 22v-5"></path><path d="M15 8V2"></path><path d="M17 8a1 1 0 0 1 1 1v4a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1z"></path><path d="M9 8V2"></path></svg>Connect Foundry to start</span></span></button></li></ul><h2 id="campaigns-rest" class="mt-2 px-0.5 text-[11px] font-bold tracking-[0.06em] text-text-secondary uppercase">Campaigns</h2><ul aria-labelledby="campaigns-rest" class="grid gap-2"><li><button type="button" data-campaign="strahd" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">Curse of Strahd</span><span class="block truncate text-[13px] text-text-secondary">Barovia · mists.forge-vtt.com</span></span><span><span data-state="live" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full bg-primary motion-safe:animate-pulse"></span>Live</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="inline-flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1"><span aria-hidden="true" data-seats="true" class="inline-flex items-center"><span title="Alice as Thorin Oakenshield" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full bg-primary/15 text-[10px] font-bold text-primary-text ring-2 ring-card first:ml-0">A</span><span title="Bob as Vex" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full bg-primary/15 text-[10px] font-bold text-primary-text ring-2 ring-card first:ml-0">B</span><span title="Kasimir, not chosen yet" class="-ml-1.5 inline-grid size-6 shrink-0 place-items-center rounded-full border border-dashed border-text-secondary bg-page text-[10px] font-bold text-text-secondary ring-2 ring-card first:ml-0">?</span></span><span class="text-xs text-text-secondary">2 of 3 characters chosen</span></span></span></button></li><li><button type="button" data-campaign="lmop" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">Lost Mine of Phandelver</span><span class="block truncate text-[13px] text-text-secondary">mists.forge-vtt.com</span></span><span><span data-state="offline" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full bg-text-secondary"></span>Offline</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="text-xs text-text-secondary">No characters yet</span><span class="text-xs whitespace-nowrap text-text-secondary">Last heard <time datetime="2026-10-04T18:00:00.000Z">⟨time⟩</time></span></span></button></li><li><button type="button" data-campaign="wild" class="grid min-h-11 w-full grid-cols-[minmax(0,1fr)_auto] gap-x-2.5 gap-y-1 rounded-[14px] border bg-card p-3 text-left transition-colors border-border hover:border-primary/40"><span class="min-w-0"><span class="block truncate text-[15px] font-semibold">The Wild Beyond the Witchlight</span><span class="block truncate text-[13px] text-text-secondary">mists.forge-vtt.com</span></span><span><span data-state="offline" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-border"><span aria-hidden="true" class="size-2 rounded-full bg-text-secondary"></span>Offline</span></span><span class="col-span-full flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1.5"><span class="text-xs text-text-secondary">No characters yet</span></span></button></li></ul></div><div class="min-w-0 flex-col gap-4 hidden @min-[900px]/index:flex"><article aria-labelledby="campaign-toa" class="grid min-w-0 gap-5 rounded-2xl border border-border bg-card p-5 sm:p-6"><header class="flex min-w-0 flex-wrap items-start justify-between gap-3"><div class="min-w-0"><h2 id="campaign-toa" tabindex="-1" class="text-xl font-semibold tracking-tight break-words outline-none">Tomb of Annihilation</h2><p class="text-sm text-text-secondary wrap-anywhere">Chult · mists.forge-vtt.com</p></div><span class="inline-flex shrink-0 flex-col items-end gap-0.5"><span data-state="refused" class="inline-flex shrink-0 items-center gap-2 rounded-full border bg-card px-2.5 py-1 text-xs font-semibold whitespace-nowrap border-danger/45 text-danger"><span aria-hidden="true" class="size-2 rounded-full bg-danger"></span>Refused</span><span class="text-xs whitespace-nowrap text-text-secondary">Last heard <time datetime="2026-10-04T09:30:00.000Z">⟨time⟩</time></span></span></header><p data-refusal="wrongSecret" class="text-sm wrap-anywhere rounded-lg border border-danger/40 bg-danger/5 p-3">At <time datetime="2026-10-04T19:20:00.000Z">⟨time⟩</time>, Sending Stone refused Foundry’s post for this campaign: the secret it came with isn’t this campaign’s. Enter this campaign’s secret on its Connection tab in Sending Stone’s settings in Foundry, in the browser you run the game from, or set a new one with Change secret below and enter that.</p><div class="grid min-w-0 gap-5 @min-[900px]/index:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] @min-[900px]/index:items-start"><div class="grid min-w-0 gap-5"><section class="grid gap-2"><h3 class="text-sm font-medium">Characters</h3><p class="-mt-1 text-xs text-text-secondary">Open one to see its sheet and roll as it.</p><ul class="grid gap-1.5 text-sm"><li class="flex min-h-11 flex-wrap items-center justify-between gap-3 rounded-lg bg-page pr-1 pl-3 py-1"><a id="campaign-toa-sheet-azaka" aria-label="Open Azaka's sheet" class="truncate font-medium text-text-primary underline-offset-2 hover:text-primary hover:underline" href="/campaigns/toa/characters/azaka">Azaka</a><span class="flex min-w-0 items-center gap-1"><span class="text-xs wrap-anywhere font-semibold text-primary">Dev</span><button type="button" aria-label="Remove Dev as Azaka" title="Remove Dev as Azaka" class="inline-flex size-9 shrink-0 items-center justify-center rounded-lg text-text-secondary transition-colors hover:bg-danger/10 hover:text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-minus size-4" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="22" x2="16" y1="11" y2="11"></line></svg></button><dialog aria-labelledby="id-3" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></span></li></ul></section></div><div class="grid min-w-0 gap-5"><section class="grid gap-1.5"><h3 class="text-sm font-medium">Invite link</h3><span class="flex min-w-0 items-center gap-2 rounded-lg border border-border bg-page py-1 pr-1 pl-3"><code class="min-w-0 flex-1 font-mono text-xs text-text-primary truncate">https://stone.example/join/code-toa</code><button type="button" aria-label="Copy invite link" title="Copy" class="shrink-0 rounded-md text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary inline-flex min-h-9 items-center gap-1.5 px-2.5 text-xs font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy size-4" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>Copy</button></span><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm text-text-secondary">Share it with your players. They sign in and choose their character.</p><button type="button" class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw size-4" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>Reset link</button><dialog aria-labelledby="id-4" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-dices size-4 text-text-secondary" aria-hidden="true"><rect width="12" height="12" x="2" y="10" rx="2" ry="2"></rect><path d="m17.92 14 3.5-3.5a2.24 2.24 0 0 0 0-3l-5-4.92a2.24 2.24 0 0 0-3 0L10 6"></path><path d="M6 18h.01"></path><path d="M10 14h.01"></path><path d="M15 6h.01"></path><path d="M18 9h.01"></path></svg>Players' rolls</h3><p class="text-sm text-text-secondary">They stay here. To have them made in your game with the same dice, tick Players roll in the app on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right size-4 text-text-secondary" aria-hidden="true"><path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path></svg>Items and coins</h3><p class="text-sm text-text-secondary">Players can’t move items and coins from here. To let them, tick Players move items and coins on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cooking-pot size-4 text-text-secondary" aria-hidden="true"><path d="M2 12h20"></path><path d="M20 12v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8"></path><path d="m4 8 16-4"></path><path d="m8.86 6.78-.45-1.81a2 2 0 0 1 1.45-2.43l1.94-.48a2 2 0 0 1 2.43 1.46l.45 1.8"></path></svg>Cookbook dishes</h3><p class="text-sm text-text-secondary">Off. To take dishes, tick Dishes from the Magical Recipe Book on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars size-4 text-text-secondary" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg>Players' effects</h3><p class="text-sm text-text-secondary">Off. To let them, tick Allow Players to disable &amp; remove their own active effects on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><section class="grid gap-1"><h3 class="flex items-center gap-1.5 text-sm font-medium"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-paw-print size-4 text-text-secondary" aria-hidden="true"><circle cx="11" cy="4" r="2"></circle><circle cx="18" cy="8" r="2"></circle><circle cx="20" cy="16" r="2"></circle><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"></path></svg>Wild Shape</h3><p class="text-sm text-text-secondary">Off. To let them, tick Allow Players to use Wild Shape from the app on the campaign’s Player actions tab in Sending Stone’s settings in Foundry.</p></section><details class="min-w-0"><summary class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary -ml-2.5 cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-2 size-4" aria-hidden="true"><path d="M14 17H5"></path><path d="M19 7h-9"></path><circle cx="17" cy="17" r="3"></circle><circle cx="7" cy="7" r="3"></circle></svg>Foundry settings</summary><div class="mt-3 grid min-w-0 gap-4 text-sm"><p class="text-text-secondary">Foundry hasn't sent its settings yet. They arrive the next time your game connects.</p></div></details></div></div><footer class="flex flex-wrap items-start justify-between gap-3 border-t border-border pt-4"><details class="group min-w-0 flex-1"><summary class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-primary/10 hover:text-text-primary cursor-pointer"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-key-round size-4" aria-hidden="true"><path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle></svg>Change secret</summary><div class="mt-3 max-w-md"><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')" class="grid gap-1.5"><label for="id-5" class="text-sm font-medium">New secret</label><div class="flex gap-2"><input id="id-5" minlength="12" maxlength="200" autocomplete="off" autocapitalize="none" spellcheck="false" required="" class="h-10 min-w-0 flex-1 rounded-xl border border-border bg-page px-3 font-mono text-sm outline-none transition-colors focus:border-primary focus:ring-2 focus:ring-primary/25 aria-invalid:border-danger" name="secret"><button type="submit" class="inline-flex h-10 shrink-0 items-center gap-2 rounded-xl border border-border px-3.5 text-sm font-medium transition-colors hover:border-primary/50 hover:bg-primary/5 disabled:opacity-60">Save secret</button></div></form></div></details><button type="button" class="inline-flex min-h-10 items-center gap-1.5 rounded-lg px-2.5 text-sm font-medium text-text-secondary transition-colors hover:bg-danger/10 hover:text-danger"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2 size-4" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>Delete campaign</button><dialog aria-labelledby="id-6" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></footer></article></div></div></div><p role="status" class="sr-only"></p></div></div>"`;

