rd p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></div></div></div><dialog aria-labelledby="id-5" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl" data-floating-ui-inert=""></dialog><dialog aria-labelledby="id-6" class="m-0 ml-auto h-dvh max-h-none w-full max-w-md overflow-visible border-0 border-l border-border bg-card p-0 text-text-primary shadow-xl transition-transform duration-200 ease-out backdrop:bg-black/50 starting:open:translate-x-full motion-reduce:transition-none" data-floating-ui-inert=""></dialog></div><div class="pointer-events-none fixed inset-x-0 top-[max(0.5rem,env(safe-area-inset-top))] bottom-0 z-[100001] -mt-2 flex items-start justify-center overflow-y-auto pt-2 pr-[max(1rem,env(safe-area-inset-right))] pb-8 pl-[max(1rem,env(safe-area-inset-left))] [scrollbar-width:none]" data-floating-ui-inert=""><div role="log" aria-label="Roll results" class="flex w-full flex-col gap-2 sm:max-w-md"><div data-roll-toast="00000000-0000-4000-8000-000000000001" data-accent="primary" class="pointer-events-auto flex items-start gap-3 rounded-xl border border-l-4 bg-card bg-linear-to-r py-2.5 pl-3 text-text-primary shadow-2xl motion-safe:animate-toast-in motion-safe:transition-opacity motion-safe:duration-200 motion-safe:data-leaving:opacity-0 cursor-pointer pr-3 border-primary/30 border-l-primary from-primary/10 to-primary/10"><span class="flex size-12 shrink-0 items-center justify-center rounded-xl text-2xl font-bold tabular-nums bg-primary/10 text-primary">13</span><div class="min-w-0 flex-1"><p class="flex items-center gap-1.5"><span class="truncate text-base font-semibold">Strength saving throw</span></p><p class="text-sm text-text-secondary tabular-nums truncate">d20 6 +7</p><p class="text-sm line-clamp-2 text-text-secondary">Sending to your Gamemaster’s game…</p></div></div></div></div><dialog aria-labelledby="id-7" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl max-sm:w-full max-sm:max-w-none max-sm:rounded-none max-sm:border-x-0" data-floating-ui-inert=""></dialog><div id="id-2" data-floating-ui-portal=""><span data-type="inside" tabindex="0" data-floating-ui-focus-guard="" style="border: 0px; height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: fixed; white-space: nowrap; width: 1px; top: 0px; left: 0px;" role="button"></span><div style="position: absolute; left: 0px; top: 0px; transform: translate(0px, 0px);" aria-labelledby="id-8" class="z-[100002] flex w-72 max-w-[calc(100vw-1rem)] flex-col gap-3 overflow-y-auto overscroll-contain rounded-xl border border-border bg-card p-3 text-text-primary shadow-xl outline-none" tabindex="-1" data-floating-ui-focusable="" id="id-1" role="dialog"><p id="id-8" class="text-xs font-semibold text-text-secondary">Settings</p><div class="flex flex-col gap-1 border-t border-border pt-3"><label class="flex min-h-11 items-center gap-3 text-sm font-medium cursor-pointer"><input role="switch" aria-describedby="id-9" class="peer sr-only" type="checkbox" checked=""><span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-primary bg-primary"><span class="absolute top-0.5 size-4 rounded-full bg-card shadow-sm transition-[left] left-4.5"></span></span>Send to the table</label><p id="id-9" class="pl-12 text-xs text-text-secondary">Your rolls here are made in your Gamemaster’s game too, with the same dice.</p></div><div class="flex flex-col gap-1 ml-1 border-l border-border pl-4"><label class="flex min-h-11 items-center gap-3 text-sm font-medium cursor-pointer"><input role="switch" aria-describedby="id-10" class="peer sr-only" type="checkbox"><span aria-hidden="true" class="relative h-5 w-9 shrink-0 rounded-full transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-primary bg-border"><span class="absolute top-0.5 size-4 rounded-full bg-card shadow-sm transition-[left] left-0.5"></span></span>Damage on its own</label><p id="id-10" class="pl-12 text-xs text-text-secondary">Damage you roll goes to your Gamemaster’s game with no attack or saving throw made there, for your Gamemaster to apply.</p></div><div class="flex flex-col items-start gap-1.5 border-t border-border pt-3"><p aria-hidden="true" class="text-xs font-semibold text-text-secondary">Roll results</p><div role="radiogroup" aria-label="Roll results" aria-describedby="id-11" class="flex rounded-lg border border-border bg-card p-0.5"><button type="button" role="radio" aria-checked="true" class="flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold transition-colors bg-primary/10 text-primary-text"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-top size-4" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 9h18"></path></svg>Toasts</button><button type="button" role="radio" aria-checked="false" class="flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs font-semibold transition-colors text-text-secondary hover:bg-primary/5 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-bottom size-4" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M3 15h18"></path></svg>Banner</button></div><p id="id-11" class="text-xs text-text-secondary">Each roll pops up at the top of the screen for 4 seconds; one you need to act on stays until you do.</p></div><div class="flex flex-col items-start gap-1.5 border-t border-border pt-3"><p aria-hidden="true" class="text-xs font-semibold text-text-secondary">Theme</p><div role="radiogroup" aria-label="Theme" class="flex items-center rounded-lg border border-border p-0.5"><button type="button" role="radio" aria-checked="false" aria-label="Light" title="Light" class="rounded-md p-1.5 transition-colors text-text-secondary hover:bg-primary/10 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun size-3.5" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg></button><button type="button" role="radio" aria-checked="false" aria-label="Dark" title="Dark" class="rounded-md p-1.5 transition-colors text-text-secondary hover:bg-primary/10 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon size-3.5" aria-hidden="true"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path></svg></button><button type="button" role="radio" aria-checked="false" aria-label="System" title="System" class="rounded-md p-1.5 transition-colors text-text-secondary hover:bg-primary/10 hover:text-text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-monitor size-3.5" aria-hidden="true"><rect width="20" height="14" x="2" y="3" r