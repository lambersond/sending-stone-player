x flex-col gap-3"><h2 id="abilities-heading" class="text-xs font-semibold tracking-wider text-text-secondary uppercase">Abilities</h2><ul class="grid grid-cols-3 gap-2 @xl:grid-cols-6"><li class="flex flex-col overflow-hidden rounded-2xl border bg-card border-border"><button type="button" aria-label="Strength check, +4" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex flex-col items-center gap-1 px-2 pt-2.5 pb-2 transition-colors hover:bg-primary/5 focus-visible:bg-primary/5"><span class="text-xs font-semibold tracking-wider uppercase text-text-secondary">STR</span><span class="text-2xl leading-none font-bold tabular-nums">+4</span><span class="flex items-center gap-1"><span class="rounded-full border border-border px-2 text-xs tabular-nums">18</span></span></button><button type="button" aria-label="Strength saving throw, +7, proficient" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex items-center justify-center gap-1 border-t border-border py-1.5 text-xs transition-colors hover:bg-primary/5 focus-visible:bg-primary/5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check size-3.5 text-primary" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><span class="text-text-secondary">Save</span><span class="font-semibold tabular-nums">+7</span></button></li><li class="flex flex-col overflow-hidden rounded-2xl border bg-card border-border"><button type="button" aria-label="Dexterity check, +1" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex flex-col items-center gap-1 px-2 pt-2.5 pb-2 transition-colors hover:bg-primary/5 focus-visible:bg-primary/5"><span class="text-xs font-semibold tracking-wider uppercase text-text-secondary">DEX</span><span class="text-2xl leading-none font-bold tabular-nums">+1</span><span class="flex items-center gap-1"><span class="rounded-full border border-border px-2 text-xs tabular-nums">12</span></span></button><button type="button" aria-label="Dexterity saving throw, +1" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex items-center justify-center gap-1 border-t border-border py-1.5 text-xs transition-colors hover:bg-primary/5 focus-visible:bg-primary/5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield size-3.5 text-text-secondary" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg><span class="text-text-secondary">Save</span><span class="font-semibold tabular-nums">+1</span></button></li><li class="flex flex-col overflow-hidden rounded-2xl border bg-card border-border"><button type="button" aria-label="Constitution check, +3" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex flex-col items-center gap-1 px-2 pt-2.5 pb-2 transition-colors hover:bg-primary/5 focus-visible:bg-primary/5"><span class="text-xs font-semibold tracking-wider uppercase text-text-secondary">CON</span><span class="text-2xl leading-none font-bold tabular-nums">+3</span><span class="flex items-center gap-1"><span class="rounded-full border border-border px-2 text-xs tabular-nums">16</span></span></button><button type="button" aria-label="Constitution saving throw, +6, proficient" aria-haspopup="menu" class="touch-manipulation select-none [-webkit-touch-callout:none] flex i