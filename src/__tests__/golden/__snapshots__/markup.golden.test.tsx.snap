L11.75 3.75a6 6 0 118.49 8.49z"></path><path d="M16 8 2 22"></path><path d="M17.488 15H9"></path></svg><span class="sr-only @3xl:not-sr-only">Biography</span></button></div><div class="ml-auto flex shrink-0 items-center"><button type="button" title="Your rolls" class="relative rounded-lg p-2 text-text-secondary transition-colors @max-[366px]:p-1.5 hover:bg-primary/5 hover:text-text-primary aria-expanded:bg-primary/10 aria-expanded:text-primary" aria-expanded="false" aria-haspopup="dialog"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-ccw-clock lucide-history size-4" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M12 7v5l4 2"></path></svg><span class="sr-only">Your rolls</span></button><button type="button" aria-label="Settings" title="Settings" class="rounded-lg p-2 text-text-secondary transition-colors @max-[366px]:p-1.5 hover:bg-primary/5 hover:text-text-primary aria-expanded:bg-primary/10 aria-expanded:text-primary" aria-expanded="false" aria-haspopup="dialog"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings size-4" aria-hidden="true"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path><circle cx="12" cy="12" r="3"></circle></svg></button></div></div><div class="flex min-h-0 flex-1"><div class="@container relative min-h-0 min-w-0 flex-1 overflow-y-auto"><div id="sheet-panel" role="tabpanel" aria-labelledby="sheet-tab-character" tabindex="-1" class="outline-none"><div class="mx-auto flex w-full max-w-5xl flex-col gap-6 p-4 md:px-8 md:py-6"><header class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-4"><div class="flex items-center gap-4"><img alt="" class="size-16 shrink-0 overflow-hidden rounded-2xl border border-border bg-primary/10 object-cover object-top" src="https://my-game.forge-vtt.com/worlds/erebor/thorin.webp"><div class="min-w-0"><p class="font-semibold">Fighter 5 · Champion</p><p class="text-sm text-text-secondary">Dwarf · Soldier</p><div class="mt-1"><button type="button" aria-label="Not inspired. Gain Heroic Inspiration" title="Not inspired. Gain Heroic Inspiration" class="-mx-1.5 inline-flex items-center gap-1 rounded-lg px-1.5 py-0.5 text-xs font-semibold transition-colors hover:bg-primary/5 text-text-secondary">Not inspired</button><dialog aria-labelledby="id-1" class="overflow-visible border border-border bg-card p-0 text-text-primary shadow-xl backdrop:bg-black/50 m-auto w-[calc(100%-2rem)] max-w-lg rounded-2xl"></dialog></div></div></div><ul aria-label="Conditions" class="flex flex-wrap gap-1.5"><li><button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-border bg-page py-1 pr-2.5 pl-1 text-xs font-semibold transition-colors hover:border-primary hover:bg-primary/5"><img alt="" class="size-5 rounded-full bg-[#23232f] p-0.5" src="https://my-game.forge-vtt.com/systems/dnd5e/icons/svg/statuses/concentrating.svg">Concentrating<span class="font-normal text-text-secondary">Bless</span></button></li><li><button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-border bg-page py-1 pr-2.5 pl-1 text-xs font-semibold transition-colors hover:border-primary hover:bg-primary/5"><img alt="" class="size-5 rounded-full bg-[#23232f] p-0.5" src="https://my-game.forge-vtt.com/systems/dnd5e/icons/svg/statuses/exhaustion.svg">Exhaustion<span class="font-normal text-text-secondary">Level 2</span></button></li><li><button type="button" class="inline-flex items-center gap-1.5 rounded-full border border-border bg-page py-1 pr-2.5 pl-1 text-xs font-semibold transition-colors hover:border-primary hover:bg-primary/5"><img alt="" class="size-5 rounded-full bg-[#23232f] p-0.5" src="https://my-game.forge-vtt.com/systems/dnd5e/icons/svg/statuses/poisoned.svg">Poisoned</button></li></ul><dl class="grid grid-cols-2 gap-2 @lg:grid-cols-4 @5xl:grid-cols-8"><div class="@container flex min-w-0 flex-col gap-0.5 rounded-xl bg-page py-2 @lg:col-span-2"><dt class="truncate px-3 text-[11px] font-semibold tracking-wider text-text-secondary uppercase">Hit points</dt><dd class="flex-1 px-3 text-lg font-bold tabular-nums"><span class="flex h-full flex-col justify-between gap-1"><span class="flex flex-wrap items-baseline gap-x-1"><span>31</span><span class="font-normal text-text-secondary"> / 44</span></span><span aria-hidden="true" class="block h-1.5 w-full overflow-hidden rounded-full bg-border"><span class="block h-full rounded-full bg-primary" style="width: 70.45454545454545%;"></span></span></span></dd></div><div class="@container flex min-w-0 flex-col gap-0.5 rounded-xl bg-page py-2 @lg:col-span-2"><dt class="truncate px-3 text-[11px] font-semibold tracking-wider text-text-secondary uppercase">Hit dice</dt><dd class="flex-1 px-3 text-lg font-bold tabular-nums"><ul class="flex flex-wrap gap-x-4 gap-y-1.5"><li class="flex min-w-0 flex-[1_1_9rem] items-center gap-2"><svg viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true" class="shrink-0 size-5 text-primary @max-[150px]:hidden"><path fill="currentColor" d="m43.332 96.684c-4.3906-4.2461-9.7461-9.3594-17.293-16.504-8.9297-8.4531-23.906-22.734-24.699-23.547-0.37891-0.39062-0.66406-0.73437-0.62891-0.76562 0.17578-0.17578 20.082-5.8633 20.926-5.9805 0.75781-0.10547 1.5625 0.09375 3.6562 0.90625 2.5664 0.99609 16.805 6.8633 19.43 8.0078l2.2812 0.99609 0.039063 19.312c0.035156 18.098 0