exports[`fixtures ashenRootBane 1`] = `
"{
 "value": {
  "version": 1,
  "dish": {
   "id": "cmh2k8q0n0005ab12cd34ef56",
   "recipe": "Ashen Root Stew",
   "status": "bane",
   "outcome": "bane",
   "cookedOnDay": 4,
   "consumedOnDay": 4
  },
  "cook": {
   "name": "Thorin"
  },
  "message": "The ashen root is undercooked—fibrous, bitter, and chalky on the tongue. The broth is thin, acrid, and burns the back of the throat with raw blister garlic. A greasy film floats on the surface, and every bite reminds you of something that should’ve stayed buried.",
  "effect": {
   "name": "Ashen Root Stew (Bane)",
   "ingredients": [
    {
     "name": "Ashen Root",
     "text": "-1 to all ability checks and saving throws."
    }
   ],
   "duration": {
    "seconds": 86400
   },
   "stacks": false,
   "changes": [
    {
     "type": "rollBonus",
     "roll": "check",
     "value": -1
    },
    {
     "type": "rollBonus",
     "roll": "save",
     "value": -1
    }
   ]
  }
 }
}"
`;

exports[`fixtures ashenRootFailure 1`] = `
"{
 "value": {
  "version": 1,
  "dish": {
   "id": "cmh2k8q0n0008ab12cd34ef56",
   "recipe": "Ashen Root Stew",
   "status": "failure",
   "outcome": "standard",
   "cookedOnDay": 4,
   "consumedOnDay": 4
  },
  "cook": {
   "name": "Thorin"
  },
  "message": "The root has softened into tender chunks, releasing its mild bitterness into a rich, savory broth. The blister garlic has mellowed into a peppery heat that lingers pleasantly. It fills the belly with warmth and leaves a smoky aftertaste like a campfire in the distance.",
  "effect": null
 }
}"
`;

